<Project>
  <Import Project="build/ProjectDefaults.props" />
  <PropertyGroup>
    <!-- 自研库（libs/CodeWF.Avalonia、libs/CodeWF.Toolkit）以 git submodule 源引用，Vex 不消费其 NuGet 包；
         NuGet 发布只作为"库升级/打包/发布"检查点管道（scripts/prepare_local_libraries.ps1 等，供 Vox 与外部消费者）。
         指针策略为手动 bump：git -C libs/<库名> fetch && 检出目标 commit 后在 Vex 提交指针，库 main 故障不拖累 Vex 构建。 -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(CI)' != 'true'">$(MSBuildThisFileDirectory)..\..\temp_files\vex-build\</ArtifactsPath>
    <ArtifactsPath Condition="'$(CI)' == 'true'">$(MSBuildThisFileDirectory)artifacts\</ArtifactsPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
    <Version>2.1.1.0</Version>
    <!-- 本文件只保留应用本体一个 Version 节点（release.yml 的版本一致性校验按单节点读取）。
         迁入库（Markdown / Markdown.Lite / Markdown.Core / MindView）沿用 CodeWF.Avalonia
         的 12.1.6.x 版本线，在各库 csproj 内覆写 <Version>。 -->
    <Authors>Vex Contributors</Authors>
    <Company>CodeWF</Company>
    <Title>Vex - 维刻</Title>
    <Product>Vex</Product>
    <Description>极简之力，妙笔成章 | Markdown 编辑器</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dotnet9/Vex</RepositoryUrl>
    <PackageProjectUrl>https://vex.codewf.com/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- 库包元数据：包内 README 按各工程目录独立维护，图标共享仓库根资源。 -->
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 Vex(维刻) - CodeWF(码坊) https://codewf.com</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 参考 WalletWasabi：传递依赖漏洞全量审计（level=low 起报，只警告不阻断构建）。 -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)logo.png" Pack="true" PackagePath="" Link="logo.png" />
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Vex.Generators'">
    <!-- Banned API 门禁（参考 WalletWasabi）：命中 BannedSymbols.txt 即编译错误，写明替代方案。
         源生成器工程（Vex.Generators）排除：它自身依赖 Roslyn 包且退出了 CPM，注入会报 NU1015。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
