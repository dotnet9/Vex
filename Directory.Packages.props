<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <SemiAvaloniaVersion>12.1.0.1</SemiAvaloniaVersion>
    <UrsaAvaloniaVersion>2.2.0</UrsaAvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CodeWF.Avalonia.MindView" Version="12.2.30" />
    <PackageVersion Include="CodeWF.Toolkit.Core" Version="1.1.1" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <!-- DataGrid 由 Avalonia 单独发版，最新只到 12.1.2，不跟 $(AvaloniaVersion) 走。 -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Controls" Version="12.2.30" />
    <PackageVersion Include="CodeWF.Avalonia.DataGrid" Version="12.2.30" />
    <PackageVersion Include="CodeWF.Toolkit.EventBus" Version="1.1.1" />
    <PackageVersion Include="CodeWF.Avalonia.Markdown" Version="12.2.30" />
    <PackageVersion Include="CodeWF.Avalonia.Markdown.Lite" Version="12.2.30" />
    <PackageVersion Include="CodeWF.Toolkit.Files" Version="1.1.1" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="$(UrsaAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Lang" Version="12.2.30" />
    <PackageVersion Include="PdfPig" Version="0.1.9" />
    <PackageVersion Include="ReverseMarkdown" Version="6.3.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="14.7.1" />
    <PackageVersion Include="Semi.Avalonia" Version="$(SemiAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia.ColorPicker" Version="$(SemiAvaloniaVersion)" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="VC-LTL" Version="5.3.1" />
    <PackageVersion Include="YY-Thunks" Version="1.2.4-Beta.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.303" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
</Project>