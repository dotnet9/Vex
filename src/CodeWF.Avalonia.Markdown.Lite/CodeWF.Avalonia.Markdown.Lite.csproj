<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- 迁入库沿用 CodeWF.Avalonia 的 12.1.6.x 版本线，与 Vex 应用版本分开管理。 -->
    <Version>12.2.0.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFramework>net11.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Markdown 渲染基础包：基于 Avalonia 与 Markdig 的解析渲染引擎，只渲染常规元素（标题/段落/列表/引用/表格/链接/代码块单色/图片替代文本/公式原文），并内置 18 套排版主题。Markdown rendering engine with built-in typography themes, no heavy capability dependencies.</Description>
    <PackageTags>avalonia;markdown;viewer;codewf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeWF.Avalonia.Markdown" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeWF.Avalonia.Lang" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <None Remove="I18n\*.json" />
    <EmbeddedResource Include="I18n\*.json" />
  </ItemGroup>

</Project>
