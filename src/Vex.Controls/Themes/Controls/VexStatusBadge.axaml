<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vex="https://codewf.com">
    <Design.PreviewWith>
        <StackPanel Width="220" Spacing="8">
            <vex:VexStatusBadge Label="Words" Value="128" />
            <vex:VexStatusBadge Label="Encoding" Value="UTF-8" />
            <vex:VexStatusBadge Label="State" Value="Modified" IsAccent="True" />
        </StackPanel>
    </Design.PreviewWith>

    <!-- 尺寸对齐 Vex 原型 .badge：字号 11.5、内边距 1 8、圆角 6 -->
    <ControlTheme x:Key="{x:Type vex:VexStatusBadge}" TargetType="vex:VexStatusBadge">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="8 1" />
        <Setter Property="Background" Value="{DynamicResource VexStatusBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VexStatusBadgeBorderBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type vex:VexStatusBadge}">
                <Border
                    Name="RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{DynamicResource VexStatusBadgeLabelBrush}"
                            Text="{TemplateBinding Label}" />
                        <TextBlock
                            Name="ValueText"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource VexStatusBadgeValueBrush}"
                            MaxWidth="96"
                            Text="{TemplateBinding Value}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- 强调变体：值与描边使用主题色（未保存状态等） -->
        <Style Selector="^[IsAccent=True] /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="^[IsAccent=True] /template/ TextBlock#ValueText">
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
