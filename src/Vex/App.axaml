<prism:PrismApplication
    x:Class="Vex.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:codewf="https://codewf.com"
    xmlns:markdownThemes="https://codewf.com"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:semiCp="using:Semi.Avalonia.ColorPicker">
    <prism:PrismApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Styles/StudioPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC</FontFamily>
            <FontFamily x:Key="ControlContentThemeFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <!-- 由弹出窗口按屏幕工作区限制高度，避免主题默认的 400 像素截断正常菜单。 -->
            <x:Double x:Key="MenuFlyoutMaxHeight">Infinity</x:Double>
            <!-- AvaloniaEdit 的 Simple 主题要求宿主提供这几个字体令牌（Fluent 主题过去自带） -->
            <FontFamily x:Key="FontFamilyNormal">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC</FontFamily>
            <x:Double x:Key="FontSizeNormal">14</x:Double>
            <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
        </ResourceDictionary>
    </prism:PrismApplication.Resources>

    <prism:PrismApplication.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <semiCp:ColorPickerSemiTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <codewf:ACSemiTheme />
        <!-- 库故意不进默认主题的两组宿主级观感：常驻滚动条轨道与提示浮层折行。 -->
        <StyleInclude Source="avares://CodeWF.Avalonia.Controls/Themes/Styles/Chrome.axaml" />
        <codewf:DataGridSemiTheme />
        <codewf:StudioTheme />
        <codewf:MindViewThemes />
        <!-- 完整包样式入口（CodeWF.Avalonia.Markdown.Themes）：在 Lite.Themes 的控件模板与 27 套排版主题之上
             叠加图片能力控件与编辑器控件外观。 -->
        <markdownThemes:MarkdownFullThemes TypographyTheme="Simple" />
        <codewf:VexControlsTheme />
        <StyleInclude Source="avares://Vex/Modules/Shell/Views/WorkbenchStyles.axaml" />
        <StyleInclude Source="avares://Vex/Modules/Workspace/Views/MarkdownDocumentStyles.axaml" />
        <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC" /></Style>
    </prism:PrismApplication.Styles>
</prism:PrismApplication>
