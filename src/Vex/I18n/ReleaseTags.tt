<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Memory" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.Json" #>
<#@ output extension=".cs" #>
// <auto-generated> Generated from I18n/zh-CN.json. </auto-generated>
#nullable enable
using System;
using System.Collections.Generic;

namespace Vex;

/// <summary>《更新日志》正文标签词的识别表：词形与界面文案都是 I18n 资源键，这里不出现任何语言的字面量。
/// 一组键 = UpdateTagSource 前缀加后缀（正文方括号里的词形）与 UpdateTag 前缀加同一后缀（胶囊显示的文案）。</summary>
public static class VexReleaseTag
{
    /// <summary>正文标签词不在词表里（自定义发布说明）时返回 null，该行按无标签条目渲染。</summary>
    /// <param name="resolve">资源键 → 当前界面语言的文案；词形比较用它现取，切语言不必重新生成。</param>
    public static string? KeyOf(string source, Func<string, string> resolve)
    {
        foreach (var pair in Pairs)
        {
            if (string.Equals(resolve(pair.SourceKey), source, StringComparison.Ordinal)) return pair.LabelKey;
        }

        return null;
    }

    private static readonly IReadOnlyList<(string SourceKey, string LabelKey)> Pairs =
    [
<#
    foreach (var suffix in ReadTagSuffixes())
    {
#>
        (VexL.UpdateTagSource<#= suffix #>, VexL.UpdateTag<#= suffix #>),
<#
    }
#>
    ];
}

<#+
/* 与 scripts/sync_native_locales.cjs 的 ReleaseTags 段逐字同式：只看 zh-CN 的键名，
   加一类标签只改四份 JSON（一对键），两边生成器跟着多一行。
   UpdateTagSource* 是《更新日志》正文里的词形，四份 JSON 取同一个值——文档是中文写的，不随界面语言变。 */
private IEnumerable<string> ReadTagSuffixes()
{
    string zhCnPath = Path.Combine(Path.GetDirectoryName(Host.TemplateFile), "zh-CN.json");
    using JsonDocument doc = JsonDocument.Parse(File.ReadAllText(zhCnPath));
    foreach (var property in doc.RootElement.GetProperty("Vex").GetProperty("VexL").EnumerateObject())
    {
        var match = System.Text.RegularExpressions.Regex.Match(property.Name, "^UpdateTag(?!Source)([A-Z]\\w*)$");
        if (match.Success && property.Value.ValueKind == JsonValueKind.String)
        {
            yield return match.Groups[1].Value;
        }
    }
}
#>
