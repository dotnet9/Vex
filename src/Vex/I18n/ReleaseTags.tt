<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Memory" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.Json" #>
<#@ output extension=".cs" #>
// <auto-generated> Generated from I18n/zh-CN.json. </auto-generated>
using System.Collections.Generic;

namespace Vex;

/// <summary>《更新日志》正文里的标签词到界面资源键的对照表，由 zh-CN 的 UpdateTag* 文案生成。</summary>
public static class VexReleaseTag
{
    /// <summary>正文标签词不在表里（自定义发布说明）时返回 null，该行按无标签条目渲染。</summary>
    public static string? KeyOf(string source) => Sources.TryGetValue(source, out var key) ? key : null;

    private static readonly IReadOnlyDictionary<string, string> Sources = new Dictionary<string, string>
    {
<#
    foreach (var tag in ReadUpdateTags())
    {
#>
        ["<#= tag.Value #>"] = VexL.<#= tag.Key #>,
<#
    }
#>
    };
}

<#+
/* 与 scripts/sync_native_locales.cjs 的 ReleaseTags 段逐字同式：日志正文是中文写的，
   所以格式令牌直接取 zh-CN 的 UpdateTag* 文案；加一类标签只改四份 JSON，两边生成器跟着多一行。 */
private IEnumerable<KeyValuePair<string, string>> ReadUpdateTags()
{
    string zhCnPath = Path.Combine(Path.GetDirectoryName(Host.TemplateFile), "zh-CN.json");
    using JsonDocument doc = JsonDocument.Parse(File.ReadAllText(zhCnPath));
    foreach (var property in doc.RootElement.GetProperty("Vex").GetProperty("VexL").EnumerateObject())
    {
        if (property.Value.ValueKind == JsonValueKind.String && System.Text.RegularExpressions.Regex.IsMatch(property.Name, "^UpdateTag[A-Z]"))
        {
            yield return new KeyValuePair<string, string>(property.Name, property.Value.GetString());
        }
    }
}
#>
