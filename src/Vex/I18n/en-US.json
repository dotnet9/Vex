      "GuideIntroTitle": "Welcome to Vex",
      "GuideIntroDescription": "This guide quickly walks through the title-bar menus, document list, editor, preview, and status bar. Menu steps open the related menu so the entry point is clear.",
      "GuideFileMenuTitle": "File Menu",
      "GuideFileMenuDescription": "The File menu handles new, open, save, export, print, and close actions. It is the main entry point for daily writing.",
      "GuideFileOpenTitle": "Open Documents",
      "GuideFileOpenDescription": "Open File and Open Folder load a single Markdown document or a document set. Quick Open returns to the loaded file list first.",
      "GuideFileExportTitle": "Save and Export",
      "GuideFileExportDescription": "After saving the current document, use Export to generate HTML, PNG, and PDF. Word export will be added when that workflow is mature.",
      "GuideParagraphMenuTitle": "Paragraph Structure",
      "GuideParagraphMenuDescription": "The Paragraph menu inserts headings, tables, code blocks, quotes, lists, and dividers for structured writing.",
      "GuideFormatMenuTitle": "Text Formatting",
      "GuideFormatMenuDescription": "The Format menu applies bold, italic, inline code, links, images, and Markdown cleanup.",
      "GuideViewMenuTitle": "View Layout",
      "GuideViewMenuDescription": "The View menu switches the sidebar, outline, document list, source mode, line numbers, status bar, and zoom.",
      "GuideViewOutlineMenuTitle": "Outline Entry",
      "GuideViewOutlineMenuDescription": "Clicking Outline expands the left sidebar and switches to the Outline tab. The next step shows the switched outline area.",
      "GuideThemeMenuTitle": "Theme and Typography",
      "GuideThemeMenuDescription": "The Theme menu contains UI themes, Markdown typography themes, and compact layout for different writing environments.",
      "GuideSidebarFilesTitle": "Document List",
      "GuideSidebarFilesDescription": "The left document list shows the current file or Markdown/txt files in the opened folder, making it easy to switch documents.",
      "GuideSidebarOutlineTitle": "Outline Navigation",
      "GuideSidebarOutlineDescription": "The Outline tab generates navigation items from Markdown headings. Click a heading to jump to its location; empty documents show an empty state.",
      "GuideEditorTitle": "Editor",
      "GuideEditorDescription": "The center area is the Markdown source editor with common shortcuts, context menu, find/replace, syntax highlighting, and line numbers.",
      "GuidePreviewTitle": "Live Preview",
      "GuidePreviewDescription": "The right preview updates as you edit and renders with the selected Markdown typography theme.",
      "GuideStatusBarTitle": "Status Bar",
      "GuideStatusBarDescription": "The bottom status bar shows save state, encoding, zoom, cursor position, word count, and character count. Lightweight feedback appears on the left.",
      "GuideHelpMenuTitle": "Open the Guide Again",
      "GuideHelpMenuDescription": "Use the Help menu to open this guide again, or to view Changelog, Acknowledgements, and About windows.",
      "GuideFinishTitle": "Start Writing",
      "GuideFinishDescription": "You can start writing directly in the editor. Common entries are in the title-bar menus, while files and outline stay on the left.",
