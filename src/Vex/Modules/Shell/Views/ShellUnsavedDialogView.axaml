<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellUnsavedDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellUnsavedDialogViewModel">
    <!-- 严格按系统保存框参考图：标题「保存」、两行内容「是否保存更改？/如果不保存，您的更改将会丢失。」、
         三按钮「保存(主)+丢弃 靠左、取消靠右」。退出流与切换流文案唯一差异是丢弃按钮（丢弃 / 放弃更改），
         由代码后置按 Flow 切换两组按钮的可见性。尺寸全部取原型实测值：480 宽卡片、外衬 24/22、
         标题→正文 10、正文→按钮 20、按钮 12px 字号胶囊（左右 16、上下 5 内衬）；两流字号/圆角/按钮高度差异由 ApplyFlow 切换。 -->
    <Border x:Name="DialogCard" Classes="dialog-card" Width="480" MaxWidth="560" Padding="24,22">
        <StackPanel Spacing="0">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                LineHeight="25.6"
                FontWeight="SemiBold"
                Text="{i18n:I18n {x:Static l:VexL.Save}}" />
            <StackPanel x:Name="BodyPanel" Margin="0,10,0,6" Spacing="0">
                <TextBlock
                    x:Name="HintLine1"
                    FontSize="13"
                    LineHeight="23.4"
                    Classes="muted"
                    TextWrapping="Wrap"
                    Text="{i18n:I18n Vex.VexL.DialogExitHint}" />
                <TextBlock
                    x:Name="HintLine2"
                    FontSize="13"
                    LineHeight="23.4"
                    Classes="muted"
                    TextWrapping="Wrap"
                    Text="{i18n:I18n Vex.VexL.DialogLoseChangesHint}" />
            </StackPanel>
            <Grid x:Name="ActionsGrid" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel x:Name="ExitActions" Orientation="Horizontal" Spacing="8">
                    <Button
                        Classes="primary"
                        Click="OnSaveClicked"
                        Content="{i18n:I18n Vex.VexL.DialogSaveAndExit}"
                        FontSize="12"
                        Height="36"
                        Padding="16,5"
                        CornerRadius="18" />
                    <Button
                        Classes="dialog-secondary"
                        Click="OnDiscardClicked"
                        Content="{i18n:I18n Vex.VexL.DialogDiscardAndExit}"
                        FontSize="12"
                        Height="36"
                        Padding="16,5"
                        CornerRadius="18"
                        BorderThickness="1" />
                </StackPanel>
                <StackPanel x:Name="SwitchActions" IsVisible="False" Orientation="Horizontal" Spacing="8">
                    <Button
                        Classes="primary"
                        Click="OnSaveClicked"
                        Content="{i18n:I18n Vex.VexL.DialogSaveAndSwitch}"
                        FontSize="12"
                        Height="32"
                        Padding="16,5"
                        CornerRadius="16" />
                    <Button
                        Classes="dialog-secondary"
                        Click="OnDiscardClicked"
                        Content="{i18n:I18n Vex.VexL.DialogDiscardAndSwitch}"
                        FontSize="12"
                        Height="32"
                        Padding="16,5"
                        CornerRadius="16"
                        BorderThickness="1" />
                </StackPanel>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Classes="dialog-secondary"
                    Click="OnCancelClicked"
                    Content="{i18n:I18n Vex.VexL.DialogContinueEditing}"
                    FontSize="12"
                    Height="36"
                    Padding="16,5"
                    CornerRadius="18"
                    BorderThickness="1" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
