<u:UrsaWindow
    x:Class="Vex.Modules.Shell.Views.McpAuditWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mcp="using:Vex.Modules.Mcp.Models"
    xmlns:u="https://irihi.tech/ursa"
    Title="MCP Audit"
    Width="720"
    Height="520"
    MinWidth="560"
    MinHeight="420"
    Icon="/Assets/logo.ico"
    WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource VexPanelBackgroundBrush}" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Button
                x:Name="RefreshButton"
                Grid.Row="0"
                Click="Refresh_OnClick"
                HorizontalAlignment="Right"
                MinWidth="86" />
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="EmptyTextBlock"
                        Classes="muted"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="RecordsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mcp:McpOperationRecord">
                                <Border
                                    Margin="0,2"
                                    Padding="10,6"
                                    Background="{DynamicResource VexStatusBadgeBackgroundBrush}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Classes="muted"
                                                FontSize="11"
                                                Text="{Binding Timestamp}" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding ToolName}" />
                                            <TextBlock
                                                Classes="muted"
                                                FontSize="12"
                                                Text="{Binding OperationType}" />
                                            <TextBlock
                                                IsVisible="{Binding Succeeded}"
                                                Foreground="{DynamicResource VexSuccessBrush}"
                                                Text="✓" />
                                            <TextBlock
                                                Foreground="{DynamicResource VexDangerBrush}"
                                                IsVisible="{Binding !Succeeded}"
                                                Text="✗" />
                                        </StackPanel>
                                        <TextBlock
                                            Classes="muted"
                                            FontSize="11"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource VexDangerBrush}"
                                            IsVisible="{Binding HasError}"
                                            Text="{Binding Error}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</u:UrsaWindow>
