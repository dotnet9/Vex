<UserControl x:Class="Vex.Modules.Shell.Views.ShellWorkspaceView" x:Name="WorkspaceRoot"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:codewf="https://codewf.com"
    xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
    xmlns:views="using:Vex.Modules.Shell.Views" xmlns:shell="using:Vex.Modules.Shell.Views"
    xmlns:workspace="using:Vex.Modules.Workspace.Views" xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:MainWindowViewModel">
    <Grid ColumnDefinitions="Auto,*">
        <!-- 原型 professional.css 的叶纹覆盖左柱和文件列表，贴工作区底部。 -->
        <Image x:Name="SageLeafDecoration" Source="avares://Vex/Assets/sage-leaf.png"
            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Width="230" Height="300" Stretch="Uniform" Opacity="0.25" ZIndex="1"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            IsHitTestVisible="False" IsVisible="False" />
        <shell:ShellNavigationRailView x:Name="Navigation" x:FieldModifier="public" />
        <Grid Grid.Column="1" x:Name="WorkspaceColumns" Margin="{Binding Workbench.WorkspaceContentMargin}">
            <Grid.ColumnDefinitions>
                <!-- 列宽是侧栏尺寸的唯一来源，拖动结果直接通过双向绑定进入布局状态。 -->
                <ColumnDefinition Width="{Binding Layout.SidebarColumnWidth, Mode=TwoWay}"
                    MinWidth="{Binding Layout.MinimumVisibleSidebarWidth}"
                    MaxWidth="{Binding Layout.MaximumVisibleSidebarWidth}" />
                <ColumnDefinition Width="{Binding Layout.SidebarSplitterWidth}" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="{Binding Layout.OutlineSplitterWidth}" />
                <ColumnDefinition Width="{Binding Layout.OutlineColumnWidth, Mode=TwoWay}"
                    MinWidth="{Binding Layout.MinimumOutlineWidth}" MaxWidth="{Binding Layout.MaximumOutlineWidth}" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="SidebarGuideTarget"
                Grid.Column="0"
                ClipToBounds="True"
                IsHitTestVisible="{Binding Layout.ShowSidebar}">
                <Border Classes="workspace-block sidebar-edge">
                    <views:ShellFilesView />
                </Border>
            </Border>
            <!-- 1px 缝即把手本体，负外边距把命中扩到 11px；看得见的那根线由 .sidebar-edge 画在侧栏外缘。 -->
            <GridSplitter
                x:Name="SidebarSplitter"
                Grid.Column="1"
                Classes="workspace-gap gap-horizontal"
                ZIndex="9"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding Layout.ShowSidebar}"
                ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
            <Grid x:Name="DocumentColumn" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
                <StackPanel x:Name="FloatingViewShelf" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,4" IsVisible="False"/>
                <!-- 原型 .workspace-main 的首个子级就是 .find-strip（workspace-chrome.css:499），
                条在页签行之上、与正文列同宽、无边距无圆角，收起时高度归 0。 -->
                <shell:ShellFindBarView Grid.Row="1" DataContext="{Binding FindBar}" />
                <!-- 原型 .workspace-tabrow 在 content-area 内部（与正文列同宽）：左柱/侧栏顶到标题栏下边框，
                页签行只横跨正文列。36px、铬面底、发丝底边；演示模式整行隐藏。 -->
                <Border x:Name="WorkspaceTabRow" Grid.Row="2" Height="36" Padding="8,0"
                    Background="{DynamicResource VexChromeBrush}" BorderBrush="{DynamicResource VexHairlineBrush}"
                    BorderThickness="0,0,0,1" IsVisible="{Binding !Workbench.IsPresenting}">
                    <!-- 第 1 列是排版入口的落点：原型 workspace.js:185 在单阅读视图时把同一个节点
                    insertBefore(readingTypeButton, layoutButton) 迁进标签行，其余布局它留在阅读窗格标题行里，
                    所以这里只留列位，节点的归属由 WorkspaceViewController.Arrange 迁移。 -->
                    <Grid x:Name="TabRowGrid" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                            <ToggleButton x:Name="SourceSegment" Classes="tab-item" Command="{Binding Workbench.ShowSourceView}"
                                IsChecked="{Binding Workbench.IsSourceSegmentActive, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="stroke-ico" Data="{StaticResource WBEditIcon}" />
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.WBEdit}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ReadSegment" Classes="tab-item" Command="{Binding Workbench.ShowRead}"
                                IsChecked="{Binding Workbench.IsReadSegmentActive, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="stroke-ico" Data="{StaticResource WBReadIcon}" />
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.StatusViewRead}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="MapSegment" Classes="tab-item" Command="{Binding Workbench.ShowMindMap}"
                                IsChecked="{Binding Workbench.IsMapSegmentActive, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="stroke-ico" Data="{StaticResource WBMapIcon}" />
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.StatusViewMap}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <!-- 原型 .workspace-viewswitch-more：点开的是布局预设画廊（缩略图卡片网格），选中即收；
                        Workbench.ToggleLayouts 驱动既有的 LayoutGallery，aria-pressed 的展开态用 .on 类还原。
                        文案按 workspace.js:199 走「三段直选＝更多，组合布局＝预设名」，即 MoreSegmentLabel；
                        4px 左距 = 标签行 gap 2 + workspace-chrome.css:532 的 margin-left:2。 -->
                        <Button x:Name="EditorModeButton" Classes="editor-mode" Classes.on="{Binding Workbench.ShowLayouts}" Grid.Column="2"
                            Command="{Binding Workbench.ToggleLayouts}" Margin="4,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Workbench.MoreSegmentLabel}" VerticalAlignment="Center" />
                                <Path Classes="expand-chevron" Data="M6 9L12 15L18 9" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <!-- 原型 .workspace-layout-menu 是 .workspace-tabrow 的绝对子级（workspace-chrome.css:535）：
                top:calc(100% + 6px) 即页签行下方 6px、right:8 贴正文列右缘；画廊不滚动（同文件 153 overflow:visible），
                行高 36 + 6 = 42 的顶距把浮层钉在行下。 -->
                <Canvas Grid.Row="2" Grid.RowSpan="2" ZIndex="40" IsVisible="{Binding Workbench.ShowLayouts}">
                    <shell:WorkspaceLayoutGallery x:Name="LayoutGallery" Canvas.Right="8" Canvas.Top="42" />
                </Canvas>
                <Panel Grid.Row="3">
                    <!-- 原型：钉住的格式条只占源码列顶部，阅读/导图窗格从工作区顶端起排，
                    所以 42px 让位只加在编辑/即时视图上，而不是整个 ViewSurface。
                    网格列/行与分栏把手由 WorkspaceViewController 按块状布局重建，这里只声明窗格本身。 -->
                    <Grid x:Name="ViewSurface">
                        <workspace:MarkdownEditorView x:Name="EditorGuideTarget" IsVisible="{Binding #WorkspaceRoot.((vm:MainWindowViewModel)DataContext).Workbench.IsSourceVisible}" />
                        <workspace:MarkdownPreviewView x:Name="PreviewGuideTarget" IsReadingMode="{Binding #WorkspaceRoot.((vm:MainWindowViewModel)DataContext).Workbench.IsReading}" IsVisible="{Binding #WorkspaceRoot.((vm:MainWindowViewModel)DataContext).Workbench.IsPreviewVisible}" />
                        <workspace:MarkdownInstantView x:Name="InstantGuideTarget" IsVisible="{Binding Workbench.IsInstantEditing}" />
                        <workspace:MarkdownMindMapHost x:Name="MindMapGuideTarget" IsVisible="{Binding Workbench.IsMapVisible}" />
                    </Grid>
                    <!-- 对应原型 #edit-options：它是编辑块的第一个子级（钉住=占位行，取消钉住=悬浮于正文顶端），
                    由 WorkspaceViewController 在构造时移入块内，才能随圆角一起裁切；这里只是声明宿主。 -->
                    <shell:ShellEditorOptionsView x:Name="EditorOptions" />
                </Panel>
            </Grid>
            <GridSplitter x:Name="OutlineSplitter" Grid.Column="3" Classes="workspace-gap gap-horizontal" ZIndex="9" HorizontalAlignment="Stretch"
                IsVisible="{Binding Layout.ShowOutlineSidebar}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
            <!-- 与左侧文件栏同构：列宽是唯一尺寸来源，收起时由 ClipToBounds 裁切内容，才能滑出而不是整块消失。
            标题和搜索行由 ShellOutlineView 自己维护。 -->
            <Border x:Name="OutlineGuideTarget" Grid.Column="4" Classes="workspace-block structure-edge" IsHitTestVisible="{Binding Layout.ShowOutlineSidebar}"
                ClipToBounds="True">
                <shell:ShellOutlineView/>
            </Border>
        </Grid>
        <!-- 文档工具悬浮在右下角，不占用正文布局行。 -->
        <shell:ShellDocumentToolsView x:Name="DocumentTools" Grid.ColumnSpan="2" ZIndex="34"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,12,8" />
    </Grid>
</UserControl>
