<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellFilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:models="using:Vex.Core.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellFilesViewModel"
    prism:ViewModelLocator.AutoWireViewModel="True"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarFiles}"
    regions:RegionTab.IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6">

    <UserControl.DataTemplates>
        <TreeDataTemplate DataType="models:DocumentFileNode" ItemsSource="{Binding Children}">
            <!-- 文件树使用原型的单行布局，摘要放入提示，避免文件夹空摘要撑高行。 -->
            <Border Classes="file-card" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    ToolTip.Tip="{Binding Preview}" ToolTip.IsEnabled="{Binding IsDocument}">
                <Grid>
                    <Border Classes="file-bar" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}" HorizontalAlignment="Left" />
                    <Grid Height="30" Margin="10 0" ColumnDefinitions="15,*,Auto" ColumnSpacing="7">
                        <Path Classes="stroke-ico tree-ico" VerticalAlignment="Center" IsVisible="{Binding IsFolder}"
                              Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        <Path Classes="stroke-ico tree-ico" VerticalAlignment="Center" IsVisible="{Binding IsDocument}"
                              Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6" />
                        <TextBlock Grid.Column="1" MinHeight="16" Classes="file-heading" IsVisible="{Binding IsFolder}"
                                   VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" MinHeight="16" Classes="file-title" IsVisible="{Binding IsDocument}"
                                   VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                    </Grid>
                </Grid>
            </Border>
        </TreeDataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles><Style Selector="Path.tree-ico"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="StrokeThickness" Value="1.5"/></Style></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 文件页直接展示当前目录，打开目录入口使用图标避免重复标题占据空间。 -->
        <Grid Grid.Row="1" Margin="14,4,10,0" ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
            <Path Classes="stroke-ico" Width="14" Height="14" StrokeThickness="1.5" VerticalAlignment="Center" Data="M22 19H2V5H9L12 8H22Z"/>
            <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" FontSize="12" Foreground="{DynamicResource VexMutedBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Classes="wb-quiet" Command="{Binding OpenFolderAsync}" Width="28" Height="28" MinHeight="0" Padding="6"
                    ToolTip.Tip="{i18n:I18n {x:Static l:VexL.OpenFolder}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OpenFolder}}">
                <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconFolderOpen}" />
            </Button>
        </Grid>
        <TextBox
            Grid.Row="0"
            Margin="14 8 14 8"
            MinHeight="30"
            FontSize="11.5"
            Foreground="{DynamicResource VexValueBrush}"
            PlaceholderForeground="{DynamicResource VexMutedBrush}"
            BorderBrush="{DynamicResource VexPanelBorderBrush}"
            PlaceholderText="{i18n:I18n {x:Static l:VexL.SidebarFilesFilterPlaceholder}}"
            Text="{Binding FilterText, Mode=TwoWay}"
            TextWrapping="NoWrap" />
        <TreeView
            Grid.Row="2"
            Classes="side-tree"
            IsVisible="{Binding HasDocumentFiles}"
            ItemsSource="{Binding FilteredDocumentFileNodes}"
            PointerPressed="SelectItemOnPointerPressed"
            SelectedItem="{Binding SelectedDocumentFileNode, Mode=TwoWay}">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                        Command="{Binding OpenSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Rename}}"
                        Command="{Binding RenameSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}"
                        Command="{Binding OpenSelectedFileLocation}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Delete}}"
                        Command="{Binding DeleteSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <Border
            Grid.Row="2"
            IsVisible="{Binding IsDocumentFilesEmpty}"
            Padding="18"
            VerticalAlignment="Top">
            <TextBlock
                Classes="muted"
                FontSize="11.5"
                Text="{i18n:I18n {x:Static l:VexL.EmptyNoFiles}}"
                TextAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
