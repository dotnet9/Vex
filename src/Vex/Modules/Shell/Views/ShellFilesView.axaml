<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellFilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:models="using:Vex.Core.Models"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers"
    xmlns:converters="using:Vex.Modules.Shell.Views"
    xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellFilesViewModel"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarFiles}"
    regions:RegionTab.IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6">

    <UserControl.Resources>
        <converters:FileIconConverter x:Key="FileIconConverter" />
        <!-- 五键排序：互斥单选，勾选态由代码后置随 SortKey 刷新。 -->
        <Flyout x:Key="SortFlyout" Placement="TopEdgeAlignedLeft">
            <MenuFlyout>
                <MenuItem Tag="group" Command="{Binding SetSortKey}" CommandParameter="group"
                                     Header="{i18n:I18n {x:Static l:VexL.SortByFolderGroup}}"/>
                <MenuItem Tag="natural-desc" Command="{Binding SetSortKey}" CommandParameter="natural-desc"
                                     Header="{i18n:I18n {x:Static l:VexL.SortNaturalDescending}}"/>
                <MenuItem Tag="name-asc" Command="{Binding SetSortKey}" CommandParameter="name-asc"
                                     Header="{i18n:I18n {x:Static l:VexL.SortNameAscending}}"/>
                <MenuItem Tag="modified" Command="{Binding SetSortKey}" CommandParameter="modified"
                                     Header="{i18n:I18n {x:Static l:VexL.SortModifiedAscending}}"/>
                <MenuItem Tag="created" Command="{Binding SetSortKey}" CommandParameter="created"
                                     Header="{i18n:I18n {x:Static l:VexL.SortCreatedAscending}}"/>
            </MenuFlyout>
        </Flyout>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <TreeDataTemplate DataType="models:DocumentFileNode" ItemsSource="{Binding Children}">
            <!-- 文件树使用原型的单行布局，摘要放入提示，避免文件夹空摘要撑高行。 -->
            <Border Classes="file-card" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    DoubleTapped="OnFileRowDoubleTapped"
                    Classes.folder="{Binding IsFolder}"
                    helpers:ToolTipHelper.Text="{Binding PreviewDisplay}" ToolTip.IsEnabled="{Binding IsDocument}">
                <Grid Classes="file-row" ColumnDefinitions="12,*,Auto" ColumnSpacing="6">
                    <Panel Width="12" Height="12" VerticalAlignment="Center">
                        <Image x:Name="FileTypeIcon" Classes="tree-ico" Width="12" Height="12" Stretch="Uniform"
                               IsVisible="{Binding #FileTypeIcon.Source, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource FileIconConverter}">
                                    <Binding Path="Name" />
                                    <Binding Path="IsFolder" />
                                    <Binding Path="IsExpanded" />
                                    <Binding Path="$parent[UserControl].ActualThemeVariant" />
                                    <Binding Path="$parent[TreeViewItem].Level" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Panel IsVisible="{Binding #FileTypeIcon.Source, Converter={x:Static avaloniaConverters:ObjectConverters.IsNull}}">
                            <Path Classes="tree-ico" IsVisible="{Binding IsFolder}"
                                  Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                            <Path Classes="tree-ico" IsVisible="{Binding IsDocument}"
                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6" />
                        </Panel>
                    </Panel>
                    <TextBlock Grid.Column="1" Classes="file-heading" IsVisible="{Binding IsFolder}"
                               VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="file-title" IsVisible="{Binding IsDocument}"
                               VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.ColumnSpan="3" Classes="muted" FontSize="11" IsVisible="{Binding IsLoadingPlaceholder}"
                               Text="{i18n:I18n {x:Static l:VexL.SidebarFilesLoading}}" />
                    <Button Grid.ColumnSpan="3" IsVisible="{Binding IsErrorPlaceholder}" Click="RetryDirectoryClicked"
                            Height="24" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0"
                            Content="{i18n:I18n {x:Static l:VexL.SidebarFilesRetry}}"
                            ToolTip.Tip="{i18n:I18n {x:Static l:VexL.SidebarFilesLoadFailed}}" />
                </Grid>
            </Border>
        </TreeDataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TreeView.side-tree TreeViewItem" x:DataType="models:DocumentFileNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <!-- 对应原型 .files-toolbar button：26×26、5px 圆角、按下为 accent-soft。 -->
        <Style Selector="Button.files-tool, ToggleButton.files-tool">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.files-tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.files-tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.files-tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.files-tool:checked Path">
            <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <!-- 底部条目录钮（原型 .files-folder）：flex 占满、13px 文件夹图标 + 名称、4px 圆角、悬浮 hover 底 + 前景。 -->
        <Style Selector="Button.files-folder">
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.files-folder:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="Button.files-folder:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}" />
        </Style>
        <Style Selector="Button.files-folder Path.folder-ico">
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Button.files-folder:pointerover Path.folder-ico">
            <Setter Property="Stroke" Value="{DynamicResource VexValueBrush}" />
        </Style>
        <!-- 文件列表（原型 .file-row）：与树形行同口径 24px 单行，直角通栏 hover/选中底（deck-nav 同款 ContentPresenter 配方）。 -->
        <Style Selector="ListBox.files-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.files-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.files-list Path.tree-ico">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem:selected Path.tree-ico">
            <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="ListBox.files-list TextBlock.file-list-name">
            <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem:selected TextBlock.file-list-name">
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.files-list TextBlock.file-folder-tag">
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ListBox.files-list ListBoxItem:selected TextBlock.file-folder-tag">
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 对应原型 .sidebar-search：32px 高、8px 圆角、内嵌搜索图标与常显清除按钮。 -->
        <Border
            x:Name="FileSearchBox"
            Grid.Row="0"
            Height="32"
            Margin="5,14,5,8"
            Padding="8,0"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource VexControlBorderBrush}"
            Background="Transparent">
            <Grid ColumnDefinitions="13,*,20" ColumnSpacing="7" VerticalAlignment="Center">
                <Path Classes="stroke-ico" Width="13" Height="13" StrokeThickness="1.6"
                      VerticalAlignment="Center"
                      Data="M17 10A7 7 0 1 1 3 10A7 7 0 1 1 17 10 M15 15L22 22" />
                <TextBox
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    MinHeight="0"
                    FontSize="12"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource VexValueBrush}"
                    PlaceholderForeground="{DynamicResource VexMutedBrush}"
                    PlaceholderText="{i18n:I18n {x:Static l:VexL.SidebarFilesFilterPlaceholder}}"
                    Text="{Binding FilterText, Mode=TwoWay}"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SidebarFilesFilterPlaceholder}}" />
                <Button Grid.Column="2" Classes="files-tool" Width="18" Height="18" Padding="3"
                        Command="{Binding ClearFilter}"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.ClearSearch}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.ClearSearch}}">
                    <Path Classes="stroke-ico" Width="11" Height="11" StrokeThickness="1.6" Data="M6 6L18 18 M18 6L6 18" />
                </Button>
            </Grid>
        </Border>

        <TreeView
            x:Name="FileTree"
            Grid.Row="1"
            Classes="side-tree"
            Margin="5,0"
            IsVisible="{Binding IsTreeView}"
            ItemsSource="{Binding FilteredDocumentFileNodes}"
            PointerPressed="SelectItemOnPointerPressed"
            SelectedItem="{Binding SelectedDocumentFileNode, Mode=TwoWay}">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                        Command="{Binding OpenSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenInNewWindow}}" Command="{Binding OpenInNewWindow}" IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Rename}}"
                        Command="{Binding RenameSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}"
                        Command="{Binding OpenSelectedFileLocation}"
                        IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.NewDocument}}" Command="{Binding NewDocument}"/>
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenFolder}}" Command="{Binding OpenFolderAsync}"/>
                    <MenuItem Header="{i18n:I18n Vex.VexL.RefreshFiles}" Command="{Binding RefreshFiles}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Delete}}"
                        Command="{Binding DeleteSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <ListBox x:Name="FileList" Grid.Row="1" Classes="files-list" Margin="5,0" IsVisible="{Binding IsListView}"
                 ItemsSource="{Binding FlatDocumentFileNodes}" SelectedItem="{Binding SelectedListDocumentFileNode, Mode=TwoWay}" PointerPressed="SelectItemOnPointerPressed">
            <ListBox.ItemTemplate><DataTemplate x:DataType="models:DocumentFileNode">
                <!-- 原型 .file-row：与树形行同口径的单行（图标 + 名称 + 行尾目录标签），选中底由通栏模板行绘制。 -->
                <Grid Classes="file-list-row" ColumnDefinitions="12,*,Auto" ColumnSpacing="6" Margin="4,0">
                    <Panel Width="12" Height="12" VerticalAlignment="Center">
                        <Image x:Name="ListFileIcon" Classes="tree-ico" Width="12" Height="12" Stretch="Uniform"
                               IsVisible="{Binding #ListFileIcon.Source, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource FileIconConverter}">
                                    <Binding Path="Name" />
                                    <Binding Path="IsFolder" />
                                    <Binding Path="IsExpanded" />
                                    <Binding Path="$parent[UserControl].ActualThemeVariant" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Path Classes="tree-ico" IsVisible="{Binding #ListFileIcon.Source, Converter={x:Static avaloniaConverters:ObjectConverters.IsNull}}"
                              Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6" />
                    </Panel>
                    <TextBlock Grid.Column="1" Classes="file-list-name" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Grid.Column="2" Classes="file-folder-tag" Text="{Binding FolderTag}" VerticalAlignment="Center"
                               IsVisible="{Binding FolderTag, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                </Grid>
            </DataTemplate></ListBox.ItemTemplate>
            <ListBox.ContextMenu><ContextMenu>
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                        Command="{Binding OpenSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenInNewWindow}}" Command="{Binding OpenInNewWindow}" IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Rename}}"
                        Command="{Binding RenameSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}"
                        Command="{Binding OpenSelectedFileLocation}"
                        IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.NewDocument}}" Command="{Binding NewDocument}"/>
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenFolder}}" Command="{Binding OpenFolderAsync}" ToolTip.Tip="{Binding WorkspaceName}"/>
                    <MenuItem Header="{i18n:I18n Vex.VexL.RefreshFiles}" Command="{Binding RefreshFiles}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Delete}}"
                        Command="{Binding DeleteSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                </ContextMenu></ListBox.ContextMenu>
        </ListBox>
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsDocumentFilesEmpty}"
            Padding="18"
            VerticalAlignment="Top">
            <TextBlock
                Classes="muted"
                FontSize="12"
                Text="{i18n:I18n {x:Static l:VexL.EmptyNoFiles}}"
                TextAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="18,12" Spacing="4" VerticalAlignment="Top" IsHitTestVisible="False"
                    IsVisible="{Binding IsIndexLoading}">
            <TextBlock Classes="muted" FontSize="12" Text="{i18n:I18n {x:Static l:VexL.SidebarFilesLoading}}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="18,12" Spacing="4" VerticalAlignment="Top" IsVisible="{Binding HasIndexError}">
            <TextBlock Classes="muted" FontSize="12" Text="{i18n:I18n {x:Static l:VexL.SidebarFilesLoadFailed}}" />
            <Button Command="{Binding RetryIndex}" Content="{i18n:I18n {x:Static l:VexL.SidebarFilesRetry}}" />
        </StackPanel>

        <!-- 对应原型 .files-toolbar（workspace-chrome.css:618）：紧跟搜索框下方，整行居左、无分隔线，
             左内距与搜索框同为 5，行高 34、下内距 8、以 -6 外边距贴紧搜索框的 8px 下边距。 -->
        <!-- 列表视图超阈值提示（对齐原型：文件过多请切树形视图）。 -->
        <Border Grid.Row="1" IsVisible="{Binding IsListOverflow}" Background="{DynamicResource VexDocumentPaperBrush}"
                ZIndex="6" Padding="18" VerticalAlignment="Top" Margin="18,12">
            <TextBlock Classes="muted" FontSize="12" LineHeight="24" TextWrapping="Wrap"
                       Text="{i18n:I18n {x:Static l:VexL.FileListOverflowHint}}"/>
        </Border>
        <!-- 底部条（原型 .files-footer）：目录名占满剩余宽度，排序/视图两枚 26×26 按钮靠右，gap 2、内距 6×10、顶缘 1px 描线。 -->
        <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                <Button x:Name="SortFolderButton" Classes="files-folder" HorizontalContentAlignment="Stretch"
                        Flyout="{StaticResource SortFlyout}"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.SortFiles}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SortFiles}}">
                    <Grid ColumnDefinitions="13,*" ColumnSpacing="6">
                        <Path Classes="folder-ico" Width="13" Height="13" VerticalAlignment="Center"
                              Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" Classes="files-tool"
                        Flyout="{StaticResource SortFlyout}"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.SortFiles}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SortFiles}}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{x:Null}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12 3.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3 M12 10.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3 M12 17.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3" />
                </Button>
                <ToggleButton Grid.Column="2" Classes="files-tool" IsChecked="{Binding IsTreeView, Mode=OneWay}"
                              Command="{Binding ToggleListView}"
                              ToolTip.Tip="{i18n:I18n {x:Static l:VexL.ToggleTreeList}}"
                              AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.ToggleTreeList}}">
                    <Panel>
                        <Path Classes="stroke-ico" Width="14" Height="14" StrokeThickness="1.6" IsVisible="{Binding IsTreeView}"
                              Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01"/>
                        <Path Classes="stroke-ico" Width="14" Height="14" StrokeThickness="1.6" IsVisible="{Binding IsListView}"
                              Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </Panel>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
