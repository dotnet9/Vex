<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellFilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:models="using:Vex.Core.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellFilesViewModel"
    prism:ViewModelLocator.AutoWireViewModel="True"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarFiles}"
    regions:RegionTab.IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6">

    <UserControl.DataTemplates>
        <TreeDataTemplate DataType="models:DocumentFileNode" ItemsSource="{Binding Children}">
            <!-- 文件树使用原型的单行布局，摘要放入提示，避免文件夹空摘要撑高行。 -->
            <Border Classes="file-card" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    ToolTip.Tip="{Binding Preview}" ToolTip.IsEnabled="{Binding IsDocument}">
                <Grid>
                    <Border Classes="file-bar" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}" HorizontalAlignment="Left" />
                    <Grid Height="30" Margin="10 0" ColumnDefinitions="15,*,Auto" ColumnSpacing="7">
                        <Path Classes="stroke-ico tree-ico" VerticalAlignment="Center" IsVisible="{Binding IsFolder}"
                              Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        <Path Classes="stroke-ico tree-ico" VerticalAlignment="Center" IsVisible="{Binding IsDocument}"
                              Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6" />
                        <TextBlock Grid.Column="1" MinHeight="16" Classes="file-heading" IsVisible="{Binding IsFolder}"
                                   VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" MinHeight="16" Classes="file-title" IsVisible="{Binding IsDocument}"
                                   VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                    </Grid>
                </Grid>
            </Border>
        </TreeDataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles><Style Selector="TreeViewItem" x:DataType="models:DocumentFileNode"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style><Style Selector="Path.tree-ico"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="StrokeThickness" Value="1.5"/></Style></UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBox
            Grid.Row="0"
            Margin="14 8 14 8"
            MinHeight="30"
            FontSize="11.5"
            Foreground="{DynamicResource VexValueBrush}"
            PlaceholderForeground="{DynamicResource VexMutedBrush}"
            BorderBrush="{DynamicResource VexPanelBorderBrush}"
            PlaceholderText="{i18n:I18n {x:Static l:VexL.SidebarFilesFilterPlaceholder}}"
            Text="{Binding FilterText, Mode=TwoWay}"
            TextWrapping="NoWrap" />
        <TreeView
            Grid.Row="1"
            Classes="side-tree"
            IsVisible="{Binding IsTreeView}"
            ItemsSource="{Binding FilteredDocumentFileNodes}"
            PointerPressed="SelectItemOnPointerPressed"
            SelectedItem="{Binding SelectedDocumentFileNode, Mode=TwoWay}">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                        Command="{Binding OpenSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenInNewWindow}}" Command="{Binding OpenInNewWindow}" IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Rename}}"
                        Command="{Binding RenameSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}"
                        Command="{Binding OpenSelectedFileLocation}"
                        IsEnabled="{Binding HasPathCommandTarget}" />
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Delete}}"
                        Command="{Binding DeleteSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <ListBox x:Name="FileList" Grid.Row="1" Classes="side-list" IsVisible="{Binding IsListView}"
                 ItemsSource="{Binding FlatDocumentFileNodes}" SelectedItem="{Binding SelectedDocumentFileNode, Mode=TwoWay}" PointerPressed="SelectItemOnPointerPressed">
            <ListBox.ItemTemplate><DataTemplate x:DataType="models:DocumentFileNode">
                <Grid RowDefinitions="Auto,Auto" Margin="4,5" ToolTip.Tip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="10.5" Classes="muted" MaxHeight="32" TextWrapping="Wrap"/>
                </Grid>
            </DataTemplate></ListBox.ItemTemplate>
            <ListBox.ContextMenu>                <ContextMenu>
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                        Command="{Binding OpenSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenInNewWindow}}" Command="{Binding OpenInNewWindow}" IsEnabled="{Binding HasPathCommandTarget}"/>
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Rename}}"
                        Command="{Binding RenameSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}"
                        Command="{Binding OpenSelectedFileLocation}"
                        IsEnabled="{Binding HasPathCommandTarget}" />
                    <Separator />
                    <MenuItem
                        Header="{i18n:I18n {x:Static l:VexL.Delete}}"
                        Command="{Binding DeleteSelectedFile}"
                        IsEnabled="{Binding HasDocumentFileCommandTarget}" />
                </ContextMenu></ListBox.ContextMenu>
        </ListBox>
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsDocumentFilesEmpty}"
            Padding="18"
            VerticalAlignment="Top">
            <TextBlock
                Classes="muted"
                FontSize="11.5"
                Text="{i18n:I18n {x:Static l:VexL.EmptyNoFiles}}"
                TextAlignment="Center" />
        </Border>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}" Padding="8,5">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2">
                <Button Classes="wb-quiet" Command="{Binding NewDocument}" Width="28" Height="28" Padding="5" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.NewDocument}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.NewDocument}}"><Path Classes="stroke-ico" Data="M12 5V19 M5 12H19"/></Button>
                <Button Grid.Column="1" Classes="wb-quiet" Command="{Binding OpenFolderAsync}" HorizontalContentAlignment="Left" Padding="4" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.OpenFolder}}"><TextBlock Text="{Binding WorkspaceName}" TextTrimming="CharacterEllipsis" FontSize="11"/></Button>
                <Button Grid.Column="2" Classes="wb-quiet" Width="26" Height="28" Padding="5" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.FileActions}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.FileActions}}">
                    <Path Classes="stroke-ico" Data="M4 12H5 M11 12H12 M18 12H19"/>
                    <Button.Flyout><MenuFlyout>
                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.NewDocument}}" Command="{Binding NewDocument}"/>
                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.QuickOpen}}" Command="{Binding QuickOpen}"/>
                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenFolder}}" Command="{Binding OpenFolderAsync}"/>
                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.RefreshPreview}}" Command="{Binding RefreshFiles}"/>
                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.SortFiles}}" Command="{Binding ToggleSort}"/>
                    </MenuFlyout></Button.Flyout>
                </Button>
                <Button x:Name="CollapseFilesButton" Grid.Column="3" Classes="wb-quiet" Width="26" Height="28" Padding="5" Command="{Binding CollapseAll}" IsEnabled="{Binding CanCollapseAll}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.CollapseAllFiles}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.CollapseAllFiles}}"><Path Classes="stroke-ico" Data="M4 4H20 M4 20H20 M8 8L12 11L16 8 M8 16L12 13L16 16"/></Button>
                <ToggleButton Grid.Column="4" Classes="wb-quiet" Width="26" Height="28" Padding="5" Command="{Binding ToggleListView}" IsChecked="{Binding IsListView, Mode=OneWay}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.ToggleFileList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.ToggleFileList}}"><Path Classes="stroke-ico" Data="M8 6H21 M8 12H21 M8 18H21 M3 6H4 M3 12H4 M3 18H4"/></ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
