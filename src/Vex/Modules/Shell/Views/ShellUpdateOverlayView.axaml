<UserControl x:Class="Vex.Modules.Shell.Views.ShellUpdateOverlayView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers"
 xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
 xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:ShellUpdateViewModel">
 <UserControl.Styles>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/></Style>
  <!-- 原型 .update-tag：10px/600、胶囊 999、内边距 2×7，四档语义色（新增 success / 优化 info / 修复 warning / 删除 danger）。
       胶囊只吃圆角档位，直角档随圆角缩放归零，与原型一致。 -->
  <Style Selector="Border.update-tag"><Setter Property="Padding" Value="7,2"/><Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}"/></Style>
  <Style Selector="Border.update-tag TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="15"/></Style>
  <Style Selector="Border.update-tag.tag-new TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexSuccessBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-new"><Setter Property="Background" Value="{DynamicResource VexSuccessSoftBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-opt TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexInfoBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-opt"><Setter Property="Background" Value="{DynamicResource VexInfoSoftBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-fix TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexWarningBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-fix"><Setter Property="Background" Value="{DynamicResource VexWarningSoftBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-remove TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexDangerBrush}"/></Style>
  <Style Selector="Border.update-tag.tag-remove"><Setter Property="Background" Value="{DynamicResource VexDangerSoftBrush}"/></Style>
 </UserControl.Styles>
 <Border Classes="dialog-card" Width="620" MaxHeight="760" Padding="0" CornerRadius="14" ClipToBounds="True">
  <Grid RowDefinitions="36,*">
   <Border Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
    <Grid ColumnDefinitions="*,46" VerticalAlignment="Center">
     <TextBlock Text="{i18n:I18n {x:Static l:VexL.AboutCheckUpdate}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Click="Close_OnClick" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/>
    </Grid>
   </Border>
   <!-- 版本头部、进度、按钮全部钉住，只有更新日志区在自身最大高度内滚动——
        对话框本体不再出现竖直滚动条，操作按钮不会被长日志顶出可视区。 -->
   <Grid Grid.Row="1" Margin="30,26,30,22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">

     <Grid ColumnDefinitions="48,*" ColumnSpacing="17">
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource VexAccentBrush}" VerticalAlignment="Top">
       <Viewbox Width="39" Height="39" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="64" Height="64"><Path Data="M13 12L32 52L51 12" Stroke="White" StrokeThickness="12" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
      </Border>
      <StackPanel Grid.Column="1" Spacing="6" Margin="0,2,0,0">
       <TextBlock x:Name="UpdateStatus" Text="{Binding PhaseTitle}" FontSize="19" LineHeight="26.6" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding PhaseDetail}" FontSize="13" LineHeight="22.75" TextWrapping="Wrap" Classes="muted"/>
      </StackPanel>
     </Grid>
     <Grid ColumnDefinitions="*,48" ColumnSpacing="14" IsVisible="{Binding IsDownloading}">
      <ProgressBar Height="8" CornerRadius="4" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Progress}" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{DynamicResource VexAccentBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="muted"/>
     </Grid>
     <Border x:Name="UpdateNotes" Grid.Row="2" IsVisible="{Binding HasReleaseNotes}" MaxHeight="428" Padding="15,14" BorderThickness="1" CornerRadius="{DynamicResource VexDensityCornerRadiusLg}" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ReleaseSections}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:UpdateNoteVersion">
         <StackPanel>
          <Border IsVisible="{Binding ShowHeader}" Classes="update-version" Padding="0,0,0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}">
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding Version, StringFormat='V{0}'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="1" Text="{Binding Date}" Classes="muted" FontSize="12" VerticalAlignment="Bottom"/>
           </Grid>
          </Border>
          <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding Entries}">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UpdateNoteEntry">
             <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,7">
              <Border Classes="update-tag" Classes.tag-new="{Binding IsNew}" Classes.tag-opt="{Binding IsOptimized}"
                      Classes.tag-fix="{Binding IsFixed}" Classes.tag-remove="{Binding IsRemoved}"
                      IsVisible="{Binding HasTag}" VerticalAlignment="Top" Margin="0,2,0,0">
               <TextBlock Text="{Binding TagText}"/>
              </Border>
              <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="21.45"/>
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
     </Border>
     <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
      <Button Margin="0,0,10,0" Command="{Binding CancelCommand}" Content="{i18n:I18n {x:Static l:VexL.Cancel}}" IsVisible="{Binding IsDownloading}" MinWidth="104" MinHeight="36" Padding="16,8" FontSize="13"/>
      <Button x:Name="UpdateDismiss" Margin="0,0,10,0" Click="Close_OnClick" Content="{i18n:I18n {x:Static l:VexL.UpdateLater}}" IsVisible="{Binding ShowLater}" MinWidth="104" MinHeight="36" Padding="16,8" FontSize="13"/>
      <Button x:Name="UpdateAction" Classes.primary="{Binding IsPrimaryAction}" Command="{Binding UpdateCommand}" Content="{Binding ActionText}" IsVisible="{Binding ShowAction}" MinWidth="104" MinHeight="36" Padding="16,8" FontSize="13"/>
     </WrapPanel>
   </Grid>
  </Grid>
 </Border>
</UserControl>
