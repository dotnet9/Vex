<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
             xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:MainWindowViewModel"
             x:Class="Vex.Modules.Shell.Views.ShellWorkbenchToolbarView">
    <Border Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="☰" Command="{Binding Layout.ToggleSidebar}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBToggleNavigation}}" Classes="workbench-quiet" />
                <TextBlock Text="{Binding DocumentInfo.PropertyNameText}" FontSize="13" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="PerspectiveTarget" Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                <ToggleButton Content="{i18n:I18n {x:Static l:VexL.WBEdit}}" Command="{Binding Workbench.ShowEdit}" IsChecked="{Binding Workbench.IsEditing, Mode=OneWay}" Classes="workbench-view" />
                <ToggleButton Content="{i18n:I18n {x:Static l:VexL.WBRead}}" Command="{Binding Workbench.ShowRead}" IsChecked="{Binding Workbench.IsReading, Mode=OneWay}" Classes="workbench-view" />
                <ToggleButton Content="{i18n:I18n {x:Static l:VexL.WBMap}}" Command="{Binding Workbench.ShowMindMap}" IsChecked="{Binding Workbench.IsMindMap, Mode=OneWay}" Classes="workbench-view" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding Workbench.IsEditing}">
                    <ToggleButton Content="{i18n:I18n {x:Static l:VexL.WBInstant}}" Command="{Binding Workbench.ShowInstant}" IsChecked="{Binding Workbench.IsInstantEditing, Mode=OneWay}" Classes="workbench-quiet" />
                    <ToggleButton Content="{i18n:I18n {x:Static l:VexL.WBSource}}" Command="{Binding Workbench.ShowSource}" IsChecked="{Binding Workbench.IsSourceEditing, Mode=OneWay}" Classes="workbench-quiet" />
                </StackPanel>
                <Button x:Name="TypographyTarget" Content="{i18n:I18n {x:Static l:VexL.WBTypography}}" Command="{Binding Workbench.ToggleTypography}" Classes="workbench-quiet" IsVisible="{Binding !Workbench.IsMindMap}" />
                <Button Content="{i18n:I18n {x:Static l:VexL.WBMapSource}}" Command="{Binding Workbench.ToggleMapSource}" Classes="workbench-quiet" IsVisible="{Binding Workbench.IsMindMap}" />
                <Button Content="{i18n:I18n {x:Static l:VexL.WBMapSettings}}" Command="{Binding Workbench.ToggleMapSettings}" Classes="workbench-quiet" IsVisible="{Binding Workbench.IsMindMap}" />
                <Button x:Name="QuickStartButton" Content="{i18n:I18n {x:Static l:VexL.WBQuickStart}}" Classes="workbench-quiet" Click="QuickStartClick" />
            </StackPanel>
        </Grid>
    </Border>
    <UserControl.Styles>
        <Style Selector="Button.workbench-quiet, ToggleButton.workbench-quiet">
            <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.workbench-view">
            <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="16,5"/><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="30"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.workbench-view:checked, ToggleButton.workbench-quiet:checked">
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
