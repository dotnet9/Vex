<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
             xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:MainWindowViewModel" x:Class="Vex.Modules.Shell.Views.ShellWorkbenchToolbarView">
  <Border Height="58" Padding="16,0" Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
      <StackPanel VerticalAlignment="Center" Spacing="4" ToolTip.Tip="{Binding DocumentInfo.CurrentFilePath}">
        <TextBlock Text="{Binding DocumentInfo.PropertyNameText}" FontSize="13" FontWeight="SemiBold" MaxWidth="280" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
        <TextBlock IsVisible="{Binding !Protection.HasSaveError}" Text="{Binding DocumentInfo.DocumentStateText}" FontSize="12" Foreground="{DynamicResource VexMutedBrush}"/>
        <TextBlock IsVisible="{Binding Protection.HasSaveError}" Text="{i18n:I18n {x:Static l:VexL.SaveFailureKept}}" FontSize="12" Foreground="{DynamicResource VexDangerBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
      </StackPanel>
      <Button x:Name="LayoutButton" Grid.Column="1" Classes="wb-quiet" Command="{Binding Workbench.ToggleLayouts}" VerticalAlignment="Center" Padding="12,6" FontSize="12">
        <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="wb-icon" Data="{StaticResource WBColumnsIcon}"/><TextBlock Text="{Binding Workbench.LayoutName}"/><TextBlock Text="⌄"/></StackPanel>
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="QuickStartButton" IsVisible="False" Click="QuickStartClick"/>
        <Button x:Name="PresentButton" IsVisible="False" Command="{Binding Workbench.StartPresentation}"/>
        <Button Classes="wb-quiet" Command="{Binding ShowFindPanel}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Find}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Find}}" Padding="7"><Path Classes="wb-icon" Data="{StaticResource WBSearchIcon}"/></Button>
        <Button x:Name="SaveButton" Command="{Binding SaveAsync}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource VexPanelBorderBrush}" FontSize="12" Padding="10,4" MinHeight="28" CornerRadius="6"><StackPanel Orientation="Horizontal" Spacing="7"><Path Classes="wb-icon" Data="{StaticResource WBSaveIcon}"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.Save}}"/></StackPanel></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
