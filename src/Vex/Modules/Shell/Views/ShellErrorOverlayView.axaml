<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellErrorOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource VexOverlayScrimBrush}" IsVisible="{Binding Dialogs.IsErrorPanelVisible}">
        <Border
            Width="460"
            Padding="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource VexPanelBackgroundBrush}"
            BorderBrush="{DynamicResource VexPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="dlg-ico warn">
                        <PathIcon
                            Width="18"
                            Height="18"
                            Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M15 9l-6 6 M9 9l6 6" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextBlockDefaultForeground}"
                        Text="{Binding Dialogs.ErrorTitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Classes="muted"
                    Text="{Binding Dialogs.ErrorMessage}"
                    TextWrapping="Wrap" />
                <Expander
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <Expander.Header>
                        <TextBlock
                            Classes="muted"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{i18n:I18n {x:Static l:VexL.ErrorDetailLabel}}" />
                    </Expander.Header>
                    <Border
                        Padding="10"
                        Background="{DynamicResource TextBlockCodeBackground}"
                        BorderBrush="{DynamicResource VexPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ScrollViewer MaxHeight="160">
                            <SelectableTextBlock
                                Classes="muted"
                                FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                FontSize="12"
                                Text="{Binding Dialogs.ErrorDetail}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Classes="primary"
                        Command="{Binding Dialogs.CloseErrorPanel}"
                        Content="{i18n:I18n {x:Static l:VexL.Close}}"
                        MinWidth="86" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
