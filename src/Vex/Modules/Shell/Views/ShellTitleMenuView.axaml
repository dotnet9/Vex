<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellTitleMenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Vex.Core.Messaging"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellTitleMenuViewModel"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- Avalonia 12.1 的编译绑定不再接受带强类型参数的方法命令；
         仅这些带 CommandParameter 的方法使用反射绑定，其余数据绑定继续保留编译期检查。 -->
    <Menu Classes="title-menu" VerticalAlignment="Center">
        <MenuItem x:Name="FileMenuItem" Header="{i18n:I18n {x:Static l:VexL.MenuFile}}">
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.NewDocument}}" Command="{Binding NewDocument}" InputGesture="Ctrl+N" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.NewWindow}}" Command="{Binding NewWindow}" InputGesture="Ctrl+Shift+N" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenFile}}" Command="{Binding OpenAsync}" InputGesture="Ctrl+O" />
            <MenuItem x:Name="OpenFolderMenuItem" Header="{i18n:I18n {x:Static l:VexL.OpenFolder}}" Command="{Binding OpenFolderAsync}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuSamples}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="samples" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.QuickOpen}}" Command="{Binding QuickOpenAsync}" InputGesture="Ctrl+P" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenRecent}}" IsEnabled="{Binding Recent.HasRecentDocuments}">
                <MenuItem Header="{Binding Recent.RecentDocument1Text}" Command="{Binding OpenRecentDocument1Async}" IsVisible="{Binding Recent.HasRecentDocument1}" ToolTip.Tip="{Binding Recent.RecentDocument1ToolTip}" />
                <MenuItem Header="{Binding Recent.RecentDocument2Text}" Command="{Binding OpenRecentDocument2Async}" IsVisible="{Binding Recent.HasRecentDocument2}" ToolTip.Tip="{Binding Recent.RecentDocument2ToolTip}" />
                <MenuItem Header="{Binding Recent.RecentDocument3Text}" Command="{Binding OpenRecentDocument3Async}" IsVisible="{Binding Recent.HasRecentDocument3}" ToolTip.Tip="{Binding Recent.RecentDocument3ToolTip}" />
                <MenuItem Header="{Binding Recent.RecentDocument4Text}" Command="{Binding OpenRecentDocument4Async}" IsVisible="{Binding Recent.HasRecentDocument4}" ToolTip.Tip="{Binding Recent.RecentDocument4ToolTip}" />
                <MenuItem Header="{Binding Recent.RecentDocument5Text}" Command="{Binding OpenRecentDocument5Async}" IsVisible="{Binding Recent.HasRecentDocument5}" ToolTip.Tip="{Binding Recent.RecentDocument5ToolTip}" />
                <Separator />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.ClearRecent}}" Command="{Binding Recent.ClearRecentDocuments}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Save}}" Command="{Binding SaveAsync}" InputGesture="Ctrl+S" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.SaveAs}}" Command="{Binding SaveAsAsync}" InputGesture="Ctrl+Shift+S" />
            <Separator />
            <MenuItem x:Name="ExportMenuItem" Header="{i18n:I18n {x:Static l:VexL.Export}}">
                <MenuItem Header="{i18n:I18n Vex.VexL.DialogExportHtmlTitle}" Command="{Binding Export}" CommandParameter="HTML" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.ExportPdf}}" Command="{Binding Export}" CommandParameter="PDF" />
                <MenuItem Header="{i18n:I18n Vex.VexL.MenuExportPng}" Command="{Binding Export}" CommandParameter="PNG" />
                <MenuItem Header="{i18n:I18n Vex.VexL.MenuExportWord}" Command="{Binding Export}" CommandParameter="Word" />
            </MenuItem>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Print}}" Command="{Binding Print}" InputGesture="Ctrl+Shift+P" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuDocumentActions}}">
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuProperties}" Command="{Binding ShowProperties}" InputGesture="Alt+Enter" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.OpenFileLocation}}" Command="{Binding OpenFileLocationAsync}" IsEnabled="{Binding DocumentInfo.HasCurrentFile}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.ReopenWithEncoding}}">
                <MenuItem Header="UTF-8" Command="{Binding ReopenWithEncodingAsync}" CommandParameter="utf-8" />
                <MenuItem Header="UTF-8 BOM" Command="{Binding ReopenWithEncodingAsync}" CommandParameter="utf-8-bom" />
                <MenuItem Header="GB18030" Command="{Binding ReopenWithEncodingAsync}" CommandParameter="GB18030" />
                <MenuItem Header="Big5" Command="{Binding ReopenWithEncodingAsync}" CommandParameter="Big5" />
            </MenuItem>
            <Separator />
            <MenuItem Classes="danger" Header="{i18n:I18n Vex.VexL.MenuDeleteDocument}" Command="{Binding DeleteAsync}" IsEnabled="{Binding DocumentInfo.HasCurrentFile}" />
            </MenuItem>
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuCloseDocument}" Command="{Binding CloseDocument}" InputGesture="Ctrl+W" />
        </MenuItem>

        <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuEdit}}">
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Undo}}" Command="{Binding EditorActions.Undo}" InputGesture="Ctrl+Z" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Redo}}" Command="{Binding EditorActions.Redo}" InputGesture="Ctrl+Y" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Cut}}" Command="{Binding EditorActions.Cut}" InputGesture="Ctrl+X" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Copy}}" Command="{Binding EditorActions.Copy}" InputGesture="Ctrl+C" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Paste}}" Command="{Binding EditorActions.Paste}" InputGesture="Ctrl+V" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.SelectAll}}" Command="{Binding EditorActions.SelectAll}" InputGesture="Ctrl+A" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.CopyPlainText}}" Command="{Binding EditorActions.CopyPlainText}" InputGesture="Ctrl+Shift+C" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Find}}" Command="{Binding ShowFindPanel}" InputGesture="Ctrl+F" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Replace}}" Command="{Binding ShowReplacePanel}" InputGesture="Ctrl+H" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuAutoPair}}" Command="{Binding EditorDisplay.ToggleAutoPair}" IsChecked="{Binding EditorDisplay.EnableAutoPair}" ToggleType="CheckBox" />
        </MenuItem>

        <MenuItem x:Name="InsertMenuItem" Header="{i18n:I18n {x:Static l:VexL.MenuParagraph}}">
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Paragraph}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Paragraph}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuHeadings}}">
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading1}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading1}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading2}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading2}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading3}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading3}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading4}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading4}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading5}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading5}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading6}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading6}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.UnorderedList}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.OrderedList}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.OrderedList}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.TaskList}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Quote}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" />
            <Separator />
            <MenuItem x:Name="TableMenuItem" Header="{i18n:I18n {x:Static l:VexL.Table}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Table}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.CodeBlock}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.CodeFence}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MathBlock}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.MathBlock}" />
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuMermaid}">
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGroup0}}">
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidFlowchart}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="flowchart" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidSequence}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="sequence" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidState}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="state" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidJourney}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="journey" />
                </MenuItem>
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGroup1}}">
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGantt}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="gantt" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidTimeline}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="timeline" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGit}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="git" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidKanban}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="kanban" />
                </MenuItem>
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGroup2}}">
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidClass}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="class" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidEr}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="er" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidRequirement}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="requirement" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidMindmap}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="mindmap" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidBlock}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="block" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidC4}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="c4" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidArchitecture}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="architecture" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidPacket}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="packet" />
                </MenuItem>
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidGroup3}}">
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidPie}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="pie" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidQuadrant}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="quadrant" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidXy}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="xy" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidSankey}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="sankey" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidRadar}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="radar" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.MermaidTreemap}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="treemap" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.HorizontalRule}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.HorizontalRule}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Footnote}}" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="footnote" />
        </MenuItem>

        <MenuItem x:Name="FormatMenuItem" Header="{i18n:I18n {x:Static l:VexL.MenuFormat}}">
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Bold}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Bold}" InputGesture="Ctrl+B" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Italic}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Italic}" InputGesture="Ctrl+I" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Strikethrough}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Strikethrough}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Highlight}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Highlight}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Superscript}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Superscript}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Subscript}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Subscript}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.InlineCode}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.InlineCode}" />
            <Separator />
            <MenuItem x:Name="LinkMenuItem" Header="{i18n:I18n {x:Static l:VexL.Link}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Link}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Image}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Image}" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.ClearFormatting}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.ClearFormatting}" />
        </MenuItem>

        <MenuItem x:Name="ViewMenuItem" Header="{i18n:I18n {x:Static l:VexL.MenuView}}">
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuEditView}" Command="{Binding Workbench.ShowEdit}" IsChecked="{Binding Workbench.IsEditing, Mode=OneWay}" ToggleType="Radio"/>
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuReadView}" Command="{Binding Workbench.ShowRead}" IsChecked="{Binding Workbench.IsReading, Mode=OneWay}" ToggleType="Radio"/>
            <MenuItem Header="{i18n:I18n Vex.VexL.MenuMindMap}" Command="{Binding Workbench.ShowMindMap}" IsChecked="{Binding Workbench.IsMindMap, Mode=OneWay}" ToggleType="Radio"/>
            <Separator/>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuEditMode}}">
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.WBInstant}}" Command="{Binding Workbench.ShowInstant}" IsChecked="{Binding Workbench.IsInstantEditing, Mode=OneWay}" ToggleType="Radio" />
                <MenuItem x:Name="SourceModeMenuItem" Header="{i18n:I18n {x:Static l:VexL.WBSource}}" Command="{Binding Workbench.ShowSource}" IsChecked="{Binding Workbench.IsSourceEditing, Mode=OneWay}" ToggleType="Radio" />
            </MenuItem>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuPanels}}">
                <MenuItem x:Name="SidebarMenuItem" Header="{i18n:I18n {x:Static l:VexL.ToggleSidebar}}" Command="{Binding Layout.ToggleSidebar}" IsChecked="{Binding Layout.IsSidebarVisible, Mode=OneWay}" ToggleType="CheckBox" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.DocumentList}}" Command="{Binding Layout.ShowFiles}" />
                <MenuItem x:Name="OutlineMenuItem" Header="{i18n:I18n {x:Static l:VexL.Outline}}" Command="{Binding Layout.ShowOutline}" />
            </MenuItem>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuEditorDisplay}}">
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.ShowLineNumbers}}" Command="{Binding EditorDisplay.ToggleLineNumbers}" IsChecked="{Binding EditorDisplay.ShowLineNumbers}" ToggleType="CheckBox" />
                <MenuItem Header="{i18n:I18n Vex.VexL.PrefWordCount}" Command="{Binding ToggleWordCount}" IsChecked="{Binding Preferences.WordCountVisible, Mode=OneWay}" ToggleType="CheckBox" />
                <MenuItem Header="{i18n:I18n Vex.VexL.MenuWatermark}" Command="{Binding ToggleWatermark}" IsChecked="{Binding Preferences.WatermarkPreview, Mode=OneWay}" ToggleType="CheckBox" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuMotion}}" Command="{Binding Layout.ToggleMotion}" IsChecked="{Binding Layout.EnableMotion, Mode=OneWay}" ToggleType="CheckBox" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="PresentationMenuItem" Header="{i18n:I18n {x:Static l:VexL.WBPresentation}}" Command="{Binding Workbench.StartPresentation}" InputGesture="F5"/>
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuFocusMode}}" Command="{Binding Layout.ToggleFocusMode}" InputGesture="F8" IsChecked="{Binding Layout.IsFocusMode}" ToggleType="CheckBox" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuTypewriterMode}}" Command="{Binding Layout.ToggleTypewriterMode}" IsChecked="{Binding Layout.IsTypewriterMode}" ToggleType="CheckBox" />
            <Separator />
            <MenuItem x:Name="ThemeMenuItem" Header="{i18n:I18n {x:Static l:VexL.WBTheme}}" />
            <MenuItem x:Name="TypographyMenuItem" Header="{i18n:I18n {x:Static l:VexL.WBTypography}}" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.MenuWindow}}">
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.ToggleFullScreen}}" Command="{Binding Layout.ToggleFullScreen}" InputGesture="F11" ToggleType="CheckBox" IsChecked="{Binding Layout.IsFullScreen, Mode=OneWay}" />
                <MenuItem Header="{i18n:I18n {x:Static l:VexL.AlwaysOnTop}}" Command="{Binding Layout.ToggleAlwaysOnTop}" IsChecked="{Binding Layout.IsAlwaysOnTop}" ToggleType="CheckBox" />
                <MenuItem Header="{i18n:I18n Vex.VexL.MenuMaximize}" Command="{Binding Layout.ToggleMaximize}" />
            </MenuItem>

        </MenuItem>

        <MenuItem x:Name="ToolsMenuItem" Header="{i18n:I18n {x:Static l:VexL.WBTools}}">
            <MenuItem x:Name="PreferencesMenuItem" Header="{i18n:I18n {x:Static l:VexL.Preferences}}" Command="{Binding ShowPreferences}" InputGesture="Ctrl+," />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.WBMapSettings}}" Command="{Binding Workbench.OpenMapSettings}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.WordCount}}" Command="{Binding WordCount}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.RefreshPreview}}" Command="{Binding RefreshPreview}" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.CopyToWechat}}" Command="{Binding CopyHtml}" CommandParameter="wechat" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.CopyToZhihu}}" Command="{Binding CopyHtml}" CommandParameter="zhihu" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.CopyToJuejin}}" Command="{Binding CopyHtml}" CommandParameter="juejin" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.McpSettings}}" Command="{Binding ShowMcpSettings}" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.McpAudit}}" Command="{Binding ShowMcpAudit}" />
        </MenuItem>

        <MenuItem x:Name="HelpMenuItem" Header="{i18n:I18n {x:Static l:VexL.MenuHelp}}">
            <MenuItem x:Name="BeginGuideMenuItem" Header="{i18n:I18n {x:Static l:VexL.OnboardingGuide}}" Click="BeginGuideMenuItem_OnClick" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Changelog}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="changelog" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Thanks}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="thanks" />
            <Separator />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Website}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="website" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.Feedback}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="feedback" />
            <MenuItem x:Name="CheckUpdatesMenuItem" Header="{i18n:I18n {x:Static l:VexL.AboutCheckUpdate}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="update" />
            <MenuItem Header="{i18n:I18n {x:Static l:VexL.About}}" Command="{Binding Help.OpenHelpTopic}" CommandParameter="about" />
        </MenuItem>
    </Menu>
</UserControl>
