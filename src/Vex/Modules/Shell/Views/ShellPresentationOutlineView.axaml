<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:model="using:Vex.Modules.Workspace.Services"
             xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
             x:Class="Vex.Modules.Shell.Views.ShellPresentationOutlineView" x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <!-- 原型 .vex-deck nav button：整列宽、无圆角；当前页（aria-current）是 accent-soft 底 + 主题色文字。 -->
    <Style Selector="ListBox.deck-nav ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.deck-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.deck-nav ListBoxItem:selected Button.deck-nav-row">
      <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <!-- 原型 .vex-deck nav：右侧大纲列——面板底色、左缘 1px 描边，宽度与正文让位同源（DeckNavWidth）。 -->
  <Border Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}"
          BorderThickness="1,0,0,0">
    <ListBox x:Name="PresentationChapters" Classes="deck-nav" ItemsSource="{Binding Workbench.PresentationSections}"
             SelectedIndex="{Binding Workbench.PresentationIndex, Mode=OneWay}"
             Background="Transparent" BorderThickness="0"
             AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPresentationOutline}}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate x:DataType="model:MarkdownPresentationDocument+Section">
        <Button Classes="deck-nav-row" Click="ChapterClick" Tag="{Binding Index}" Margin="{Binding Indent}">
          <TextBlock Text="{Binding NavLabel}" TextTrimming="CharacterEllipsis"/>
        </Button>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </Border>
</UserControl>
