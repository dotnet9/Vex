<UserControl
    x:Class="Vex.Modules.Shell.Views.McpSettingsOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:McpSettingsViewModel">
    <!-- 原型 MCP 服务页就是一列 .vex-pref-row：左标签（可带注释）、右控件、行间分隔线；不再有卡片分组与保存按钮。 -->
    <Border Classes="dialog-card" Width="620" MaxHeight="720">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <StackPanel x:Name="HeaderRow" Orientation="Horizontal" Spacing="12">
                <Border Classes="dlg-ico info">
                    <Path Classes="stroke-ico" Data="M4 17l6-6-6-6 M12 19h8" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{i18n:I18n {x:Static l:VexL.McpSettingsTitle}}" />
                    <TextBlock
                        Classes="muted"
                        FontSize="11.5"
                        Text="{i18n:I18n {x:Static l:VexL.McpSettingsDescription}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="0">
                    <!-- 启用行：注释「仅监听 127.0.0.1」随标签排在左侧，开关 34x20 靠右。 -->
                    <Border Classes="pref-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="pref-label" Text="{i18n:I18n {x:Static l:VexL.McpServerEnabled}}" />
                                <TextBlock Classes="pref-note" Text="{i18n:I18n {x:Static l:VexL.McpServerEnabledNote}}" />
                            </StackPanel>
                            <ToggleButton
                                Grid.Column="1"
                                Classes="pref-switch"
                                IsChecked="{Binding IsEnabled}" />
                        </Grid>
                    </Border>

                    <!-- 状态行紧跟启用行（原型 .vex-pref-row + .vex-mcp-status：上 12 下 18）。 -->
                    <StackPanel Classes="mcp-status follow-row" Classes.error="{Binding IsStatusError}">
                        <Border Classes="mcp-dot" Classes.on="{Binding IsStatusRunning}" Classes.starting="{Binding IsStatusStarting}" />
                        <TextBlock Text="{Binding StatusText}" />
                    </StackPanel>

                    <Border Classes="pref-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <TextBlock
                                Classes="pref-label"
                                VerticalAlignment="Center"
                                Text="{i18n:I18n {x:Static l:VexL.McpServerPort}}" />
                            <!-- 原型用原生 number 输入 + 校验文案，不用步进器：端口越界交给下方校验条提示。 -->
                            <TextBox
                                Grid.Column="1"
                                Classes="pref-field"
                                Text="{Binding PortText}" />
                        </Grid>
                    </Border>

                    <Border Classes="pref-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <TextBlock
                                Classes="pref-label"
                                VerticalAlignment="Center"
                                Text="{i18n:I18n {x:Static l:VexL.McpAuthorizationToken}}" />
                            <!-- 眼睛与重新生成两个 28x28 图标按钮叠在输入框右端（原型 .vex-token-actions）。 -->
                            <Panel Grid.Column="1" Width="180" Height="34">
                                <TextBox
                                    Classes="pref-field"
                                    Padding="9,5,65,5"
                                    PasswordChar="•"
                                    RevealPassword="{Binding IsTokenRevealed}"
                                    Text="{Binding Token}" />
                                <StackPanel
                                    Margin="0,0,3,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="1">
                                    <Button
                                        Classes="mcp-icon"
                                        Classes.on="{Binding IsTokenRevealed}"
                                        Command="{Binding ToggleTokenReveal}"
                                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.McpRevealToken}}">
                                        <Path Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                    </Button>
                                    <Button
                                        Classes="mcp-icon"
                                        Command="{Binding RegenerateToken}"
                                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.McpGenerateToken}}">
                                        <Path Data="M23 4L23 10 17 10 M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </Grid>
                    </Border>

                    <Border Classes="pref-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <TextBlock
                                Classes="pref-label"
                                VerticalAlignment="Center"
                                Text="{i18n:I18n {x:Static l:VexL.McpAllowedWorkspace}}" />
                            <ComboBox
                                Grid.Column="1"
                                Classes="pref-field"
                                SelectedIndex="{Binding AccessScopeIndex}">
                                <ComboBoxItem>
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.McpScopeCurrentDocument}}" />
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.McpScopeCurrentFolder}}" />
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.McpScopeCustomFolder}}" />
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- 只有「指定目录」才出现授权目录行，输入框吃满剩余宽度并带「…」选择器。 -->
                    <Border Classes="pref-row" IsVisible="{Binding IsCustomFolderScope}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                            <TextBlock
                                Classes="pref-label"
                                VerticalAlignment="Center"
                                Text="{i18n:I18n {x:Static l:VexL.McpAllowedFolder}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="pref-field-fill" Text="{Binding AllowedWorkspacePath}" />
                                <Button
                                    Grid.Column="1"
                                    Classes="pref-browse"
                                    Click="OnBrowseAllowedFolderClick"
                                    Content="…" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Classes="pref-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <TextBlock
                                Classes="pref-label"
                                VerticalAlignment="Center"
                                Text="{i18n:I18n {x:Static l:VexL.McpRequireConfirmation}}" />
                            <ToggleButton
                                Grid.Column="1"
                                Classes="pref-switch"
                                IsChecked="{Binding RequireConfirmation}" />
                        </Grid>
                    </Border>

                    <!-- 校验条（原型 #vex-mcp-error）：仅在提交被拒时出现。 -->
                    <TextBlock
                        Classes="pref-error"
                        IsVisible="{Binding HasValidationError}"
                        Text="{Binding ValidationError}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="FooterRow"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button Content="{i18n:I18n {x:Static l:VexL.McpCancel}}" Command="{Binding Cancel}" />
                <Button Classes="primary" Content="{i18n:I18n {x:Static l:VexL.McpSave}}" Command="{Binding SaveAsync}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
