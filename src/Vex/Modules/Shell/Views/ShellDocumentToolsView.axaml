<UserControl x:Class="Vex.Modules.Shell.Views.ShellDocumentToolsView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
 xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:vex="clr-namespace:Vex.Controls"
 xmlns:wpvm="using:Vex.Modules.Workspace.ViewModels" x:DataType="vm:ShellDocumentToolsViewModel"
 IsVisible="{Binding Layout.ShowDocumentTools}" FontSize="12">
 <StackPanel Classes="document-tools" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
  <vex:VexZoomDock x:Name="ReadingZoomDock" Classes="document-zoom" VerticalAlignment="Center"
   x:DataType="wpvm:MarkdownPreviewViewModel" IsVisible="{Binding ShowStatusZoom}"
   Minimum="50" Maximum="200" Step="5" Value="{Binding Preferences.ContentZoom, Mode=TwoWay}"
   Label="{i18n:I18n {x:Static l:VexL.PrefZoom}}" ResetLabel="{i18n:I18n {x:Static l:VexL.ZoomRestoreFont}}"
   ResetGeometry="{StaticResource WBFitIcon}" />
  <vex:VexZoomDock x:Name="MapZoomDock" Classes="document-zoom" VerticalAlignment="Center"
   IsVisible="{Binding Workbench.IsMapVisible}" Minimum="1" Maximum="200" Step="1"
   Value="{Binding Workbench.MapZoomPercent, Mode=TwoWay}" Label="{i18n:I18n {x:Static l:VexL.ZoomMap}}"
   ResetLabel="{i18n:I18n {x:Static l:VexL.WBFit}}" ResetGeometry="{StaticResource WBFitIcon}" />
  <Border Classes="document-word-count" Padding="7,3" CornerRadius="4" VerticalAlignment="Center"
   Background="{DynamicResource VexPreviewBackgroundBrush}" IsHitTestVisible="False" IsVisible="{Binding Preferences.WordCountVisible}">
   <TextBlock x:Name="DocumentWordCount" Text="{Binding DocumentInfo.StatusWordCountText}" FontSize="12"
    LineHeight="20" Foreground="{DynamicResource VexMutedBrush}" />
  </Border>
 </StackPanel>
</UserControl>
