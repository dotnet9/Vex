<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellPropertiesOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellDocumentInfoViewModel">
    <Border Classes="dialog-card" Width="520">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="dlg-ico info">
                    <Path Classes="stroke-ico" Data="M12 16v-4 M12 8h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15.5"
                    FontWeight="SemiBold"
                    Text="{i18n:I18n {x:Static l:VexL.Properties}}" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="12">
                <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.PropertyNameLabel}}" />
                <SelectableTextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding PropertyNameText}"
                    TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatusState}}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                    <!-- 已保存：绿色胶囊；未保存：主题色徽章（对应原型 pill-ok / Badge.accent） -->
                    <Border Classes="pill-ok" IsVisible="{Binding !IsModified}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse />
                            <TextBlock Text="{Binding DocumentStateText}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="9 2"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource VexAccentSoftBrush}"
                        CornerRadius="9"
                        IsVisible="{Binding IsModified}">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource VexAccentBrush}"
                            Text="{Binding DocumentStateText}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatusEncoding}}" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEncodingText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.PropertySizeLabel}}" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PropertySizeText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.PropertyPathLabel}}" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <SelectableTextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                        Text="{Binding PropertyLocationText}"
                        TextWrapping="Wrap" />
                    <Button
                        Padding="8 2"
                        VerticalAlignment="Center"
                        Click="CopyPath_OnClick"
                        Content="{i18n:I18n {x:Static l:VexL.Copy}}" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Close_OnClick"
                    Content="{i18n:I18n {x:Static l:VexL.Close}}"
                    MinWidth="86" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
