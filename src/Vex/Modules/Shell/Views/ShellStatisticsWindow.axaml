<u:UrsaWindow
    x:Class="Vex.Modules.Shell.Views.ShellStatisticsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellDocumentInfoViewModel"
    Title="{i18n:I18n {x:Static l:VexL.StatisticsTitle}}"
    Width="360"
    Height="420"
    MinWidth="330"
    MinHeight="380"
    CanMaximize="False"
    CanMinimize="False"
    CanResize="False"
    Icon="/Assets/logo.ico"
    IsFullScreenButtonVisible="False"
    IsMinimizeButtonVisible="False"
    IsRestoreButtonVisible="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Border
        Background="{DynamicResource VexPanelBackgroundBrush}"
        Padding="24">
        <Grid RowDefinitions="Auto,*">
            <!-- 核心指标卡：词数 / 字符大数字（对应原型 stat-card，tabular-nums 防跳动） -->
            <Grid ColumnDefinitions="*,12,*">
                <Border
                    Padding="14 12 14 10"
                    Background="{DynamicResource TextBlockCodeBackground}"
                    BorderBrush="{DynamicResource VexPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource VexAccentBrush}"
                            Text="{Binding Statistics.Words}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="muted"
                            FontSize="11.5"
                            Text="{i18n:I18n {x:Static l:VexL.StatusWords}}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="14 12 14 10"
                    Background="{DynamicResource TextBlockCodeBackground}"
                    BorderBrush="{DynamicResource VexPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource VexAccentBrush}"
                            Text="{Binding Statistics.Characters}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="muted"
                            FontSize="11.5"
                            Text="{i18n:I18n {x:Static l:VexL.StatusCharacters}}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 其余指标两列排布 -->
            <Grid
                Grid.Row="1"
                Margin="0 14 0 0"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="22">
                <Grid.Styles>
                    <Style Selector="Grid > SelectableTextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                    </Style>
                </Grid.Styles>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatisticsLines}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Statistics.Lines}" />
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatisticsParagraphs}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Statistics.Paragraphs}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatisticsHeadings}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Statistics.Headings}" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatisticsReading}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ReadingMinutesText}" />
                </Grid>
                <Grid Grid.Row="2" Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatusEncoding}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CurrentEncodingText}" />
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.StatusState}}" />
                    <SelectableTextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding DocumentStateText}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</u:UrsaWindow>
