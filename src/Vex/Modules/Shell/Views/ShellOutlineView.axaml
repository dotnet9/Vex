<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellOutlineView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:models="using:Vex.Core.Models"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellOutlineViewModel"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarOutline}"
    regions:RegionTab.IconData="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01">

    <UserControl.DataTemplates>
        <DataTemplate DataType="models:OutlineItem">
            <!-- 层级角标 + 渐进缩进；IsCurrent = 光标所在章节高亮 -->
            <StackPanel Margin="{Binding IndentMargin}" Orientation="Horizontal" Spacing="6">
                <Button Classes="wb-quiet" Width="18" Height="24" MinHeight="0" Padding="2"
                        IsVisible="{Binding HasChildren}"
                        Click="ToggleSection" AutomationProperties.Name="{Binding Title}">
                    <TextBlock Text="›" FontSize="16" RenderTransformOrigin="50%,50%" Classes.expanded="{Binding IsExpanded}">
                        <TextBlock.Styles><Style Selector="TextBlock"><Setter Property="RenderTransform"><RotateTransform Angle="0"/></Setter></Style><Style Selector="TextBlock.expanded"><Setter Property="RenderTransform"><RotateTransform Angle="90"/></Setter></Style></TextBlock.Styles>
                    </TextBlock>
                </Button>
                <Border Classes="lvl-badge" Classes.on="{Binding IsCurrent}">
                    <TextBlock Text="{Binding Number}" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="outline-title"
                    Classes.current="{Binding IsCurrent}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 与文件树共用搜索框样式，清除按钮仅在有内容时显示。 -->
        <Border
            Classes="sidebar-search"
            Grid.Row="0"
            Height="32"
            Padding="8,0"
            Margin="12,12,12,10">
            <Grid ColumnDefinitions="13,*,20" ColumnSpacing="7" VerticalAlignment="Center">
                <Path Classes="stroke-ico" Width="13" Height="13" StrokeThickness="1.6"
                      VerticalAlignment="Center"
                      Data="M17 10A7 7 0 1 1 3 10A7 7 0 1 1 17 10 M15 15L22 22" />
                <TextBox
                    Grid.Column="1"
                    Classes="sidebar-search-input"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    MinHeight="0"
                    FontSize="12"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource VexValueBrush}"
                    PlaceholderForeground="{DynamicResource VexMutedBrush}"
                    PlaceholderText="{i18n:I18n {x:Static l:VexL.OutlineFilterPlaceholder}}"
                    Text="{Binding FilterText, Mode=TwoWay}"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OutlineFilterPlaceholder}}" />
                <Button Grid.Column="2" Classes="sidebar-search-clear"
                        IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ClearFilter}"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.ClearSearch}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.ClearSearch}}">
                    <Viewbox Width="14" Height="14">
                        <Path Classes="stroke-ico" Width="24" Height="24" Stretch="None"
                              StrokeThickness="1.6" Data="M6 6L18 18 M18 6L6 18" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- 当前章节指示（对应原型 outline-meta） -->
        <Border
            Grid.Row="1" Padding="12 4 12 4"
            Classes="outline-fade"
            Classes.shown="{Binding HasOutlineItems}"
            IsVisible="{Binding HasOutlineItems}">
            <TextBlock
                Classes="muted"
                FontSize="11.5"
                Text="{Binding CurrentChapterText}"
                TextTrimming="CharacterEllipsis" />
        </Border>
        <ListBox
            Grid.Row="2"
            Classes="side-list"
            IsVisible="{Binding HasOutlineItems}"
            ItemsSource="{Binding FilteredOutlineItems}"
            KeyDown="OutlineKeyDown"
            SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}" />
        <!-- 阅读进度条（新增能力，随光标更新） -->
        <Border
            Grid.Row="3"
            Padding="12 2 12 10"
            Classes="outline-fade"
            Classes.shown="{Binding HasOutlineItems}"
            IsVisible="{Binding HasOutlineItems}">
            <ProgressBar
                Height="4"
                Background="{DynamicResource VexSplitterBrush}"
                CornerRadius="2"
                Foreground="{DynamicResource VexAccentBrush}"
                Maximum="100"
                Value="{Binding ReadingPercent}" />
        </Border>
        <Border
            Grid.Row="2"
            IsVisible="{Binding IsOutlineEmpty}"
            Padding="18"
            VerticalAlignment="Top">
            <TextBlock
                Classes="muted"
                Text="{i18n:I18n {x:Static l:VexL.EmptyNoHeadings}}"
                TextAlignment="Center" />
        </Border>
        <Border
            Grid.Row="2"
            IsVisible="{Binding IsFilterNoMatch}"
            Padding="18"
            VerticalAlignment="Top">
            <TextBlock
                Classes="muted"
                Text="{i18n:I18n Vex.VexL.OutlineNoMatch}"
                TextAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
