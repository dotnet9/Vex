<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellOutlineView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:md="https://codewf.com"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellOutlineViewModel"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarOutline}"
    regions:RegionTab.IconData="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01">

    <!-- 大纲 UI 已下沉到库的 MarkdownOutlinePanel（行模板/筛选/空态/键盘折叠/当前章滚动都在控件内），
         这里只留面板头与宿主接线；密度经 OutlinePanel* 资源键随 ApplyUiDensity 换档。 -->
    <Grid RowDefinitions="Auto,*">
        <Border Classes="panel-head" Grid.Row="0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="panel-title" Text="{i18n:I18n {x:Static l:VexL.SidebarOutline}}" />
                <Button x:Name="CloseOutlineButton" Grid.Column="1" Classes="panel-close" Click="RefocusRailToggle"
                        Command="{Binding ToggleOutlineCommand}"
                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.NavOutlineCollapse}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.NavOutlineCollapse}}">
                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                        <Path Classes="stroke-ico" Width="24" Height="24" Stretch="None" StrokeThickness="1.7"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M6 6L18 18 M18 6L6 18" />
                    </Canvas></Viewbox>
                </Button>
            </Grid>
        </Border>
        <md:MarkdownOutlinePanel
            x:Name="OutlinePanel"
            Grid.Row="1"
            FilterWatermark="{i18n:I18n {x:Static l:VexL.OutlineFilterPlaceholder}}"
            EmptyText="{i18n:I18n {x:Static l:VexL.EmptyNoHeadings}}"
            NoMatchText="{i18n:I18n {x:Static l:VexL.OutlineNoMatch}}"
            ShowNumbers="{Binding ShowOutlineNumbers}" />
    </Grid>
</UserControl>
