<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellOutlineView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:models="using:Vex.Core.Models"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellOutlineViewModel"
    regions:RegionTab.HeaderKey="{x:Static l:VexL.SidebarOutline}"
    regions:RegionTab.IconData="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01">

    <UserControl.DataTemplates>
        <DataTemplate DataType="models:OutlineItem">
            <!-- 原型 .structure-item 一行三味：层级角标条 + 30 宽序号列 + 标题。
                 大纲不提供行内折叠钮（workspace-chrome.js:11 明确删掉了折叠入口），
                 收缩仍走键盘左右键。 -->
            <Border Classes="structure-item" Classes.top="{Binding IsTopLevel}" Classes.on="{Binding IsCurrent}"
                    Padding="{Binding RowPadding}">
                <Grid ColumnDefinitions="Auto,30,*">
                    <Border Classes="structure-marker" />
                    <TextBlock Grid.Column="1" Classes="structure-num" Text="{Binding Number}" />
                    <TextBlock Grid.Column="2" Classes="structure-text" Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <!-- 对应原型 .structure-search（workspace-chrome.css:362）：外距 14/12/10/12，本体即那枚 pill，
             内距 5×12、实测高 31.2；焦点单环配方走 Grid.search-shell 共享样式。 -->
        <Grid Classes="search-shell" Grid.Row="0" Margin="12,14,12,10">
            <Border Classes="search-glow" />
            <Border Classes="search-frame" Padding="12,5">
                <Grid ColumnDefinitions="13,*,20" ColumnSpacing="7" MinHeight="19" VerticalAlignment="Center">
                    <Path Classes="stroke-ico" Width="13" Height="13" StrokeThickness="1.6"
                          VerticalAlignment="Center"
                          Data="M17 10A7 7 0 1 1 3 10A7 7 0 1 1 17 10 M15 15L22 22" />
                    <TextBox
                        Grid.Column="1"
                        Classes="shell-input"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        MinHeight="0"
                        FontSize="{DynamicResource VexDensityFontSizeCaption}"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource VexValueBrush}"
                        PlaceholderForeground="{DynamicResource VexMutedBrush}"
                        PlaceholderText="{i18n:I18n {x:Static l:VexL.OutlineFilterPlaceholder}}"
                        Text="{Binding FilterText, Mode=TwoWay}"
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OutlineFilterPlaceholder}}" />
                    <Button Grid.Column="2" Classes="wb-quiet" Width="18" Height="18" Padding="3" MinHeight="0"
                            Command="{Binding ClearFilter}"
                            helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.ClearSearch}}"
                            AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.ClearSearch}}">
                        <Path Classes="stroke-ico" Width="11" Height="11" StrokeThickness="1.6" Data="M6 6L18 18 M18 6L6 18" />
                    </Button>
                </Grid>
            </Border>
            <Border Classes="search-hover" />
        </Grid>

        <!-- 原型 .structure-list{padding:0 10px 18px;gap:1px}：列表内距与行间距都在这里给出。 -->
        <ListBox
            Grid.Row="1"
            Classes="side-list"
            Padding="10,0,10,18"
            IsVisible="{Binding HasOutlineItems}"
            ItemsSource="{Binding FilteredOutlineItems}"
            KeyDown="OutlineKeyDown"
            SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}" />
        <!-- 原型 .outline-list .empty-state（workspace-chrome.css:412-413）：8px 强调色圆点 + 文案横排居中。 -->
        <StackPanel
            Grid.Row="1"
            IsVisible="{Binding IsOutlineEmpty}"
            Margin="18"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource VexAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                       Text="{i18n:I18n {x:Static l:VexL.EmptyNoHeadings}}" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            IsVisible="{Binding IsFilterNoMatch}"
            Margin="18"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource VexAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                       Text="{i18n:I18n Vex.VexL.OutlineNoMatch}" />
        </StackPanel>
    </Grid>
</UserControl>
