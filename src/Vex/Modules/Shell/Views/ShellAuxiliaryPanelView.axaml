<UserControl x:Class="Vex.Modules.Shell.Views.ShellAuxiliaryPanelView" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:views="using:Vex.Modules.Shell.Views" x:DataType="vm:MainWindowViewModel">
 <!-- 对应原型 .structure-sidebar：头部（文档结构 + 收起钮）+ 大纲列表，无页签条。 -->
 <UserControl.Styles>
  <Style Selector="Button.outline-collapse:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="Button.outline-collapse:pointerover Path">
   <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="Button.outline-collapse:pressed /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource VexPressedBrush}"/>
  </Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,*">
  <Grid Classes="panel-head" ColumnDefinitions="*,Auto">
   <TextBlock Classes="panel-title" Text="{i18n:I18n {x:Static l:VexL.StructureTitle}}" />
   <Button x:Name="CollapseOutlineButton" Grid.Column="1" Classes="wb-quiet outline-collapse" MinHeight="0" Width="22" Height="22" Padding="3" CornerRadius="5"
           Command="{Binding Layout.ToggleOutline}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.CollapseStructure}}"
           AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.CollapseStructure}}">
    <Viewbox Width="14" Height="14">
     <Path x:Name="CollapseOutlineIcon" Classes="stroke-ico" Width="24" Height="24" Stretch="None" Data="M6 9L12 15L18 9"/>
    </Viewbox>
   </Button>
  </Grid>
  <views:ShellOutlineView Grid.Row="1" />
 </Grid>
</UserControl>
