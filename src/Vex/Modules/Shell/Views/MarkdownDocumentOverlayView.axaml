<UserControl
    x:Class="Vex.Modules.Shell.Views.MarkdownDocumentOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:md="https://codewf.com">
    <Border x:Name="DocumentCard" Classes="dialog-card" Width="620" MaxHeight="540" Padding="0" CornerRadius="9" ClipToBounds="True">
      <Grid RowDefinitions="44,*">
        <Border Padding="14,0,6,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><TextBlock x:Name="DocumentTitleText" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Click="Close_OnClick" Classes="vex-dismiss" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/></Grid>
        </Border>
        <ScrollViewer x:Name="DocumentScroll" Grid.Row="1" Padding="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="496">
          <md:MarkdownViewer x:Name="DocumentMarkdownViewer" DocumentBottomPadding="0"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <UserControl.Styles>
        <Style Selector="md|MarkdownViewer.compact-document Border.MdH2Border">
            <Setter Property="Margin" Value="0,13,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="md|MarkdownViewer.compact-document SelectableTextBlock.MdH2">
            <Setter Property="LineHeight" Value="20.8"/>
        </Style>
        <!-- 选区可读性：默认浅色选区底 + 芯片浅色文字会撞色，选中时强制深色前景。 -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionForegroundBrush" Value="#1D2129" />
        </Style>

        <!-- 排版对齐原型 .md-body：h2/h4/h6 无下划线，仅 h1 保留浅色分隔线。 -->
        <Style Selector="Border.MdHeadingBorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.MdH3Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.MdH5Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.MdH1Border">
            <Setter Property="Background" Value="{DynamicResource VexSplitterBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexSplitterBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
