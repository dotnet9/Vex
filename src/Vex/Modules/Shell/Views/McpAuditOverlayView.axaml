<UserControl
    x:Class="Vex.Modules.Shell.Views.McpAuditOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:mcp="using:Vex.Modules.Mcp.Models">
    <!-- 原型 table.vex-audit：时间/操作/结果三列，12 号字、单元格 11x6、每行一条底边线；空态是一整行「暂无调用记录」而不是居中大字。 -->
    <Border Classes="dialog-card" Width="620" MaxHeight="640">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Grid x:Name="HeaderRow" ColumnDefinitions="*,Auto">
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="15.5"
                    FontWeight="SemiBold" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Click="Refresh_OnClick"
                    MinWidth="86" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="0">
                    <Border Classes="audit-row">
                        <Grid Classes="audit-head" ColumnDefinitions="Auto,*,*" ColumnSpacing="12">
                            <TextBlock Text="{i18n:I18n {x:Static l:VexL.McpAuditTime}}" />
                            <TextBlock Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.McpAuditAction}}" />
                            <TextBlock Grid.Column="2" Text="{i18n:I18n {x:Static l:VexL.McpAuditResult}}" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="RecordsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mcp:McpOperationRecord">
                                <Border Classes="audit-row">
                                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ToolName}" TextWrapping="Wrap" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <TextBlock
                                                IsVisible="{Binding Succeeded}"
                                                Text="{i18n:I18n {x:Static l:VexL.McpAuditSuccess}}" />
                                            <TextBlock
                                                Foreground="{DynamicResource VexDangerBrush}"
                                                IsVisible="{Binding !Succeeded}"
                                                Text="{i18n:I18n {x:Static l:VexL.McpAuditFailed}}" />
                                            <TextBlock
                                                Foreground="{DynamicResource VexDangerBrush}"
                                                IsVisible="{Binding HasError}"
                                                Text="{Binding Error}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="EmptyRow" Classes="audit-row">
                        <TextBlock x:Name="EmptyTextBlock" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                x:Name="FooterRow"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Close_OnClick"
                    Content="{i18n:I18n {x:Static l:VexL.Close}}"
                    MinWidth="86" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
