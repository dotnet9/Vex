<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:u="https://irihi.tech/ursa" xmlns:core="using:Vex.Core.Messaging"
             x:Class="Vex.Modules.Shell.Views.ShellEditorOptionsView" x:DataType="vm:MainWindowViewModel" IsVisible="{Binding Workbench.ShowEditorOptions}">
  <Border Height="42" Padding="18,0" Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Workbench.IsEditing}">
        <ToggleButton Classes="wb-quiet" Content="{i18n:I18n {x:Static l:VexL.WBInstant}}" Command="{Binding Workbench.ShowInstant}" IsChecked="{Binding Workbench.IsInstantEditing, Mode=OneWay}"/>
        <ToggleButton Classes="wb-quiet" Content="{i18n:I18n {x:Static l:VexL.WBSource}}" Command="{Binding Workbench.ShowSource}" IsChecked="{Binding Workbench.IsSourceEditing, Mode=OneWay}"/>
      </StackPanel>
      <TextBlock Text="{i18n:I18n {x:Static l:VexL.WBRead}}" Classes="wb-muted" IsVisible="{Binding Workbench.IsReading}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Workbench.EditingHint}" Classes="wb-muted" VerticalAlignment="Center" IsVisible="{Binding Workbench.IsReading}" TextTrimming="CharacterEllipsis"/>
      <!-- 复用 Ursa 的溢出工具栏，窄工作区将后续操作收进更多面板。 -->
      <u:ToolBar x:Name="FormattingToolbar" Grid.Column="1" Classes="wb-formatbar" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding Workbench.IsEditing}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBFormatting}}">
        <Button x:Name="FormatBold" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Bold}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Bold}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Bold}}"><PathIcon Data="{DynamicResource SemiIconBold}"/></Button>
        <Button x:Name="FormatItalic" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Italic}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Italic}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Italic}}"><PathIcon Data="{DynamicResource SemiIconItalic}"/></Button>
        <u:ToolBarSeparator />
        <Button x:Name="FormatHeading" Classes="wb-format" Focusable="False" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBHeadings}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBHeadings}}"><PathIcon Data="{DynamicResource SemiIconH1}"/><Button.Flyout><MenuFlyout>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading1}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading1}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading2}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading2}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading3}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading3}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading4}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading4}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading5}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading5}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading6}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading6}"/>
        </MenuFlyout></Button.Flyout></Button>
        <Button x:Name="FormatQuote" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Quote}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Quote}}"><PathIcon Data="{DynamicResource SemiIconQuote}"/></Button>
        <Button x:Name="FormatUnorderedList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.UnorderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.UnorderedList}}"><PathIcon Data="{DynamicResource SemiIconList}"/></Button>
        <Button x:Name="FormatOrderedList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.OrderedList}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.OrderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OrderedList}}"><PathIcon Data="{DynamicResource SemiIconOrderedList}"/></Button>
        <Button x:Name="FormatTaskList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.TaskList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.TaskList}}"><PathIcon Data="{DynamicResource SemiIconCheckList}"/></Button>
        <u:ToolBarSeparator />
        <Button x:Name="FormatLink" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Link}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Link}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Link}}"><PathIcon Data="{DynamicResource SemiIconLink}"/></Button>
        <Button x:Name="FormatImage" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Image}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Image}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Image}}"><PathIcon Data="{DynamicResource SemiIconImage}"/></Button>
        <Button x:Name="FormatInlineCode" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.InlineCode}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.InlineCode}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.InlineCode}}"><PathIcon Data="{DynamicResource SemiIconCode}"/></Button>
        <Button x:Name="FormatCodeFence" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.CodeFence}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.CodeBlock}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.CodeBlock}}"><PathIcon Data="{DynamicResource SemiIconCodeStroked}"/></Button>
        <Button x:Name="FormatTable" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Table}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Table}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Table}}"><PathIcon Data="{DynamicResource SemiIconGridRectangle}"/></Button>
        <Button x:Name="FormatHorizontalRule" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.HorizontalRule}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.HorizontalRule}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.HorizontalRule}}"><PathIcon Data="{DynamicResource SemiIconMinus}"/></Button>
        <Button Classes="wb-format-extra" Focusable="False" u:ToolBar.OverflowMode="Always" Content="{i18n:I18n {x:Static l:VexL.Paragraph}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Paragraph}"/>
        <Button Classes="wb-format-extra" Focusable="False" u:ToolBar.OverflowMode="Always" Content="{i18n:I18n {x:Static l:VexL.MathBlock}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.MathBlock}"/>
        <Button Classes="wb-format-extra" Focusable="False" u:ToolBar.OverflowMode="Always" Content="{i18n:I18n {x:Static l:VexL.ClearFormatting}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.ClearFormatting}"/>
      </u:ToolBar>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartPresentation" Classes="wb-quiet" IsVisible="{Binding Workbench.IsReading}" Command="{Binding Workbench.StartPresentation}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentation}}"><PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconExpand}"/></Button>
        <Button x:Name="TypographyTarget" Classes="wb-quiet" Command="{Binding Workbench.ToggleTypography}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBTypography}}"/><TextBlock Text="{i18n:I18n {Binding Appearance.SelectedTypography.NameKey}}" FontWeight="SemiBold"/><TextBlock Text="⌄"/></StackPanel></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
