<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:u="https://irihi.tech/ursa" xmlns:core="using:Vex.Core.Messaging" xmlns:semiCp="using:Semi.Avalonia.ColorPicker"
             x:Class="Vex.Modules.Shell.Views.ShellEditorOptionsView" x:DataType="vm:MainWindowViewModel" IsVisible="{Binding Workbench.ShowEditorOptions}">
  <!-- 原型格式条固定 12 键、无溢出按钮：多余命令由菜单栏（公式块/分割线）与右键菜单（段落/清除格式）承载。 -->
  <Border Classes="edit-options" Classes.pinned="{Binding Workbench.Preferences.PinEditorToolbar}" Height="36" Padding="10,0" Background="{DynamicResource VexChromeBrush}" BorderBrush="{DynamicResource VexPaneHeadBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <u:ToolBar x:Name="FormattingToolbar" Classes="wb-formatbar" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding Workbench.IsEditing}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBFormatting}}">
        <Button x:Name="FormatBold" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Bold}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Bold}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Bold}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M6 4h7a4 4 0 0 1 0 8H6z M6 12h8a4 4 0 0 1 0 8H6z"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatItalic" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Italic}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Italic}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Italic}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M10 4h8 M6 20h8 M14 4l-4 16"/></Canvas></Viewbox></Button>
        <u:ToolBarSeparator />
        <Button x:Name="FormatHeading" Classes="wb-format" Focusable="False" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBHeadings}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBHeadings}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 5v14 M5 12h9 M14 5v14 M18 5v14 M18 5h2a2 2 0 0 1 2 2v2 M18 19h2a2 2 0 0 0 2-2v-2"/></Canvas></Viewbox><Button.Flyout><MenuFlyout>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading1}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading1}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading2}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading2}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading3}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading3}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading4}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading4}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading5}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading5}"/>
          <MenuItem Header="{i18n:I18n {x:Static l:VexL.Heading6}}" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading6}"/>
        </MenuFlyout></Button.Flyout></Button>
        <Button x:Name="FormatQuote" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Quote}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Quote}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 11h5v8H5z M14 11h5v8h-5z M5 11a5 5 0 0 1 5-5 M14 11a5 5 0 0 1 5-5"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatUnorderedList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.UnorderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.UnorderedList}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatOrderedList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.OrderedList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.OrderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OrderedList}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M9 6h12 M9 12h12 M9 18h12 M3 5h2v3 M3 11h2l-2 3h2 M3 17h2l-2 3h2"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatTaskList" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.TaskList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.TaskList}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3"/></Canvas></Viewbox></Button>
        <u:ToolBarSeparator />
        <Button x:Name="FormatLink" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Link}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Link}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Link}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1 M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatImage" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Image}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Image}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Image}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M9.5 9a1.5 1.5 0 1 1-3 0a1.5 1.5 0 1 1 3 0 M3 16l5-5 4 4 3-3 6 6"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatInlineCode" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.InlineCode}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.InlineCode}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.InlineCode}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M8 7l-5 5 5 5 M16 7l5 5-5 5"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatCodeFence" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.CodeFence}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.CodeBlock}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.CodeBlock}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2 M3 8h18 M9 12l-3 3 3 3 M15 12l3 3-3 3"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatTable" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Table}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Table}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Table}}"><Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M3 10h18 M3 15h18 M9 4v16 M16 4v16"/></Canvas></Viewbox></Button>
        <u:ToolBarSeparator />
        <!-- 行内样式三键（对齐原型 span-tool）：字号 / 文字颜色 / 背景颜色，面板沿用 Semi ColorView。 -->
        <Button x:Name="SpanFontSize" Classes="wb-format span-tool" Focusable="False" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanFontSize}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanFontSize}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Classes="span-glyph" Text="A"/><Path Classes="expand-chevron span-chevron" Data="M6 9L12 15L18 9"/></StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom" Opened="OnSizeFlyoutOpened">
              <WrapPanel MaxWidth="168" ItemWidth="52" x:Name="SpanSizePanel">
                <Button Classes="span-size" Tag="12" Content="12" Click="OnSpanSizeClick" />
                <Button Classes="span-size" Tag="14" Content="14" Click="OnSpanSizeClick" />
                <Button Classes="span-size" Tag="16" Content="16" Click="OnSpanSizeClick" />
                <Button Classes="span-size" Tag="18" Content="18" Click="OnSpanSizeClick" />
                <Button Classes="span-size" Tag="22" Content="22" Click="OnSpanSizeClick" />
                <Button Classes="span-size" Tag="28" Content="28" Click="OnSpanSizeClick" />
              </WrapPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpanForeground" Classes="wb-format span-tool" Focusable="False" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanForeground}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanForeground}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Classes="span-glyph fg" Text="A"/><Path Classes="expand-chevron span-chevron" Data="M6 9L12 15L18 9"/></StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom" Opened="OnSpanFlyoutOpened" Closed="OnSpanFlyoutClosed">
              <ColorView Name="SpanForegroundView" Tag="color" Width="320" Height="340"
                        >
                <ColorView.Palette>
                  <semiCp:SemiColorLightPalette />
                </ColorView.Palette>
              </ColorView>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpanBackground" Classes="wb-format span-tool" Focusable="False" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanBackground}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanBackground}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Classes="span-glyph bg" Text="A"/><Path Classes="expand-chevron span-chevron" Data="M6 9L12 15L18 9"/></StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom" Opened="OnSpanFlyoutOpened" Closed="OnSpanFlyoutClosed">
              <ColorView Name="SpanBackgroundView" Tag="background-color" Width="320" Height="340"
                        >
                <ColorView.Palette>
                  <semiCp:SemiColorLightPalette />
                </ColorView.Palette>
              </ColorView>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpanClear" Classes="wb-format" Focusable="False" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.ClearSpanStyles}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanClearStyles}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanClearStyles}}"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M4 7h16 M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2 M7 7l1 13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1l1-13"/></Canvas></Viewbox></Button>
      </u:ToolBar>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ToggleButton x:Name="PinEditor" Classes="toolbar-pin" IsChecked="{Binding Workbench.Preferences.PinEditorToolbar}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBPinToolbar}}">
          <Panel Width="17" Height="17">
            <Viewbox Classes="pin-on"><Canvas Width="24" Height="24"><Path Classes="pin-head" Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
            <Viewbox Classes="pin-off"><Canvas Width="24" Height="24"><Canvas.RenderTransform><RotateTransform Angle="45" CenterX="12" CenterY="11"/></Canvas.RenderTransform><Path Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
          </Panel>
        </ToggleButton>
        <!-- 原型：源码模式下格式条不带排版入口，改由阅读窗格头居中提供（WorkspaceViewController）。 -->
        <Button x:Name="TypographyTarget" Classes="wb-quiet typography-trigger" IsVisible="{Binding Workbench.IsInstantEditing}" Command="{Binding Workbench.ToggleTypography}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{i18n:I18n {x:Static l:VexL.Typography}}"/><TextBlock Text="{i18n:I18n {Binding Appearance.SelectedTypography.NameKey}}" FontWeight="SemiBold"/><Path Classes="expand-chevron" Data="M6 9L12 15L18 9"/></StackPanel></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
