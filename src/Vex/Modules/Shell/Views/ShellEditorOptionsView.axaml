<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels"
             x:Class="Vex.Modules.Shell.Views.ShellEditorOptionsView" x:DataType="vm:MainWindowViewModel" IsVisible="{Binding !Workbench.IsMindMap}">
  <Border Height="42" Padding="18,0" Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Workbench.IsEditing}">
        <ToggleButton Classes="wb-quiet" Content="{i18n:I18n {x:Static l:VexL.WBInstant}}" Command="{Binding Workbench.ShowInstant}" IsChecked="{Binding Workbench.IsInstantEditing, Mode=OneWay}"/>
        <ToggleButton Classes="wb-quiet" Content="{i18n:I18n {x:Static l:VexL.WBSource}}" Command="{Binding Workbench.ShowSource}" IsChecked="{Binding Workbench.IsSourceEditing, Mode=OneWay}"/>
      </StackPanel>
      <TextBlock Text="{i18n:I18n {x:Static l:VexL.WBRead}}" Classes="wb-muted" IsVisible="{Binding Workbench.IsReading}" VerticalAlignment="Center"/>
      <TextBlock x:Name="MethodHint" Grid.Column="1" Text="{Binding Workbench.EditingHint}" Classes="wb-muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <ToggleButton Classes="wb-quiet" Content="{i18n:I18n {x:Static l:VexL.PreviewPaneTitle}}" Command="{Binding Workbench.ToggleSourcePreview}" IsChecked="{Binding Workbench.SourcePreviewEnabled, Mode=OneWay}" IsVisible="{Binding Workbench.IsSourceEditing}"/>
        <Button x:Name="TypographyTarget" Classes="wb-quiet" Command="{Binding Workbench.ToggleTypography}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBTypography}}"/><TextBlock Text="{i18n:I18n {Binding Appearance.SelectedTypography.NameKey}}" FontWeight="SemiBold"/><TextBlock Text="⌄"/></StackPanel></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
