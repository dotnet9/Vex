<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:u="https://irihi.tech/ursa" xmlns:core="using:Vex.Core.Messaging" xmlns:md="using:CodeWF.Avalonia.Markdown.Editor.Controls" xmlns:vexh="using:Vex.Modules.Shell.Helpers"
             x:Class="Vex.Modules.Shell.Views.ShellEditorOptionsView" x:DataType="vm:MainWindowViewModel" IsVisible="{Binding Workbench.ShowEditorOptions}">
  <UserControl.Styles>
    <StyleInclude Source="avares://Vex/Modules/Shell/Views/ShellFormattingToolbarStyles.axaml" />
  </UserControl.Styles>
  <!-- 原型格式条为 12 个格式命令和 3 个行内样式入口；窄窗用工具条溢出菜单。 -->
  <Border Classes="edit-options" Classes.pinned="{Binding Workbench.Preferences.PinEditorToolbar}" Height="{DynamicResource VexUiHeaderHeight}" Padding="{DynamicResource VexUiHeaderPadding}" Background="{DynamicResource VexChromeBrush}" BorderBrush="{DynamicResource VexPaneHeadBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <u:ToolBar x:Name="FormattingToolbar" Classes="wb-formatbar" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding Workbench.IsEditing}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBFormatting}}">
        <Button x:Name="FormatUndo" Classes="wb-format" Command="{Binding EditorActions.Undo}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Undo}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Undo}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatRedo" Classes="wb-format" Command="{Binding EditorActions.Redo}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Redo}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Redo}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="m15 14 5-5-5-5 M20 9H9.5A5.5 5.5 0 0 0 4 14.5 5.5 5.5 0 0 0 9.5 20H13"/></Canvas></Viewbox></Button>
        <Border Classes="band-divider" />
        <Button x:Name="FormatBold" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Bold}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Bold}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Bold}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M6 4h7a4 4 0 0 1 0 8H6z M6 12h8a4 4 0 0 1 0 8H6z"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatItalic" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Italic}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Italic}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Italic}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M10 4h8 M6 20h8 M14 4l-4 16"/></Canvas></Viewbox></Button>
<Button x:Name="FormatStrikethrough" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Strikethrough}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Strikethrough}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Strikethrough}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M16 4H9a3 3 0 0 0-2.83 4 M14 12a4 4 0 0 1 0 8H6 M4 12h16"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatHighlight" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Highlight}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Highlight}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Highlight}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="m9 11-6 6v3h9l3-3 m3.4-13.6 4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4l8 8Z"/></Canvas></Viewbox></Button>
                <Border Classes="band-divider" />
        <!-- 段落结构档位（原型 band-heading select 形态）：正文 + 标题 1~6，选择即插入并复位。 -->
        <ComboBox x:Name="FormatHeading" Classes="band-heading" MinWidth="75" MinHeight="26" Height="26" FontSize="12"
                  helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBHeadings}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBHeadings}}">
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Paragraph}}" Tag="{x:Static core:EditorActionKind.Paragraph}" IsSelected="True" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading1}}" Tag="{x:Static core:EditorActionKind.Heading1}" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading2}}" Tag="{x:Static core:EditorActionKind.Heading2}" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading3}}" Tag="{x:Static core:EditorActionKind.Heading3}" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading4}}" Tag="{x:Static core:EditorActionKind.Heading4}" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading5}}" Tag="{x:Static core:EditorActionKind.Heading5}" />
          <ComboBoxItem Content="{i18n:I18n {x:Static l:VexL.Heading6}}" Tag="{x:Static core:EditorActionKind.Heading6}" />
        </ComboBox>
        <Button x:Name="FormatQuote" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Quote}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Quote}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 11h5v8H5z M14 11h5v8h-5z M5 11a5 5 0 0 1 5-5 M14 11a5 5 0 0 1 5-5"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatUnorderedList" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.UnorderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.UnorderedList}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatOrderedList" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.OrderedList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.OrderedList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.OrderedList}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M9 6h12 M9 12h12 M9 18h12 M3 5h2v3 M3 11h2l-2 3h2 M3 17h2l-2 3h2"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatTaskList" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.TaskList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.TaskList}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3"/></Canvas></Viewbox></Button>
        <Border Classes="band-divider" />
        <Button x:Name="FormatLink" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Link}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Link}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Link}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1 M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatImage" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Image}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Image}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Image}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M9.5 9a1.5 1.5 0 1 1-3 0a1.5 1.5 0 1 1 3 0 M3 16l5-5 4 4 3-3 6 6"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatInlineCode" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.InlineCode}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.InlineCode}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.InlineCode}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M8 8l-4 4 4 4 M16 8l4 4-4 4 M10 12h4"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatCodeFence" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.CodeFence}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.CodeBlock}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.CodeBlock}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2 M9 8l-4 4 4 4 M15 8l4 4-4 4"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatTable" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Table}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Table}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Table}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M3 10h18 M3 15h18 M9 4v16 M16 4v16"/></Canvas></Viewbox></Button>
<Button x:Name="FormatMathBlock" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.MathBlock}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.MathBlock}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.MathBlock}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M18 7V4H6l6 8-6 8h12v-3"/></Canvas></Viewbox></Button>
                <!-- Mermaid 图鉴：24 类分组网格（原型 dg-grid 语义），键序与 MarkdownTemplates snippet 表一致。 -->
        <Button x:Name="FormatMermaidGallery" Classes="wb-format" helpers:ToolTipHelper.Text="{i18n:I18n Vex.VexL.MenuMermaid}" AutomationProperties.Name="{i18n:I18n Vex.VexL.MenuMermaid}">
          <Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="2" Canvas.Top="8" Width="6" Height="8" RadiusX="1.5" RadiusY="1.5" Classes="format-stroke-box" /><Rectangle Canvas.Left="16" Canvas.Top="2" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Classes="format-stroke-box" /><Rectangle Canvas.Left="16" Canvas.Top="16" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Classes="format-stroke-box" /><Path Classes="format-stroke" Data="M8 12h4V5h4 M12 12v7h4"/></Canvas></Viewbox>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Transient" FlyoutPresenterClasses="dg-gallery-flyout">
              <TabControl Classes="dg-gallery-tabs" SelectionChanged="OnGalleryTabChanged">
                <TabItem Header="{i18n:I18n Vex.VexL.MermaidGroup0}">
                  <ScrollViewer Height="{DynamicResource VexUiGalleryPaneHeight}" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Classes="dg-grid" Margin="14,12,6,14">
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="flowchart"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidFlowchart}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="sequence"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidSequence}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="state"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidState}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="journey"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidJourney}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{i18n:I18n Vex.VexL.MermaidGroup1}">
                  <ScrollViewer Height="{DynamicResource VexUiGalleryPaneHeight}" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Classes="dg-grid" Margin="14,12,6,14">
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="gantt"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidGantt}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="timeline"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidTimeline}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="git"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidGit}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="kanban"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidKanban}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{i18n:I18n Vex.VexL.MermaidGroup2}">
                  <ScrollViewer Height="{DynamicResource VexUiGalleryPaneHeight}" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Classes="dg-grid" Margin="14,12,6,14">
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="class"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidClass}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="er"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidEr}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="requirement"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidRequirement}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="mindmap"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidMindmap}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="block"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidBlock}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="c4"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidC4}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="architecture"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidArchitecture}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="packet"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidPacket}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="treeview"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidTreeView}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>
                <TabItem Header="{i18n:I18n Vex.VexL.MermaidGroup3}">
                  <ScrollViewer Height="{DynamicResource VexUiGalleryPaneHeight}" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Classes="dg-grid" Margin="14,12,6,14">
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="pie"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidPie}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="quadrant"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidQuadrant}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="xy"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidXy}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="sankey"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidSankey}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="radar"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidRadar}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="treemap"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidTreemap}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                      <Button Classes="dg-card" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="venn"><StackPanel Spacing="6" HorizontalAlignment="Stretch"><Border Classes="dg-thumb" Height="120"><Image Stretch="Uniform" MaxHeight="116"/></Border><TextBlock Text="{i18n:I18n Vex.VexL.MermaidVenn}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                  </ScrollViewer>
                </TabItem>
              </TabControl>
            </Flyout>
          </Button.Flyout>
        </Button>
<Button x:Name="FormatHorizontalRule" Classes="wb-format" Command="{Binding EditorActions.InsertAction}" CommandParameter="{x:Static core:EditorActionKind.HorizontalRule}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.HorizontalRule}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.HorizontalRule}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M4 12h16 M4 7h9 M15 17h5"/></Canvas></Viewbox></Button>
        <Button x:Name="FormatFootnote" Classes="wb-format" Command="{Binding EditorActions.InsertSnippet}" CommandParameter="footnote" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Footnote}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Footnote}}"><Viewbox Width="{DynamicResource VexUiFormatIconSize}" Height="{DynamicResource VexUiFormatIconSize}"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 15h8 M12 12v6"/></Canvas></Viewbox></Button>
        <Border Classes="band-divider" />
        <!-- 行内样式三键（对齐原型 span-tool）：字号 / 文字颜色 / 背景颜色，复用库侧样式面板。 -->
        <Button x:Name="SpanFontSize" Classes="wb-format span-tool" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanFontSize}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanFontSize}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Classes="span-glyph" Text="A"/><Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M6 9l6 6 6-6"/></Canvas></Viewbox></StackPanel>
          <Button.Flyout>
            <md:MarkdownSpanStyleFlyout Placement="Bottom">
              <md:MarkdownSpanStylePicker DataContext="{Binding EditorActions.SpanFontSize}"/>
            </md:MarkdownSpanStyleFlyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpanForeground" Classes="wb-format span-tool" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanForeground}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanForeground}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Classes="span-glyph fg" Text="A"/><Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M6 9l6 6 6-6"/></Canvas></Viewbox></StackPanel>
          <Button.Flyout>
            <md:MarkdownSpanStyleFlyout Placement="Bottom">
              <md:MarkdownSpanStylePicker DataContext="{Binding EditorActions.SpanForeground}"/>
            </md:MarkdownSpanStyleFlyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpanBackground" Classes="wb-format span-tool" Margin="0" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.SpanBackground}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SpanBackground}}">
          <StackPanel Orientation="Horizontal" Spacing="2"><Border Classes="span-background" Padding="3,1" CornerRadius="3" Background="{DynamicResource VexMarkBackgroundBrush}"><TextBlock Classes="span-glyph bg" Text="A"/></Border><Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Classes="format-stroke" Data="M6 9l6 6 6-6"/></Canvas></Viewbox></StackPanel>
          <Button.Flyout>
            <md:MarkdownSpanStyleFlyout Placement="Bottom">
              <md:MarkdownSpanStylePicker DataContext="{Binding EditorActions.SpanBackground}"/>
            </md:MarkdownSpanStyleFlyout>
          </Button.Flyout>
        </Button>
      </u:ToolBar>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ToggleButton x:Name="PinEditor" Classes="toolbar-pin" IsChecked="{Binding Workbench.Preferences.PinEditorToolbar}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBPinToolbar}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPinToolbar}}">
          <Panel Width="17" Height="17">
            <Viewbox Classes="pin-on"><Canvas Width="24" Height="24"><Path Classes="pin-head" Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
            <Viewbox Classes="pin-off"><Canvas Width="24" Height="24"><Canvas.RenderTransform><RotateTransform Angle="45" CenterX="12" CenterY="11"/></Canvas.RenderTransform><Path Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
          </Panel>
        </ToggleButton>
        <!-- 原型：源码模式下格式条不带排版入口，改由阅读窗格头居中提供（WorkspaceViewController）。
             紧凑 chip（省去当前排版名）：instant 行内 22 键格式带 + 本触发器在 1280 宽必须同排放得下。 -->
        <Button x:Name="TypographyTarget" Classes="wb-quiet typography-trigger" IsVisible="{Binding Workbench.IsInstantEditing}" Command="{Binding Workbench.ToggleTypography}" helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBTypography}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBTypography}}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{i18n:I18n {x:Static l:VexL.Typography}}"/><Path Classes="expand-chevron" Data="M6 9L12 15L18 9"/></StackPanel></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
