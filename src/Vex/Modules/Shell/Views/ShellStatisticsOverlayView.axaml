<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellStatisticsOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellDocumentInfoViewModel">
    <Border Classes="dialog-card" Width="480" MaxHeight="560" Padding="0" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border Height="36" Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <Grid ColumnDefinitions="*,46" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{i18n:I18n Vex.VexL.StatisticsTitle}"/>
                    <Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Click="Close_OnClick" AutomationProperties.Name="{i18n:I18n Vex.VexL.Close}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- 核心指标卡：词数 / 字符大数字（对应原型 stat-card，tabular-nums 防跳动） -->
                    <Grid ColumnDefinitions="*,10,*" Margin="24,18,24,4">
                        <Border
                            Padding="14 12 14 10"
                            Background="{DynamicResource TextBlockCodeBackground}"
                            BorderBrush="{DynamicResource VexPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource VexAccentBrush}"
                                    Text="{Binding Statistics.Words}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Classes="muted"
                                    FontSize="11"
                                    Text="{i18n:I18n {x:Static l:VexL.StatusWords}}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="14 12 14 10"
                            Background="{DynamicResource TextBlockCodeBackground}"
                            BorderBrush="{DynamicResource VexPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource VexAccentBrush}"
                                    Text="{Binding Statistics.Characters}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Classes="muted"
                                    FontSize="11"
                                    Text="{i18n:I18n {x:Static l:VexL.StatusCharacters}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
<Grid Grid.Row="1" Margin="24,12,24,20" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="22">
<Border Grid.Row="0" Grid.Column="0" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatisticsLines}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Statistics.Lines}"/></Grid></Border>
<Border Grid.Row="0" Grid.Column="1" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatisticsParagraphs}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Statistics.Paragraphs}"/></Grid></Border>
<Border Grid.Row="1" Grid.Column="0" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatisticsHeadings}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Statistics.Headings}"/></Grid></Border>
<Border Grid.Row="1" Grid.Column="1" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatisticsReading}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding ReadingMinutesText}"/></Grid></Border>
<Border Grid.Row="2" Grid.Column="0" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatusEncoding}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding CurrentEncodingText}"/></Grid></Border>
<Border Grid.Row="2" Grid.Column="1" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexSplitterBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="12" Classes="muted" Text="{i18n:I18n Vex.VexL.StatusState}"/><SelectableTextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding DocumentStateText}"/></Grid></Border>
</Grid>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
