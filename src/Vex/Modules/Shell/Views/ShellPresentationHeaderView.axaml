<UserControl x:Class="Vex.Modules.Shell.Views.ShellPresentationHeaderView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:codewf="https://codewf.com"
    xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
    xmlns:shell="using:Vex.Modules.Shell.Views" xmlns:vex="clr-namespace:Vex.Controls"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:MainWindowViewModel">
    <Border x:Name="PresentationHeader" Classes="deck-header" IsVisible="{Binding Workbench.IsPresenting}">
        <Grid ColumnDefinitions="*,Auto" Margin="10,0">
            <TextBlock Text="{Binding DocumentInfo.CurrentDocumentName}" FontSize="13" VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" Foreground="{DynamicResource VexValueBrush}" />
            <Button x:Name="PresentationExit" Grid.Column="1" Classes="deck-exit"
                Command="{Binding Workbench.StopPresentation}"
                helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}"
                AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}">
                <Path Data="{StaticResource WBCloseIcon}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
