<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellRenameDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellRenameDialogViewModel">
    <Border Classes="dialog-card" Width="430">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="dlg-ico info">
                    <Path Classes="stroke-ico" Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBlockDefaultForeground}"
                    Text="{i18n:I18n {x:Static l:VexL.RenameFileTitle}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.RenameFileNameLabel}}" />
                <TextBox
                    x:Name="NameTextBox"
                    Grid.Row="1"
                    KeyDown="NameTextBox_OnKeyDown"
                    PlaceholderText="{i18n:I18n {x:Static l:VexL.RenameFileNameLabel}}"
                    Text="{Binding FileName, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="{DynamicResource VexDangerBrush}"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding Error}" />
            </Grid>
            <Border Grid.Row="2" Classes="dlg-path">
                <SelectableTextBlock Text="{Binding Path}" />
            </Border>
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="OnCancelClicked"
                    Content="{i18n:I18n {x:Static l:VexL.Cancel}}"
                    MinWidth="86" />
                <Button
                    Classes="primary"
                    Click="OnConfirmClicked"
                    Content="{i18n:I18n {x:Static l:VexL.Rename}}"
                    MinWidth="86" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
