<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellRenameDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellRenameDialogViewModel">
    <Border Classes="dialog-card" Width="480" Padding="0" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="36,Auto">
            <Border Height="36" Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <Grid ColumnDefinitions="*,46" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{i18n:I18n Vex.VexL.RenameFileTitle}"/>
                    <Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Click="OnCancelClicked" AutomationProperties.Name="{i18n:I18n Vex.VexL.Close}"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="22">
                <TextBlock Classes="muted" FontSize="12" Margin="0,14,0,6" Text="{i18n:I18n Vex.VexL.RenameFileNameLabel}"/>
                <!-- 原型 .input mono（theme.css:247 + refinement.css:30）：32 高、14 号等宽、pill 外形，
                     焦点配方与侧栏搜索/查找条同一套 search-shell（accent 边 + 3px 柔光、悬停混边）。 -->
                <Grid Classes="search-shell" Height="32">
                    <Border Classes="search-glow"/>
                    <Border Classes="search-frame" Padding="10,0">
                        <TextBox
                            x:Name="NameTextBox"
                            Classes="mono shell-input"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            KeyDown="NameTextBox_OnKeyDown"
                            MinHeight="0"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Text="{Binding FileName, Mode=TwoWay}"/>
                    </Border>
                    <Border Classes="search-hover"/>
                </Grid>
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource VexDangerBrush}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Error}" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4" Text="{i18n:I18n Vex.VexL.RenameFilePathLabel}"/>
                <Border Classes="dlg-path"><SelectableTextBlock Text="{Binding Path}" TextWrapping="Wrap"/></Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Click="OnCancelClicked" Content="{i18n:I18n Vex.VexL.Cancel}"/>
                    <Button Classes="primary" Click="OnConfirmClicked" Content="{i18n:I18n Vex.VexL.Rename}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
