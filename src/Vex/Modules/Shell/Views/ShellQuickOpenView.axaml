<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellQuickOpenView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellQuickOpenViewModel">
    <Border Classes="dialog-card" Width="620" MaxHeight="520">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <!-- 快速打开也是搜索输入：与侧栏搜索/查找/重命名同一套 search-shell 焦点配方（原型 .input）。 -->
            <Grid Classes="search-shell" Height="32">
                <Border Classes="search-glow"/>
                <Border Classes="search-frame" Padding="10,0">
                    <TextBox
                        x:Name="QueryBox"
                        Classes="shell-input"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        KeyDown="QueryBox_OnKeyDown"
                        MinHeight="0"
                        PlaceholderText="{Binding Placeholder}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Text="{Binding Query, Mode=TwoWay}"/>
                </Border>
                <Border Classes="search-hover"/>
            </Grid>

            <ScrollViewer Grid.Row="1" MinHeight="120">
                <StackPanel Spacing="2">
                    <TextBlock Classes="muted" IsVisible="{Binding IsLoading}" Text="{i18n:I18n {x:Static l:VexL.SidebarFilesLoading}}" />
                    <TextBlock Classes="muted" IsVisible="{Binding HasLoadError}" Text="{Binding LoadError}" />
                    <TextBlock
                        Classes="muted"
                        HorizontalAlignment="Center"
                        Margin="0 18 0 0"
                        Text="{i18n:I18n {x:Static l:VexL.QuickOpenEmpty}}"
                        IsVisible="{Binding IsEmpty}" />
                    <ListBox
                        x:Name="ResultsList"
                        ItemsSource="{Binding Items}"
                        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                        DoubleTapped="Results_OnDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickOpenItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="muted"
                                        FontSize="11"
                                        Text="{Binding LocationText}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Cancel_OnClick"
                    Content="{i18n:I18n {x:Static l:VexL.Cancel}}"
                    MinWidth="86" />
                <Button
                    Classes="primary"
                    Click="Open_OnClick"
                    Content="{i18n:I18n {x:Static l:VexL.OpenFile}}"
                    MinWidth="86" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
