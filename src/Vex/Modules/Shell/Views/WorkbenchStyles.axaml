<Styles xmlns:ctl="clr-namespace:CodeWF.Avalonia.Controls.Controls;assembly=CodeWF.Avalonia.Controls" xmlns:motion="using:CodeWF.Avalonia.Controls.Animations" xmlns:anim="using:Avalonia.Animation.Easings" xmlns:u="https://irihi.tech/ursa" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===== 块状工作区（原型 workspace-chrome.css）：灰画布 + 圆角描边白块，外缘 10px、块间 4px ===== -->
  <Style Selector="Border.workspace-block">
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <!-- 原型 block-shadow：0 1px 3px fg 5%。 -->
    <Setter Property="BoxShadow" Value="0 1 3 0 #0D000000" />
  </Style>
  <!-- 原型 .pane-collapse：折叠钮从状态栏迁到块角，24px 圆形带箭头；展开时贴在所属块的内侧下角，
       折叠时贴到画布同侧窗边（列宽归零，按钮溢出到 0 宽单元格即窗边），箭头指向面板收起的方向。 -->
  <Style Selector="Button.pane-collapse">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="ZIndex" Value="36" />
  </Style>
  <!-- 原型 box-shadow：0 1px 4px fg 14%（Button 无 BoxShadow，投在模板 ContentPresenter 上）。 -->
  <Style Selector="Button.pane-collapse /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 1 4 0 #24000000" />
  </Style>
  <Style Selector="Button.pane-collapse:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}" />
  </Style>
  <Style Selector="Button.pane-collapse Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <!-- 基础朝向 = 右（收起左栏后指向展开方向）。 -->
    <Setter Property="Data" Value="M4.5 2L8.5 6L4.5 10" />
  </Style>
  <Style Selector="Button.pane-collapse:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" /></Style>
  <!-- 箭头朝向：左栏展开朝左（收起方向）、折叠朝右；右栏相反。横向落点由 Layout 的块宽算出的外边距决定。 -->
  <Style Selector="Button.pane-collapse.left.on Path"><Setter Property="Data" Value="M7.5 2L3.5 6L7.5 10" /></Style>
  <Style Selector="Button.pane-collapse.right:not(.on) Path"><Setter Property="Data" Value="M7.5 2L3.5 6L7.5 10" /></Style>
  <!-- 分栏把手本体即 4px 间隙，负外边距把命中区扩到 12px；悬停、键盘聚焦或拖动时显出握柄（原型 :hover/:focus-visible/.split-resizing）。 -->
  <Style Selector="GridSplitter.workspace-gap">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="Grip" Opacity="0" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource VexSplitterBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.workspace-gap:pointerover /template/ Border#Grip, GridSplitter.workspace-gap:pressed /template/ Border#Grip, GridSplitter.workspace-gap:focus-visible /template/ Border#Grip">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="GridSplitter.gap-horizontal">
    <Setter Property="Margin" Value="-4,0" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="GridSplitter.gap-horizontal /template/ Border#Grip">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="38" />
  </Style>
  <Style Selector="GridSplitter.gap-vertical">
    <Setter Property="Margin" Value="0,-4" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>
  <Style Selector="GridSplitter.gap-vertical /template/ Border#Grip">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="3" />
  </Style>
  <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, Border.dialog-card, Border.wb-popover">
    <Setter Property="motion:EntranceMotion.IsEnabled" Value="True"/>
    <Setter Property="motion:EntranceMotion.Animate" Value="{DynamicResource VexMotionEnabled}"/>
    <Setter Property="motion:EntranceMotion.Duration" Value="{DynamicResource MotionDurationFast}"/>
    <Setter Property="motion:EntranceMotion.Easing"><anim:SplineEasing X1=".2" Y1=".8" X2=".2" Y2="1"/></Setter>
  </Style>
  <!-- 原型所有弹出层为面板白（随主题明暗）：Flyout/MenuFlyout 统一面板底。 -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource VexElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter, Border.wb-popover">
    <Setter Property="motion:EntranceMotion.OffsetY" Value="-4"/>
    <Setter Property="motion:EntranceMotion.InitialScale" Value=".985"/>
  </Style>
  <Style Selector="Border.dialog-card">
    <Setter Property="motion:EntranceMotion.Duration" Value="{DynamicResource MotionDurationMid}"/>
    <Setter Property="motion:EntranceMotion.OffsetY" Value="9"/>
    <Setter Property="motion:EntranceMotion.InitialScale" Value=".99"/>
  </Style>
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
    <Setter Property="motion:EntranceMotion.IsEnabled" Value="True"/>
    <Setter Property="motion:EntranceMotion.Animate" Value="{DynamicResource VexMotionEnabled}"/>
    <Setter Property="motion:EntranceMotion.Duration" Value="{DynamicResource MotionDurationFast}"/>
    <Setter Property="motion:EntranceMotion.Easing"><anim:SplineEasing X1=".2" Y1=".8" X2=".2" Y2="1"/></Setter>
  </Style>
  <Style Selector="FlyoutPresenter, Border.wb-popover"><Setter Property="RenderTransformOrigin" Value="0%,0%"/></Style>
  <Styles.Resources>
    <StreamGeometry x:Key="WBSidebarIcon">M3 3H21V21H3Z M9 3V21</StreamGeometry>
    <StreamGeometry x:Key="WBEditIcon">M11 4H4V20H20V13 M18 2L22 6L12 16L8 17L9 13Z</StreamGeometry>
    <StreamGeometry x:Key="WBReadIcon">M2 12C7 3 17 3 22 12C17 21 7 21 2 12Z M15 12A3 3 0 1 1 9 12A3 3 0 1 1 15 12</StreamGeometry>
    <StreamGeometry x:Key="WBMapIcon">M2 9H8V15H2Z M16 2H22V8H16Z M16 16H22V22H16Z M8 12H12V5H16 M12 12V19H16</StreamGeometry>
    <StreamGeometry x:Key="WBSearchIcon">M17 10A7 7 0 1 1 3 10A7 7 0 1 1 17 10 M15 15L22 22</StreamGeometry>
    <StreamGeometry x:Key="WBSaveIcon">M3 3H17L21 7V21H3Z M7 3V9H16V3 M7 21V14H17V21</StreamGeometry>
    <StreamGeometry x:Key="WBFitIcon">M3 9V3H9 M15 3H21V9 M21 15V21H15 M9 21H3V15 M8 8H16V16H8Z</StreamGeometry>
    <StreamGeometry x:Key="WBColumnsIcon">M3 3H21V21H3Z M12 3V21</StreamGeometry>
    <StreamGeometry x:Key="WBCloseIcon">M6 6L18 18 M18 6L6 18</StreamGeometry>
    <StreamGeometry x:Key="WBGearIcon">M15 12A3 3 0 1 1 9 12A3 3 0 1 1 15 12 M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.09a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.09a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z</StreamGeometry>
  </Styles.Resources>
  <!-- 原型 .exit-dialog-actions .btn（非 primary）：面板底 + 1px #E2E2E4 细边 + 前景文字；
       Semi 主题模板 ContentPresenter 会覆盖按钮本地值，必须走 /template/ 选择器。 -->
  <Style Selector="Button.dialog-secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/>
  </Style>
  <Style Selector="Button.dialog-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/>
  </Style>
  <Style Selector="Button.selected-choice /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/>
  </Style>
  <Style Selector="FlyoutPresenter.design-title-picker"><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <!-- 分段控件的通用画法（轨道底色、指示块浮起、三态透明、选中字色字重）在库的
      Themes/Styles/SegmentedPanel.axaml；这里只补 Vex 自己那半：圆角与字号跟密度/圆角档走
      （直角档 999×0 归零，胶囊要跟着塌），深色轨道反差小再叠 1px 淡描边。
      指示块圆角只能设在面板上——它由面板写进 Border 的本地值，样式命中 Border 会被本地值压掉。 -->
  <Style Selector="ctl|SegmentedPanel">
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}"/>
  </Style>
  <Style Selector="Border.segmented-track">
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}"/>
    <!-- 原型 .vex-segmented 的 seg-inset 是 pad-sm 的一半（4/6/8 → 2/3/4），库里的 3 只是标准档默认值。 -->
    <Setter Property="Padding" Value="{DynamicResource VexSegmentedInset}"/>
  </Style>
  <Style Selector="ctl|SegmentedPanel > Border.segmented-thumb">
    <Setter Property="BorderBrush" Value="{DynamicResource VexSegmentedThumbBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- 原型 segmented.css:8 + prototype.css:25：浅色用 1px 4px 墨投影浮起，深色把投影换成 1px 淡环。
         投影是字符串常量换不了色，由 ElevationResources 按明暗变体回放成资源，这里只负责取。 -->
    <Setter Property="BoxShadow" Value="{DynamicResource VexSegmentedThumbShadow}"/>
    <!-- 原型的时长挂在 vex-motion 乘算上（prototype.css:5,8）：「界面动效」精简档 ×0.35、关闭档 ×0，
         库里写死的 260/140 只等于标准档，这里按动效令牌重放一遍同一组过渡。 -->
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="{DynamicResource MotionDurationSlow}">
          <DoubleTransition.Easing><anim:SplineEasing X1="0.2" Y1="0.8" X2="0.2" Y2="1"/></DoubleTransition.Easing>
        </DoubleTransition>
        <ThicknessTransition Property="Margin" Duration="{DynamicResource MotionDurationSlow}">
          <ThicknessTransition.Easing><anim:SplineEasing X1="0.2" Y1="0.8" X2="0.2" Y2="1"/></ThicknessTransition.Easing>
        </ThicknessTransition>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="LinearEasing"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ctl|SegmentedPanel Button">
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeCaption}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}"/>
  </Style>
  <!-- 原型 .density-options.vex-segmented（外观菜单 22×密度、排版面板 24×密度，内距 2×密度/10）：
       界面密度与渲染密度两行都是标准分段控件，底色、指示块、选中字色一律走库的共享配方。 -->
  <Style Selector="Button.density-pill">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="{DynamicResource VexSegmentedHeightDensity}"/>
    <Setter Property="Padding" Value="{DynamicResource VexSegmentedPaddingDensity}"/>
  </Style>
  <Style Selector="Button.render-density-pill">
    <Setter Property="Height" Value="{DynamicResource VexSegmentedHeightRenderDensity}"/>
  </Style>
  <!-- 原型 .map-step-label（appearance.css:26-31）：①/② 圆徽 + 13/600 段名 + 11px 灰字提示，段名与徽标间距 7。
       .nudge 只染段名，是「选完结构把视线引到第二排」的一次性提示，900ms 后由宿主撤类回落。 -->
  <Style Selector="Border.map-step-badge">
    <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
    <Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.map-step-badge-text">
    <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.map-step-text">
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeBodySm}"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style Selector="StackPanel.map-step-nudge > TextBlock.map-step-text">
    <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.map-step-hint">
    <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <!-- 原型 .map-appearance-popover（appearance.css:23）：528 宽弹层，16 内距、8 圆角、1px 描边。 -->
  <Style Selector="FlyoutPresenter.map-appearance-popover">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <!-- 原型 .map-choice：最小高 136、内距 9、6 圆角、1px 边框、面板底；悬停边框转强调色；
       选中 = 强调色边框 + inset 1px 强调环 + accent-soft 底（appearance.css:28-31）。 -->
  <Style Selector="Button.map-choice">
    <Setter Property="MinHeight" Value="136"/><Setter Property="Padding" Value="9"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusSm}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.map-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <!-- 原型选中态是 1px 强调边框 + inset 1px 强调环（合计 2px 强调描边）；Avalonia 无 inset 环，用 2px 边框等效。 -->
  <Style Selector="Button.map-choice-on">
    <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
  </Style>
  <!-- 原型 .map-miniature：宽 100%、高 88 的等比缩略线稿。 -->
  <Style Selector="Border.map-choice-mini">
    <Setter Property="Height" Value="88"/><Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <!-- 原型 .map-choice strong：13px / 500 / 20 行高，距线稿 8。 -->
  <Style Selector="TextBlock.map-choice-label">
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeBodySm}"/>
    <Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="20"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
  <!-- 原型 .map-choice-purpose：11/16 灰字紧跟段名，解释这张卡和隔壁那张差在哪。 -->
  <Style Selector="TextBlock.map-choice-purpose">
    <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <!-- 原型最新（workspace-chrome）：卡片去边框、灰阶表面 + 轻阴影，选中 accent 环。 -->
  <Style Selector="Button.palette-card">
    <Setter Property="Padding" Value="7"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
  </Style>
  <Style Selector="Button.palette-card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 1 5 0 #0D000000"/>
  </Style>
  <!-- 原型选中态：border-color:transparent + box-shadow 0 0 0 1.5px accent；阴影色随配色变化，由代码按 VexAccentBrush 回放。 -->
  <Style Selector="Button.palette-card-on">
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.palette-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/>
  </Style>
  <!-- 排版卡（原型 workspace-chrome.css #typography-panel .typography-card）：无框、panel 底、vex-radius-lg 圆角，
       投影取 fg 5%（悬停 7%），随明暗变体换成微光，所以走 ElevationResources 回放的应用级资源。 -->
  <!-- Button 自己没有 BoxShadow，投影要落到模板里的 ContentPresenter。 -->
  <Style Selector="Button.typography-card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource VexTypographyCardShadow}"/>
  </Style>
  <Style Selector="Button.typography-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource VexTypographyCardHoverShadow}"/>
  </Style>
  <Style Selector="Button.palette-add-card">
    <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <Style Selector="Button.palette-add-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <!-- 原型 .studio-language 行：透明底、hover 灰底，选中着色由代码按主题画刷回放。 -->
  <Style Selector="Button.language-item">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.language-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/>
  </Style>
  <!-- 原型 aria-checked 行：accent-soft 底色，文字/徽标强调色由代码回放。 -->
  <Style Selector="Button.language-item-on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
  </Style>
  <!-- 原型 #vex-appearance-menu[open]>summary：弹出层打开时外观按钮呈选中态。 -->
  <Style Selector="Button.title-picker-open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="FlyoutPresenter.design-language-picker"><Setter Property="Padding" Value="5"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/></Style>
  <!-- 状态栏的视图切换在原型里就是一枚 .workspace-viewswitch.vex-segmented（workspace.js:84），
       轨道底色、内缩、滑动指示块、选中字色字重全部由上面的共享配方给，宿主自己的基准高与图标口径
       在 ShellStatusBarView.axaml；这里不再重复画一份遗留胶囊样式。 -->
  <!-- 原型 .vex-deck header：与正常标题条同高（令牌 app-titlebar-height 33px），面板底色 + 1px 底边描线。 -->
  <Style Selector="Border.deck-header">
    <Setter Property="Height" Value="33"/><Setter Property="MinHeight" Value="33"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <!-- 原型 .vex-deck header button：高 25、内距 2/8，悬停转轨道色与主题色。 -->
  <Style Selector="Button.deck-exit">
    <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="25"/>
    <Setter Property="Padding" Value="2,8"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusSm}"/>
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.deck-exit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <!-- 关闭钮的 12px 描线叉：静音色，悬停转主题色（与折叠钮同一套描线口径）。 -->
  <Style Selector="Button.deck-exit Path">
    <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="Button.deck-exit:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/></Style>
  <!-- 原型 .deck-modes：接全站 .vex-segmented 分段胶囊（轨道底色、圆角、内缩、滑动指示块都由共享配方给），
       宿主只补悬浮层自己的 1px 描边与浮空投影，外加 26×密度的基准几何。 -->
  <Style Selector="Border.deck-modes">
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource VexPopShadow}"/>
  </Style>
  <!-- 原型 .deck-modes>button：与状态栏同一档 26×密度高、3×密度/14 内距、12px 静音文字。 -->
  <Style Selector="Button.deck-segment">
    <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="{DynamicResource VexSegmentedHeightView}"/>
    <Setter Property="Padding" Value="{DynamicResource VexSegmentedPaddingView}"/>
  </Style>
  <!-- 原型 .deck-outline-toggle：24px 圆钮、块面底 + 混合描边 + 轻投影；收起态雪佛龙 scaleX(-1) 指向左侧。 -->
  <Style Selector="Button.deck-outline-toggle">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.deck-outline-toggle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 1 4 #24000000"/>
  </Style>
  <Style Selector="Button.deck-outline-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/>
  </Style>
  <Style Selector="Button.deck-outline-toggle Path">
    <Setter Property="Data" Value="M9 5L16 12L9 19"/>
    <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}"/><Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="-1"/></Setter.Value></Setter>
  </Style>
  <Style Selector="Button.deck-outline-toggle.on Path">
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1"/></Setter.Value></Setter>
  </Style>
  <Style Selector="Button.deck-outline-toggle:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/></Style>
  <!-- 原型 .vex-deck nav button：44px 行高、整列宽、单行省略；当前页 accent-soft 底 + 主题色。 -->
  <Style Selector="Button.deck-nav-row">
    <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.deck-nav-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="Button.statusbar-file">
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeCaption}"/>
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusSm}"/>
    <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.statusbar-quiet">
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeCaption}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <Style Selector="Button.statusbar-quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/>
  </Style>
  <Style Selector="Border.choice-filter"><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/><Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/></Style>
  <Style Selector="Button.choice-filter-selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource VexPanelBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BoxShadow" Value="0 1 3 0 #12000000"/></Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/></Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/></Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="ListBox.preferences-navigation ListBoxItem:selected Path"><Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/></Style>
  <!-- 原型 .vex-pref-segmented（prototype.css:214 起）：偏好行右侧 196 等宽分段，轨道/指示块走共享配方，
       这里只补段高（control-h-sm）、内距（4×密度/6）与正文减 1 号字。 -->
  <Style Selector="Button.pref-segment">
    <Setter Property="MinHeight" Value="{DynamicResource VexDensityControlHeightSm}"/>
    <Setter Property="Padding" Value="{DynamicResource VexSegmentedPaddingPref}"/>
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeBodySm}"/>
  </Style>
  <!-- 原型 .vex-pref-row input[type=checkbox]：34x20 轨道、14 圆钮、选中 accent -->
  <Style Selector="ToggleButton.pref-switch">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SwitchTrack" Width="34" Height="20" CornerRadius="{DynamicResource VexDensityCornerRadiusPill}" Background="{DynamicResource VexPanelBorderBrush}">
          <Border.Transitions>
            <Transitions><BrushTransition Property="Background" Duration="{DynamicResource MotionDurationMid}"/></Transitions>
          </Border.Transitions>
          <Ellipse Name="SwitchKnob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3" Fill="White">
            <Ellipse.Effect><DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Opacity="0.13"/></Ellipse.Effect>
            <Ellipse.Transitions>
              <Transitions><ThicknessTransition Property="Margin" Duration="{DynamicResource MotionDurationMid}"/></Transitions>
            </Ellipse.Transitions>
          </Ellipse>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.pref-switch:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource VexAccentBrush}"/></Style>
  <Style Selector="ToggleButton.pref-switch:checked /template/ Ellipse#SwitchKnob"><Setter Property="Margin" Value="17,3,3,3"/></Style>
  <Style Selector="Path.wb-icon">
    <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="Button.wb-quiet, ToggleButton.wb-quiet">
    <Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <!-- 原型 .typography-trigger（view-heading 内的排版入口）：12px 字、6/10 内距、30 高基准，
       排版弹层的落点由它推导（弹层顶 = 该按钮底边 + 8），所以高度口径必须与原型一致。 -->
  <Style Selector="Button.typography-trigger">
    <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <!-- 对应原型标题栏 .studio-title-controls button：30×28、4px 圆角、透明底。 -->
  <Style Selector="Button.tb-icon">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.tb-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/>
  </Style>
  <Style Selector="Button.wb-quiet:pointerover, ToggleButton.wb-quiet:pointerover"><Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/></Style>
  <Style Selector="ToggleButton.wb-quiet:checked"><Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/></Style>
  <!-- Semi 在模板层设置交互颜色，这里同步轻量切换按钮的实际呈现状态。 -->
  <Style Selector="ToggleButton.wb-quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.wb-quiet:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-quiet:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-quiet:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.wb-view">
    <Setter Property="Width" Value="86"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <Style Selector="ToggleButton.wb-view:checked"><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="ToggleButton.wb-view:checked Path.wb-icon"><Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/></Style>
  <Style Selector="ToggleButton.wb-view:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-view:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.wb-view:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-view:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.wb-view:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.wb-popover">
    <Setter Property="Background" Value="{DynamicResource VexElevatedBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BoxShadow" Value="0 8 30 0 #18000000"/>
  </Style>
  <!-- flat 变体：无投影（原型 .typography-popover 即无投影；白纸之上投影会读成脏角）。 -->
  <Style Selector="Border.wb-popover.flat">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
  </Style>
  <Style Selector="TextBlock.wb-muted"><Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/><Setter Property="FontSize" Value="11.5"/></Style>
  <Style Selector="Border.pane-head"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="20,0"/></Style>
  <Style Selector="Border.kbd-chip"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBox.typography-grid"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style Selector="ListBox.typography-grid ListBoxItem"><Setter Property="Width" Value="98"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style Selector="ListBox.typography-grid ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style Selector="Border.typography-card"><Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/></Style>
  <Style Selector="ListBox.typography-grid ListBoxItem:selected Border.typography-card"><Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}"/><Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/></Style>
  <Style Selector="Button.wb-format">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/><Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="Button.wb-format PathIcon"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/></Style>
  <Style Selector="Path.format-stroke"><Setter Property="Stroke" Value="{DynamicResource VexValueBrush}"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
  <Style Selector="Border.presentation-tools"><Setter Property="Opacity" Value="0.75"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}"/></Transitions></Setter></Style>
  <Style Selector="Border.presentation-tools:pointerover, Border.presentation-tools:focus-within"><Setter Property="Opacity" Value="1"/></Style>
  <!-- 对应原型 #edit-options：静默 1%，悬停或聚焦后立即显现，离开 2 秒后淡出。 -->
  <Style Selector="Border.edit-options">
    <Setter Property="Opacity" Value="0.01"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Delay="0:0:2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.edit-options:pointerover">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.edit-options:focus-within">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions>
    </Setter>
  </Style>

  <!-- ===== 悬浮工具条「钉住」（对应原型 data-pin-*）：钉住=占位常驻；取消钉住=悬浮静默、悬停/聚焦显现。 ===== -->
  <Style Selector="Border.edit-options.pinned">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pane-head.floating, Border.map-topbar.floating">
    <Setter Property="Opacity" Value="0.01"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25" Delay="0:0:2"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pane-head.floating:pointerover, Border.pane-head.floating:focus-within, Border.map-topbar.floating:pointerover, Border.map-topbar.floating:focus-within">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions>
    </Setter>
  </Style>

  <!-- 图钉双态：钉住=竖直实心图钉；取消钉住=45° 空心并整体淡化。 -->
  <Style Selector="ToggleButton.toolbar-pin">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:not(:checked)">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin Path">
    <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin Path.pin-head">
    <Setter Property="Fill" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="StrokeThickness" Value="0"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:pointerover Path.pin-head">
    <Setter Property="Fill" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:checked Viewbox.pin-off">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ToggleButton.toolbar-pin:not(:checked) Viewbox.pin-on">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- 原型偏好滑块是浏览器 range+accent-color 观感：已选段实心强调色。
       Semi Slider 模板的填充段取 Foreground、未选段取 Background，直接覆这两个画刷即可，
       不能用 Style 覆 Template（ControlTheme 优先级更高，覆不动）。 -->
  <Style Selector="Slider.pref-range">
    <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexPanelBorderBrush}"/>
  </Style>

  <!-- 偏好表单行（原型 .vex-pref-row）：55 最小高（34 控件 + 上下 10 + 1 分隔线）、上下 10 内边距、底部一条分隔线，左标签右控件。 -->
  <Style Selector="Border.pref-row">
    <Setter Property="MinHeight" Value="55"/>
    <Setter Property="Padding" Value="0,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TextBlock.pref-label">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="21"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- 原型 .vex-pref-row small：12/1.6 muted，与主标签隔 4 像素，最宽 340。
       必须显式靠左：Stretch 的子项被 MaxWidth 拦住后 Avalonia 按居中摆，注释会比主标签缩进约 40 像素。 -->
  <Style Selector="TextBlock.pref-note">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="19.2"/>
    <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="MaxWidth" Value="340"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 原型 .vex-pref-row input / select：180x34、描边 control-border、内边距 5 9（Avalonia 两值 Thickness 是「横,纵」，写法与 CSS 相反）。
       圆角是原型 radius-xs 令牌那一档（同「…」按钮、图标钮一族，随「界面圆角」三档缩放），胶囊只留给分段控件与开关。 -->
  <Style Selector="TextBox.pref-field">
    <Setter Property="Width" Value="180"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexControlBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBox.pref-field">
    <Setter Property="Width" Value="180"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexControlBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <!-- 目录行（原型 .vex-pref-folder）：控件吃满剩余宽度并靠右，路径再长也不被 180 截断。 -->
  <Style Selector="TextBox.pref-field-fill">
    <Setter Property="MinWidth" Value="240"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexControlBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.pref-browse">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- 校验条（原型 .vex-field-error：12 号字继承 .vex-settings 的 1.5 行高 = 18，上下 8）与状态行（原型 .vex-mcp-status：7 点 + 13 字，隔 8）。
       危险/成功色逐配色取 danger/success（库里生成成 SemiColorDanger/Success 画刷），不是两套固定红绿。 -->
  <Style Selector="TextBlock.pref-error">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}"/>
    <Setter Property="Margin" Value="0,8"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="StackPanel.mcp-status">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
  </Style>
  <Style Selector="StackPanel.mcp-status.follow-row">
    <Setter Property="Margin" Value="0,12,0,18"/>
  </Style>
  <Style Selector="StackPanel.mcp-status TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 状态点（原型 .vex-mcp-status i：7 像素圆点）。运行态换 success 并叠 CSS 里那条字面量光环
       （0 0 0 3px #2c967416，不跟配色）；形状用 Border 承载，Ellipse 没有 BoxShadow 可画光环。 -->
  <Style Selector="Border.mcp-dot">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource VexMutedBrush}"/>
  </Style>
  <Style Selector="Border.mcp-dot.on">
    <Setter Property="Background" Value="{DynamicResource SemiColorSuccess}"/>
    <Setter Property="BoxShadow" Value="0 0 0 3 #162C9674"/>
  </Style>
  <!-- 启动中（原型 [data-state=starting] i：vex-pulse 1s 无限循环，50% 处 .3 不透明度；原型这条不乘 vex-motion）。 -->
  <Style Selector="Border.mcp-dot.starting">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="StackPanel.mcp-status.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}"/>
  </Style>
  <!-- 令牌框内联按钮（原型 .vex-token-actions：28x28，压在输入框右端）。 -->
  <Style Selector="Button.mcp-icon">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.mcp-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexHoverBrush}"/>
  </Style>
  <Style Selector="Button.mcp-icon.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
  </Style>
  <Style Selector="Button.mcp-icon Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}"/>
    <Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
  </Style>
  <Style Selector="Button.mcp-icon:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource VexValueBrush}"/>
  </Style>
  <Style Selector="Button.mcp-icon.on Path">
    <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}"/>
  </Style>
  <!-- 客户端配置块（原型 pre.vex-code：16 内边距、上下 14、12/1.8 等宽、可换行、4 像素圆角）。
       底色是 code-bg（每套色板都等于 panel），用 bg 会和外层内容底同色、代码块失去块面层次。 -->
  <Style Selector="Border.mcp-code">
    <Setter Property="Margin" Value="0,14"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}"/>
  </Style>
  <Style Selector="Border.mcp-code SelectableTextBlock">
    <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, SFMono-Regular, Consolas, JetBrains Mono, Microsoft YaHei UI, monospace"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="21.6"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 高亮那两块走 MarkdownViewer：块面（描边、圆角、16 内距）仍归 .mcp-code，压掉库自带的第二层盒与文档外边距。 -->
  <Style Selector="Border.mcp-code Border.MdCodeBlock">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Border.mcp-code StackPanel.MdDocument">
    <Setter Property="Margin" Value="0"/>
  </Style>
  <!-- 动作按钮（原型 .vex-mcp-actions：32 高、CSS padding 5px 16px、1px border 描边 + bg 底 + inherit 文字，
       圆角回到 .vex-button 基线的 radius-xs 档，与相邻字段同口径，不吃工作台区的 999 胶囊覆盖）。
       原型 .vex-button.primary 不带 font-weight（只有 .btn.primary 才 600），库里的 Button.primary 是 SemiBold，这里按这一族收回常规。 -->
  <Style Selector="Button.mcp-pill">
    <Setter Property="MinHeight" Value="32"/>
    <!-- Avalonia 两值 Thickness 是「横,纵」，所以 CSS 的 5px 16px 写成 16,5。 -->
    <Setter Property="Padding" Value="16,5"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusXs}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource VexShellBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.mcp-pill.primary">
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <!-- 动作行（原型 .vex-mcp-actions：上间距 18、项间 8；两枚按钮在 620 宽里排得下，Avalonia StackPanel 没有 flex-wrap 也不需要用）。 -->
  <Style Selector="StackPanel.mcp-actions">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="Margin" Value="0,18,0,0"/>
  </Style>
  <!-- 请求回显卡（原型 .vex-mcp-request：左侧 2 像素主色竖条 + 主色淡底、CSS padding 10px 16px、13/1.5 正文）。 -->
  <Style Selector="Border.mcp-request">
    <Setter Property="Margin" Value="0,18"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}"/>
  </Style>
  <Style Selector="Border.mcp-request TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="20.8"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 审计表空态（原型 table.vex-audit 的 td：12 号字 18 行高、11x6 单元格、一条底边线）。
       表格本身由 CodeWF.Avalonia.DataGrid 承载，同一套尺寸写在 McpAuditOverlayView 的 DataGrid.Styles 里。 -->
  <Style Selector="Border.audit-row TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.audit-row">
    <Setter Property="Padding" Value="6,11"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <!-- MCP 分段页签（原型 .vex-segmented.vex-mcp-tabs）：轨道、指示块、选中字色都走共享配方，
       宿主只补 button{padding:4*密度 10}；二级页签与一级同语言，只把字号收到正文减 1、下方留 14。 -->
  <Style Selector="Button.mcp-tab">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="{DynamicResource VexDensityControlHeightSm}"/>
    <Setter Property="Padding" Value="{DynamicResource VexSegmentedPaddingMcp}"/>
  </Style>
  <Style Selector="Button.mcp-subtab">
    <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeBodySm}"/>
  </Style>
  <Style Selector="Border.mcp-subtabs">
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <!-- 原型 .proto-toast-wrap：条目贴窗口底部、状态栏与浮动坞之上（bottom:64px），左右各留 16px
       （max-width:calc(100% - 32px)）、整列居中、条目之间 8px。Ursa 的 WindowToastManager 没有位置/间距
       API，只能取它模板的 PART_Items 面板。 -->
  <Style Selector="u|WindowToastManager /template/ ReversibleStackPanel#PART_Items">
    <Setter Property="Spacing" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="16,0,16,64"/>
  </Style>
  <!-- 原型 .proto-toast：white-space:normal、text-align:center。ToastCard 模板里的文本块把这两个值
       写成了模板绑定，样式打不进，只能按继承属性从卡片这一层下发。 -->
  <Style Selector="u|ToastCard">
    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
    <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
  </Style>
</Styles>
