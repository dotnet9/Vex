<codewf:CodeWFWindow
    x:Class="Vex.Modules.Shell.Views.MainWindow" x:Name="ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:codewf="https://codewf.com"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:views="using:Vex.Modules.Shell.Views"
    xmlns:shell="using:Vex.Modules.Shell.Views"
    xmlns:vex="clr-namespace:Vex.Controls;assembly=Vex.Controls"
    xmlns:workspace="using:Vex.Modules.Workspace.Views"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:model="using:Vex.Core.Models" xmlns:md="https://codewf.com"
    xmlns:u="https://irihi.tech/ursa"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding DocumentInfo.WindowTitle}"
    Width="1280"
    Height="820"
    MinWidth="800"
    MinHeight="480"
    Icon="/Assets/logo.ico"
    BorderBrush="{DynamicResource VexPanelBorderBrush}"
    TitleBarHeight="33"
    TitleBarBackground="{DynamicResource VexPanelBackgroundBrush}"
    CaptionButtonWidth="46" CaptionGlyphSize="14"
    IsTitleBarVisible="{Binding !Workbench.IsPresenting}"
    IsManagedResizerVisible="{Binding !Workbench.IsPresenting}"
    Topmost="{Binding Layout.IsAlwaysOnTop}"
    WindowState="{Binding Layout.CurrentWindowState, Mode=TwoWay}"
    WindowStartupLocation="CenterScreen">

    <codewf:CodeWFWindow.LeftContent>
        <StackPanel
            Margin="8 0 10 0"
            Height="33"
            Orientation="Horizontal"
            Spacing="12"
            VerticalAlignment="Center"
            IsEnabled="{Binding !IsInModalStatus, ElementName=ShellDialogHost}">
            <!-- 对应原型 .brand：22×22 圆角标识 + 15px/750 字标，间距 7。 -->
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border
                    Width="22"
                    Height="22"
                    CornerRadius="5"
                    Background="{DynamicResource VexBrandBrush}"
                    VerticalAlignment="Center">
                    <Canvas Width="22" Height="22">
                        <Path
                            Data="M5.5 5.3 L11 17 L16.5 5.3"
                            Stroke="{DynamicResource VexBrandMarkBrush}"
                            StrokeThickness="3.9"
                            StrokeLineCap="Round"
                            StrokeJoin="Round" />
                    </Canvas>
                </Border>
                <TextBlock
                    Classes="titlebar-text"
                    FontSize="15"
                    FontWeight="Bold"
                    LetterSpacing="-0.4"
                    Text="Vex"
                    VerticalAlignment="Center" />
            </StackPanel>
            <shell:ShellTitleMenuView x:Name="TitleMenuView" VerticalAlignment="Center" />
            <!-- 原型把文档名放在菜单之后左对齐，而不是标题栏正中。 -->
            <TextBlock
                x:Name="TitleDocumentLabel"
                Text="{Binding DocumentInfo.CurrentDocumentTitle}"
                FontSize="12"
                FontWeight="SemiBold"
                MaxWidth="300"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                AutomationProperties.Name="{Binding DocumentInfo.CurrentDocumentTitle}" />
        </StackPanel>
    </codewf:CodeWFWindow.LeftContent>

    <codewf:CodeWFWindow.RightContent>
        <StackPanel x:Name="TitleBarAppearance" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0"
                    VerticalAlignment="Center" IsEnabled="{Binding !IsInModalStatus, ElementName=ShellDialogHost}">
            <Button x:Name="FindButton" Classes="tb-icon" Command="{Binding ShowFindPanel}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Find}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Find}}" VerticalAlignment="Center">
                <Path Classes="wb-icon" Data="{StaticResource WBSearchIcon}" />
            </Button>
            <shell:ShellAppearanceMenuView x:Name="AppearanceMenu"/>
        </StackPanel>
    </codewf:CodeWFWindow.RightContent>

    <!-- 自定义窗口不含 UrsaWindow 的默认宿主，显式复用 Ursa 浮层控件。
         放在整窗浮层槽（12.2.8 OverlayContent）里，遮罩才能像原型 .vex-settings-host 一样盖住标题条；
         遮罩色对齐原型：#0B1729 28% 透明度。 -->
    <codewf:CodeWFWindow.OverlayContent>
        <u:OverlayDialogHost x:Name="ShellDialogHost" OverlayMaskBrush="{DynamicResource VexScrimBrush}" />
    </codewf:CodeWFWindow.OverlayContent>

    <!-- CodeWFWindow 模板已预留标题栏高度，内容只添加 1 像素分隔线（原型 .titlebar 底边为边框色 55%）。 -->
    <Border x:Name="ShellTitleDivider"
            BorderBrush="{DynamicResource VexTitleDividerBrush}" BorderThickness="0 1 0 0">
    <Grid
        x:Name="ShellGuideRoot"
        Background="{DynamicResource VexWorkspaceCanvasBrush}"
        RowDefinitions="Auto,*,Auto">
        <!-- 原型 .app-window：整窗即画布，块浮在其上（浅色掺 5% 墨，深色掺 30% 面板色）。 -->
        <Border Grid.RowSpan="3" Background="{DynamicResource VexCanvasInkTintBrush}" IsHitTestVisible="False" />
        <Border Grid.Row="0" IsVisible="{Binding !Workbench.IsPresenting}">
            <shell:ShellWorkflowNotice/>
        </Border>

        <Grid Grid.Row="1" x:Name="WorkspaceColumns" Margin="{Binding Workbench.WorkspaceContentMargin}">
            <Grid.ColumnDefinitions>
                <!-- 列宽是侧栏尺寸的唯一来源，拖动结果直接通过双向绑定进入布局状态。 -->
                <ColumnDefinition Width="{Binding Layout.SidebarColumnWidth, Mode=TwoWay}"
                                  MinWidth="{Binding Layout.MinimumVisibleSidebarWidth}"
                                  MaxWidth="{Binding Layout.MaximumVisibleSidebarWidth}" />
                <ColumnDefinition Width="{Binding Layout.SidebarSplitterWidth}" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="{Binding Layout.OutlineSplitterWidth}" />
                <ColumnDefinition Width="{Binding Layout.OutlineColumnWidth, Mode=TwoWay}"
                                  MinWidth="{Binding Layout.MinimumOutlineWidth}" MaxWidth="{Binding Layout.MaximumOutlineWidth}" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SidebarGuideTarget"
                Grid.Column="0"
                ClipToBounds="True"
                IsHitTestVisible="{Binding Layout.ShowSidebar}">
                <Border Classes="workspace-block">
                    <views:ShellFilesView />
                </Border>
            </Border>

            <!-- 间隙即把手本体（4px），负外边距扩到 12px 命中；窄窗口仍为正文保留最小宽度。 -->
            <GridSplitter
                x:Name="SidebarSplitter"
                Grid.Column="1"
                Classes="workspace-gap gap-horizontal"
                ZIndex="9"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding Layout.ShowSidebar}"
                ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

            <Grid x:Name="DocumentColumn" Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <StackPanel x:Name="FloatingViewShelf" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,4" IsVisible="False"/>
                <!-- 原型 .find-strip 是正文列的第一个块（workspace-chrome.css:215/222），与视图块同宽、以 4px 间隙相接，
                     不再横贯整窗顶部。 -->
                <shell:ShellFindBarView Grid.Row="1" DataContext="{Binding FindBar}" />
                <Panel Grid.Row="2">
                <!-- 原型：钉住的格式条只占源码列顶部，阅读/导图窗格从工作区顶端起排，
                     所以 42px 让位只加在编辑/即时视图上，而不是整个 ViewSurface。
                     网格列/行与分栏把手由 WorkspaceViewController 按块状布局重建，这里只声明窗格本身。 -->
                <Grid x:Name="ViewSurface">
                <workspace:MarkdownEditorView x:Name="EditorGuideTarget" IsVisible="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsSourceVisible}" />
                <workspace:MarkdownPreviewView x:Name="PreviewGuideTarget" IsReadingMode="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsReading}" IsVisible="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsPreviewVisible}" />
                <workspace:MarkdownInstantView x:Name="InstantGuideTarget" IsVisible="{Binding Workbench.IsInstantEditing}" />
                <workspace:MarkdownMindMapHost x:Name="MindMapGuideTarget" IsVisible="{Binding Workbench.IsMapVisible}" />
                </Grid>
                <!-- 对应原型 #edit-options：它是编辑块的第一个子级（钉住=占位行，取消钉住=悬浮于正文顶端），
                     由 WorkspaceViewController 在构造时移入块内，才能随圆角一起裁切；这里只是声明宿主。 -->
                <shell:ShellEditorOptionsView x:Name="EditorOptions" />
                </Panel>
                <!-- 原型 .workspace-main .document-statusbar：状态栏不再占行，改为浮在正文列底部居中的胶囊。
                     纵向走令牌 vex-axis-col（圆心钉在底部轴线上，与左右折叠钮、右下角缩放坞同高），底距由 BottomAxis 按实测高度算。 -->
                <shell:ShellStatusBarView x:Name="StatusBarGuideTarget" Grid.Row="2" ZIndex="34"
                                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                          codewf:BottomAxis.CenterFromBottom="20" />
            </Grid>
            <GridSplitter x:Name="OutlineSplitter" Grid.Column="3" Classes="workspace-gap gap-horizontal" ZIndex="9" HorizontalAlignment="Stretch"
                          IsVisible="{Binding Layout.ShowOutlineSidebar}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
            <!-- 与左侧文件栏同构：列宽是唯一尺寸来源，收起时由 ClipToBounds 裁切内容，才能滑出而不是整块消失。 -->
            <Border x:Name="OutlineGuideTarget" Grid.Column="4" Classes="workspace-block" IsHitTestVisible="{Binding Layout.ShowOutlineSidebar}"
                    ClipToBounds="True">
                <shell:ShellAuxiliaryPanelView/>
            </Border>
            <!-- 原型 .pane-collapse：跨整行浮在块层之上，横向位置由块宽（含动画每帧）算出的外边距决定。 -->
            <Button x:Name="SidebarCollapseButton" Grid.ColumnSpan="5" Classes="pane-collapse left"
                    Classes.on="{Binding Layout.ShowSidebar}" IsVisible="{Binding Layout.ShowPaneCollapses}"
                    HorizontalAlignment="Left" Margin="{Binding Layout.SidebarCollapseMargin}"
                    Command="{Binding Layout.ToggleSidebar}"
                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.SidebarFiles}}"
                    ToolTip.Tip="{i18n:I18n {x:Static l:VexL.SidebarFiles}}">
                <Path />
            </Button>
            <Button x:Name="OutlineCollapseButton" Grid.ColumnSpan="5" Classes="pane-collapse right"
                    Classes.on="{Binding Layout.ShowOutlineSidebar}" IsVisible="{Binding Layout.ShowPaneCollapses}"
                    HorizontalAlignment="Right" Margin="{Binding Layout.OutlineCollapseMargin}"
                    Command="{Binding Layout.ToggleOutline}"
                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Outline}}"
                    ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Outline}}">
                <Path />
            </Button>
        </Grid>

        <!-- 原型 .vex-deck header：与正常标题条同高（令牌 app-titlebar-height 33px），面板底色 + 1px 底边；
             文档名 13px/400 单行省略，右侧 25px 高的关闭钮（原型是 × 文本，这里画成 12px 描线叉，避免字体回退把字符画歪）。 -->
        <Border x:Name="PresentationHeader" Grid.Row="0" Classes="deck-header" IsVisible="{Binding Workbench.IsPresenting}">
            <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                <TextBlock Text="{Binding DocumentInfo.CurrentDocumentName}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource VexValueBrush}" />
                <Button x:Name="PresentationExit" Grid.Column="1" Classes="deck-exit"
                        Command="{Binding Workbench.StopPresentation}"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}">
                    <Path Data="{StaticResource WBCloseIcon}" />
                </Button>
            </Grid>
        </Border>
        <!-- 原型 .vex-deck nav：大纲是正文右侧的固定列（左缘 1px 描边、面板底），行高 44、单行省略；
             正文列已由 WorkspaceContentMargin 让出同宽，这里只覆盖右侧。 -->
        <shell:ShellPresentationOutlineView x:Name="PresentationOutline" Grid.Row="1"
                                           IsVisible="{Binding Workbench.PresentationOutline}"
                                           Width="{Binding Workbench.DeckNavWidth}" HorizontalAlignment="Right" />
        <!-- 原型 progress：窗底 2px 通栏进度条，读数=（当前页+1）/总页数。
             演示悬浮件一律压在正文行（Row 1）上：原型 .vex-deck 是 inset:0 的整幅纸面，
             底部悬浮件用 absolute 浮在纸面上；若放进 Row 2 就会撑出一条不透明的底带，成了「状态栏」。 -->
        <ProgressBar x:Name="PresentationProgressBar" Grid.Row="1" IsVisible="{Binding Workbench.IsPresenting}"
                     Height="2" MinHeight="0" CornerRadius="0" VerticalAlignment="Bottom"
                     Minimum="0" Maximum="1" Value="{Binding Workbench.PresentationProgressValue}"
                     Background="Transparent" Foreground="{DynamicResource VexAccentBrush}" />
        <!-- 原型 .deck-modes：阅读/导图分段胶囊悬浮正中，圆心钉在底部轴线（30px）上；大纲展开时整层按 DeckChromeMargin 左移。 -->
        <Panel Grid.Row="1" IsVisible="{Binding Workbench.IsPresenting}" Margin="{Binding Workbench.DeckChromeMargin}"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Border Classes="deck-modes segmented-track" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    codewf:BottomAxis.CenterFromBottom="30">
                <codewf:SegmentedPanel Spacing="2">
                    <Button x:Name="DeckReadSegment" Classes="deck-segment" codewf:SegmentedPanel.IsActive="{Binding Workbench.PresentationDocument}"
                            Content="{i18n:I18n {x:Static l:VexL.WBPresentationContent}}" Command="{Binding Workbench.ShowPresentationDocument}" />
                    <Button x:Name="DeckMapSegment" Classes="deck-segment" codewf:SegmentedPanel.IsActive="{Binding Workbench.PresentationMap}"
                            Content="{i18n:I18n {x:Static l:VexL.WBPresentationMap}}" Command="{Binding Workbench.ShowPresentationMap}" />
                </codewf:SegmentedPanel>
            </Border>
        </Panel>
        <!-- 原型 footer：演示缩放坞与主窗体正文/导图同一枚 .vex-zoomdock；量程与还原语义随阅读/导图切换。
             外层让出大纲列宽（DeckChromeMargin），内层管 40/12 让位，坞本体只留 BottomAxis 写底距，避免绑定被覆写。 -->
        <Panel Grid.Row="1" IsVisible="{Binding Workbench.IsPresenting}" Margin="{Binding Workbench.DeckChromeMargin}"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Panel HorizontalAlignment="Right" Margin="{Binding Workbench.DeckDockMargin}">
                <vex:VexZoomDock x:Name="PresentationDeckDock" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Minimum="{Binding Workbench.DeckZoomMin}" Maximum="{Binding Workbench.DeckZoomMax}"
                                 Step="{Binding Workbench.DeckZoomStep}" PercentMultiplier="100"
                                 Value="{Binding Workbench.DeckScale, Mode=TwoWay}"
                                 Label="{Binding Workbench.DeckZoomLabel}" ResetLabel="{Binding Workbench.DeckResetLabel}"
                                 ResetGeometry="{StaticResource WBFitIcon}" codewf:BottomAxis.CenterFromBottom="30" />
            </Panel>
        </Panel>
        <!-- 原型 .deck-outline-toggle：24px 圆钮，底距 18 使圆心落回 30 轴线；展开贴在大纲列左缘，收起贴窗边并让开右下角缩放坞。 -->
        <Button x:Name="PresentationOutlineToggle" Grid.Row="1" Classes="deck-outline-toggle"
                Classes.on="{Binding Workbench.PresentationOutline}" IsVisible="{Binding Workbench.IsPresenting}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{Binding Workbench.DeckOutlineToggleMargin}"
                Command="{Binding Workbench.TogglePresentationOutline}"
                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationOutline}}"
                AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPresentationOutline}}">
            <Path />
        </Button>
        <shell:ShellTypographyGallery x:Name="TypographyGallery" Grid.RowSpan="4" IsVisible="{Binding Workbench.ShowTypography}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,56,12,12"/>
        <!-- 原型 .workspace-layout-menu{bottom:calc(100% + 10px)}：画廊浮在状态胶囊正上方 10px。
             胶囊圆心改到底部轴线（距正文列底 20）后，正常密度下胶囊顶在窗口底上方 51px，画廊底距即 51 + 10。 -->
        <shell:WorkspaceLayoutGallery x:Name="LayoutGallery" Grid.RowSpan="4" IsVisible="{Binding Workbench.ShowLayouts}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,61"/>
        <shell:WorkbenchGuideView x:Name="WorkbenchGuide" Grid.RowSpan="4"/>
    </Grid>
    </Border>
</codewf:CodeWFWindow>
