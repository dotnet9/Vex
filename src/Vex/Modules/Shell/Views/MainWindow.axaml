<codewf:CodeWFWindow
    x:Class="Vex.Modules.Shell.Views.MainWindow" x:Name="ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:codewf="https://codewf.com"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:regions="using:Vex.Core.Regions"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:shell="using:Vex.Modules.Shell.Views"
    xmlns:workspace="using:Vex.Modules.Workspace.Views"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:model="using:Vex.Core.Models" xmlns:md="https://codewf.com"
    xmlns:u="https://irihi.tech/ursa"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding DocumentInfo.WindowTitle}"
    Width="1280"
    Height="820"
    MinWidth="800"
    MinHeight="480"
    Icon="/Assets/logo.ico"
    TitleBarHeight="40"
    CaptionButtonWidth="46" CaptionGlyphSize="14"
    IsTitleBarVisible="{Binding !Workbench.IsPresenting}"
    IsManagedResizerVisible="{Binding !Workbench.IsPresenting}"
    Topmost="{Binding Layout.IsAlwaysOnTop}"
    WindowState="{Binding Layout.CurrentWindowState, Mode=TwoWay}"
    WindowStartupLocation="CenterScreen">

    <codewf:CodeWFWindow.LeftContent>
        <StackPanel
            Margin="12 0 10 0"
            Height="40"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            IsEnabled="{Binding !IsInModalStatus, ElementName=ShellDialogHost}">
            <!-- 品牌 Logo：渐变圆角方块（对应原型 .tb-logo：20×20、圆角 6、字号 11 粗体） -->
            <Border
                Width="20"
                Height="20"
                CornerRadius="6"
                Background="{DynamicResource VexTitleGradBrush}"
                VerticalAlignment="Center">
                <TextBlock
                    Text="V"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                Classes="titlebar-text"
                FontSize="12"
                FontWeight="SemiBold"
                Text="Vex"
                VerticalAlignment="Center" />
            <shell:ShellTitleMenuView x:Name="TitleMenuView" Margin="4 0 0 0" />
        </StackPanel>
    </codewf:CodeWFWindow.LeftContent>

    <codewf:CodeWFWindow.RightContent>
        <StackPanel x:Name="TitleBarAppearance" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0"
                    VerticalAlignment="Center" IsEnabled="{Binding !IsInModalStatus, ElementName=ShellDialogHost}">
            <ThemeVariantScope x:Name="TitleBarThemeScope"
                               RequestedThemeVariant="{Binding Appearance.ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
                <ThemeVariantScope.Resources>
                    <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{codewf:I18n {x:Static l:VexL.ThemeSystem}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{codewf:I18n {x:Static l:VexL.ThemeLight}}" />
                    <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{codewf:I18n {x:Static l:VexL.ThemeDark}}" />
                </ThemeVariantScope.Resources>
                <u:ThemeToggleButton x:Name="TitleBarThemeToggle" Width="30" Height="30" IsThreeState="True"
                                     TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.MenuTheme}}" />
            </ThemeVariantScope>
            <ListBox x:Name="TitleBarPalettes" ItemsSource="{Binding Appearance.PaletteOptions}"
                     SelectedItem="{Binding Appearance.SelectedPalette}" Background="Transparent" BorderThickness="0" Padding="0"
                     ToolTip.Tip="{i18n:I18n {x:Static l:VexL.ThemeColor}}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Width" Value="24" /><Setter Property="Height" Value="30" />
                        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="15" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate x:DataType="model:PaletteOption">
                    <Ellipse Width="13" Height="13" Fill="{Binding Swatch}" ToolTip.Tip="{i18n:I18n {Binding NameKey}}" />
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ComboBox x:Name="TitleBarLanguageSelector" ItemsSource="{Binding Appearance.LanguageOptions}"
                      SelectedItem="{Binding Appearance.SelectedLanguage}" Width="50" Height="30" MinHeight="0" Padding="6,0"
                      HorizontalContentAlignment="Left" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.MenuLanguage}}">
                <ComboBox.SelectionBoxItemTemplate><DataTemplate><PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconLanguage}" /></DataTemplate></ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate><DataTemplate x:DataType="model:LanguageOption"><TextBlock MinWidth="120" Text="{Binding NativeName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </codewf:CodeWFWindow.RightContent>

    <!-- CodeWFWindow 模板已预留标题栏高度，内容只添加 1 像素分隔线。 -->
    <Border x:Name="ShellTitleDivider"
            BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0 1 0 0">
    <Grid
        x:Name="ShellGuideRoot"
        Background="{DynamicResource VexShellBackgroundBrush}"
        RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="1" IsVisible="{Binding !Workbench.IsPresenting}">
            <shell:ShellFindBarView DataContext="{Binding FindBar}" />
        </Border>

        <shell:ShellWorkbenchToolbarView x:Name="WorkbenchToolbar" Grid.Row="0" IsVisible="{Binding !Workbench.IsPresenting}"/>
        <Grid Grid.Row="2" x:Name="WorkspaceColumns" IsVisible="{Binding !Workbench.PresentationOutline}" Margin="{Binding Workbench.PresentationContentMargin}">
            <Grid.ColumnDefinitions>
                <!-- 列宽是侧栏尺寸的唯一来源，拖动结果直接通过双向绑定进入布局状态。 -->
                <ColumnDefinition Width="{Binding Layout.SidebarColumnWidth, Mode=TwoWay}"
                                  MinWidth="{Binding Layout.MinimumVisibleSidebarWidth}"
                                  MaxWidth="{Binding Layout.MaximumVisibleSidebarWidth}" />
                <ColumnDefinition Width="{Binding Layout.SidebarSplitterWidth}" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="{Binding Layout.OutlineSplitterWidth}" />
                <ColumnDefinition Width="{Binding Layout.OutlineColumnWidth, Mode=TwoWay}"
                                  MinWidth="{Binding Layout.MinimumOutlineWidth}" MaxWidth="{Binding Layout.MaximumOutlineWidth}" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SidebarGuideTarget"
                Grid.Column="0"
                ClipToBounds="True"
                IsHitTestVisible="{Binding Layout.ShowSidebar}">
                <Border Classes="panel">
                    <ContentControl prism:RegionManager.RegionName="{x:Static regions:RegionNames.ShellSidebarRegion}" />
                </Border>
            </Border>

            <!-- 扩大命中区域，但只绘制细分隔线；窄窗口仍为正文保留最小宽度。 -->
            <GridSplitter
                x:Name="SidebarSplitter"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding Layout.ShowSidebar}"
                ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <StackPanel x:Name="FloatingViewShelf" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,4" IsVisible="False"/>
                <shell:ShellEditorOptionsView x:Name="EditorOptions" Grid.Row="1"/>
                <Grid x:Name="ViewSurface" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Workbench.SourceColumnWidth}"/>
                    <ColumnDefinition Width="{Binding Workbench.SplitterWidth}"/>
                    <ColumnDefinition Width="{Binding Workbench.PreviewColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <workspace:MarkdownEditorView x:Name="EditorGuideTarget" Grid.Column="0" IsVisible="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsSourceVisible}" />
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" IsVisible="{Binding Workbench.IsSourceVisible}" />
                <workspace:MarkdownPreviewView x:Name="PreviewGuideTarget" IsReadingMode="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsReading}" Grid.Column="2" IsVisible="{Binding #ShellWindow.((vm:MainWindowViewModel)DataContext).Workbench.IsPreviewVisible}" />
                <workspace:MarkdownInstantView x:Name="InstantGuideTarget" Grid.ColumnSpan="3" IsVisible="{Binding Workbench.IsInstantEditing}" />
                <workspace:MarkdownMindMapHost x:Name="MindMapGuideTarget" Grid.Column="{Binding Workbench.MapColumn}" Grid.ColumnSpan="{Binding Workbench.MapSpan}" IsVisible="{Binding Workbench.IsMapVisible}" />
                </Grid>
                <Border x:Name="TypographyGallery" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" IsVisible="{Binding Workbench.ShowTypography}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="18,48,18,18" Padding="18" Width="338" MaxHeight="520" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexPanelBackgroundBrush}">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBTypographyTitle}}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBTypographyHint}}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="vex-dismiss" Command="{Binding Workbench.ToggleTypography}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/></Grid>
                        <ListBox Classes="typography-grid" Grid.Row="1" ItemsSource="{Binding Appearance.TypographyOptions}" SelectedItem="{Binding Appearance.SelectedTypography, Mode=TwoWay}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate x:DataType="model:TypographyOption">
                                <Border Classes="typography-card" Width="90" Height="58" Padding="6" ClipToBounds="True" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center"><StackPanel Width="36" Spacing="4"><Border Height="3" Background="{Binding SwatchColor}"/><Border Height="1" Background="{DynamicResource VexPanelBorderBrush}"/><Border Height="1" Width="26" HorizontalAlignment="Left" Background="{DynamicResource VexPanelBorderBrush}"/></StackPanel><TextBlock Text="{i18n:I18n {Binding NameKey}}" FontSize="10" TextAlignment="Center"/></StackPanel>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}" Padding="0,14,0,0">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{i18n:I18n {x:Static l:VexL.CompactLayout}}" FontSize="11" VerticalAlignment="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding Appearance.IsCompactLayout, Mode=TwoWay}" MinWidth="0" MinHeight="0"/></Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter x:Name="OutlineSplitter" Grid.Column="3" HorizontalAlignment="Stretch"
                          IsVisible="{Binding Layout.ShowOutlineSidebar}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
            <Border x:Name="OutlineGuideTarget" Grid.Column="4" IsVisible="{Binding Layout.ShowOutlineSidebar}"
                    Background="{DynamicResource VexPanelBackgroundBrush}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="14,8,8,4" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{i18n:I18n {x:Static l:VexL.DocumentStructure}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="wb-quiet" Command="{Binding Layout.ToggleOutline}" Width="28" Height="28" Padding="6"
                                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Outline}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Outline}}">
                            <PathIcon Width="14" Height="14" Data="M9 5L16 12L9 19"/>
                        </Button>
                    </Grid>
                    <ContentControl Grid.Row="1" prism:RegionManager.RegionName="{x:Static regions:RegionNames.ShellOutlineRegion}" />
                </Grid>
            </Border>
        </Grid>

        <shell:ShellStatusBarView
            x:Name="StatusBarGuideTarget"
            Grid.Row="3" />

        <shell:ShellPresentationOutlineView x:Name="PresentationOutline" Grid.RowSpan="4" IsVisible="{Binding Workbench.PresentationOutline}"/>
        <Border x:Name="PresentationTools" Classes="presentation-tools" Grid.RowSpan="4" IsVisible="{Binding Workbench.IsPresenting}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="24" Padding="6" Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ToggleButton x:Name="PresentationDocumentToggle" Classes="wb-quiet" Command="{Binding Workbench.ShowPresentationDocument}" IsChecked="{Binding Workbench.PresentationDocument, Mode=OneWay}" Content="{i18n:I18n {x:Static l:VexL.WBPresentationContent}}" ToolTip.Tip="D"/>
                    <ToggleButton x:Name="PresentationOutlineToggle" Classes="wb-quiet" Command="{Binding Workbench.ShowPresentationOutline}" IsChecked="{Binding Workbench.PresentationOutline, Mode=OneWay}" Content="{i18n:I18n {x:Static l:VexL.WBPresentationOutline}}" ToolTip.Tip="O"/>
                    <ToggleButton x:Name="PresentationMapToggle" Classes="wb-quiet" Command="{Binding Workbench.ShowPresentationMap}" IsChecked="{Binding Workbench.PresentationMap, Mode=OneWay}" Content="{i18n:I18n {x:Static l:VexL.WBPresentationMap}}" ToolTip.Tip="M"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" IsVisible="{Binding Workbench.PresentationDocument}">
                    <Button x:Name="PresentationPrevious" Classes="wb-quiet" Content="←" Command="{Binding Workbench.PreviousPresentation}" IsEnabled="{Binding Workbench.CanPreviousPresentation}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationPrevious}}"/>
                    <TextBlock Text="{Binding Workbench.PresentationProgress}" VerticalAlignment="Center" MinWidth="72" TextAlignment="Center"/>
                    <Button x:Name="PresentationNext" Classes="wb-quiet" Content="→" Command="{Binding Workbench.NextPresentation}" IsEnabled="{Binding Workbench.CanNextPresentation}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationNext}}"/>
                </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                <Button x:Name="PresentationSmaller" Classes="wb-quiet" IsVisible="{Binding Workbench.PresentationDocument}" Command="{Binding Workbench.DecreasePresentationText}" IsEnabled="{Binding Workbench.CanDecreasePresentationText}" Content="A−" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationSmaller}}"/>
                <Button x:Name="PresentationLarger" Classes="wb-quiet" IsVisible="{Binding Workbench.PresentationDocument}" Command="{Binding Workbench.IncreasePresentationText}" IsEnabled="{Binding Workbench.CanIncreasePresentationText}" Content="A+" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationLarger}}"/>
                <Button x:Name="PresentationExit" Classes="vex-dismiss" Command="{Binding Workbench.StopPresentation}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBPresentationExit}}"/>
            </StackPanel>
            </Grid>
        </Border>
        <shell:WorkspaceLayoutGallery x:Name="LayoutGallery" Grid.RowSpan="4" IsVisible="{Binding Workbench.ShowLayouts}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18,56,130,18"/>
        <shell:WorkbenchGuideView x:Name="WorkbenchGuide" Grid.RowSpan="4"/>
        <!-- 自定义窗口不含 UrsaWindow 的默认宿主，显式复用 Ursa 浮层控件。 -->
        <u:OverlayDialogHost x:Name="ShellDialogHost" Grid.RowSpan="4" />
    </Grid>
    </Border>
</codewf:CodeWFWindow>
