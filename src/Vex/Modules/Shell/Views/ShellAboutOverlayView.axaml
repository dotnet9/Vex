<UserControl x:Class="Vex.Modules.Shell.Views.ShellAboutOverlayView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex" xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:ShellAboutViewModel">
 <UserControl.Styles>
  <Style Selector="Button.about-link"><Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/></ControlTemplate></Setter></Style>
  <Style Selector="Button.about-link:pointerover"><Setter Property="Opacity" Value="0.7"/></Style>
 </UserControl.Styles>
 <Border Classes="dialog-card" Width="480" MaxHeight="600" Padding="0" CornerRadius="8" ClipToBounds="True">
  <Grid RowDefinitions="36,*">
   <Border Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
    <Grid ColumnDefinitions="*,46" VerticalAlignment="Center"><TextBlock Text="{i18n:I18n Vex.VexL.AboutDialogTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Click="Close_OnClick" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/></Grid>
   </Border>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Grid Margin="32,28,32,0" ColumnDefinitions="64,*" ColumnSpacing="18">
      <Border Width="64" Height="64" Background="{DynamicResource VexAccentBrush}" CornerRadius="16"><Viewbox Width="52" Height="52"><Canvas Width="64" Height="64"><Path Data="M13 12L32 52L51 12" Stroke="White" StrokeThickness="12" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Border>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="维刻 Vex" FontSize="24" LineHeight="33.6" FontWeight="Bold"/><TextBlock Text="{i18n:I18n Vex.VexL.AboutShortSlogan}" FontSize="14" LineHeight="25.2" Classes="muted" TextWrapping="Wrap"/></StackPanel>
     </Grid>
     <Grid Margin="32,22,32,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
      <TextBlock Text="{i18n:I18n {x:Static l:VexL.AboutVersionLabel}}" FontSize="14" LineHeight="25.2" Classes="muted" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Classes="about-link" Command="{Binding ReleaseCommand}" Padding="0" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.AboutOpenRelease}}"><Border Padding="10,2" CornerRadius="12" Background="{DynamicResource VexAccentSoftBrush}"><TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource VexAccentBrush}" FontSize="12" FontWeight="SemiBold"/></Border></Button>
      <TextBlock Grid.Row="1" Text="{i18n:I18n Vex.VexL.AboutLicense}" FontSize="14" LineHeight="25.2" Classes="muted"/><TextBlock Grid.Row="1" Grid.Column="1" Text="MIT License" FontSize="14" LineHeight="25.2"/>
      <TextBlock Grid.Row="2" Text="{i18n:I18n Vex.VexL.WSLinks}" FontSize="14" LineHeight="25.2" Classes="muted"/>
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Button Classes="about-link" Command="{Binding WebsiteCommand}" Content="{i18n:I18n {x:Static l:VexL.Website}}" Padding="0" MinHeight="0" FontSize="14"/><TextBlock Text="·" Classes="muted"/><Button Classes="about-link" Command="{Binding RepositoryCommand}" Content="{i18n:I18n Vex.VexL.WSRepository}" Padding="0" MinHeight="0" FontSize="14"/></StackPanel>
     </Grid>
     <Border Margin="32,22,32,0" Padding="0,14,0,20" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}">
      <StackPanel Spacing="4"><TextBlock Text="{Binding CopyrightText}" Classes="muted" FontSize="12" LineHeight="21.6" TextWrapping="Wrap"/><TextBlock Text="Avalonia / .NET" Classes="muted" FontSize="12" LineHeight="21.6"/></StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
