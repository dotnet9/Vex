<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellAboutOverlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="clr-namespace:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellAboutViewModel">
    <Border Classes="dialog-card" Width="580" MaxHeight="700">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Width="40" Height="40" Source="/Assets/logo.png" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{i18n:I18n {x:Static l:VexL.AppName}}" />
                        <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutDescription}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Padding="14" CornerRadius="10" Background="{DynamicResource VexAccentSoftBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="5">
                                <TextBlock FontWeight="SemiBold" Text="{i18n:I18n {x:Static l:VexL.AboutCheckUpdateLabel}}" />
                                <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutUpdateHint}}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Command="{Binding UpdateCommand}" Content="{Binding ActionText}" MinWidth="110" />
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                        <ProgressBar IsVisible="{Binding IsDownloading}" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Progress}" Minimum="0" Maximum="100" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding IsDownloading}" />
                            <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="{i18n:I18n {x:Static l:VexL.Cancel}}" IsVisible="{Binding IsBusy}" />
                        </Grid>
                        <Expander Header="{i18n:I18n {x:Static l:VexL.AboutReleaseNotes}}" IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock MaxHeight="160" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutVersionLabel}}" />
                    <Border Grid.Column="1" Padding="10,2" HorizontalAlignment="Left" Background="{DynamicResource VexAccentSoftBrush}" CornerRadius="9">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VexAccentBrush}" Text="{Binding VersionText}" />
                    </Border>
                    <TextBlock Grid.Row="1" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutPlatformLabel}}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlatformText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutCompileTimeLabel}}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompileTimeText}" />
                    <TextBlock Grid.Row="3" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutAuthorLabel}}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.AboutAuthorName}}" />
                    <TextBlock Grid.Row="4" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutRepositoryLabel}}" />
                    <Button Grid.Row="4" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Command="{Binding RepositoryCommand}" Content="https://github.com/dotnet9/Vex" />
                    <TextBlock Grid.Row="5" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutWebsiteLabel}}" />
                    <Button Grid.Row="5" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Command="{Binding WebsiteCommand}" Content="https://codewf.com" />
                    <TextBlock Grid.Row="6" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutBrandLabel}}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.AboutBrandName}}" />
                    <TextBlock Grid.Row="7" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutCopyrightLabel}}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CopyrightText}" TextWrapping="Wrap" />
                </Grid>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding CheckCommand}" IsVisible="{Binding CanRecheck}" Content="{i18n:I18n {x:Static l:VexL.AboutCheckUpdate}}" />
                    <Button Click="Close_OnClick" Content="{i18n:I18n {x:Static l:VexL.Close}}" MinWidth="86" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
