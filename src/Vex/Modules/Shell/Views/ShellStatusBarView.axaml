<UserControl x:Class="Vex.Modules.Shell.Views.ShellStatusBarView" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
 xmlns:prism="http://prismlibrary.com/" xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:vex="clr-namespace:Vex.Controls;assembly=Vex.Controls" x:DataType="vm:ShellStatusBarViewModel" IsVisible="{Binding Layout.ShowStatusBar}" prism:ViewModelLocator.AutoWireViewModel="True">
 <UserControl.Styles>
  <!-- 对应原型 .workspace-viewswitch：它本身就是一枚 .vex-segmented，轨道底色、圆角、内缩、滑动指示块、
       选中字色字重全部走 Vex.Controls 的共享配方；宿主只补自己的基准高与图标口径。 -->
  <Style Selector="Border.view-switch">
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 对应原型 .workspace-viewswitch button：26×seg-scale 高、3×scale/14 内距（令牌随界面密度缩放）。 -->
  <Style Selector="Button.view-segment">
   <Setter Property="MinHeight" Value="0" />
   <Setter Property="Height" Value="{DynamicResource VexSegmentedHeightView}" />
   <Setter Property="Padding" Value="{DynamicResource VexSegmentedPaddingView}" />
  </Style>
  <Style Selector="Button.view-segment Path">
   <Setter Property="Width" Value="12" />
   <Setter Property="Height" Value="12" />
   <Setter Property="Stretch" Value="Uniform" />
   <Setter Property="StrokeThickness" Value="1.7" />
   <Setter Property="StrokeLineCap" Value="Round" />
   <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!-- 对应原型 .document-word-count：12px 静音文字，悬停转主题色。 -->
  <Style Selector="Button.sb-word">
   <Setter Property="MinHeight" Value="0" />
   <Setter Property="Padding" Value="6,0" />
   <Setter Property="CornerRadius" Value="999" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
   <Setter Property="FontSize" Value="{DynamicResource VexDensityFontSizeCaption}" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sb-word:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sb-word:pointerover">
   <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
  </Style>
 </UserControl.Styles>

 <!-- 对应原型 .workspace-main .document-statusbar：状态栏退役为悬浮胶囊——块面底 + 1px 描边 + 整胶囊圆角，
      宽度随内容收缩，靠 MainWindow 的右下角定位（bottom 16、水平居中于正文列）。 -->
 <Border Classes="status-pill" Padding="6,4" CornerRadius="999" BorderThickness="1"
         Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}"
         BoxShadow="0 10 30 #22000000">
  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
   <Border x:Name="ViewSwitch" Classes="view-switch vex-segmented">
    <vex:VexSegmentedPanel Spacing="2">
     <Button x:Name="SourceSegment" Classes="view-segment vex-segment" vex:VexSegmentedPanel.IsActive="{Binding Workbench.IsSourceSegmentActive}" Content="{i18n:I18n {x:Static l:VexL.StatusViewSource}}" Command="{Binding Workbench.ShowSourceView}" />
     <Button x:Name="ReadSegment" Classes="view-segment vex-segment" vex:VexSegmentedPanel.IsActive="{Binding Workbench.IsReadSegmentActive}" Content="{i18n:I18n {x:Static l:VexL.StatusViewRead}}" Command="{Binding Workbench.ShowRead}" />
     <Button x:Name="MapSegment" Classes="view-segment vex-segment" vex:VexSegmentedPanel.IsActive="{Binding Workbench.IsMapSegmentActive}" Content="{i18n:I18n {x:Static l:VexL.StatusViewMap}}" Command="{Binding Workbench.ShowMindMap}" />
     <Button x:Name="LayoutButton" Classes="view-segment view-more vex-segment" vex:VexSegmentedPanel.IsActive="{Binding Workbench.IsMoreSegmentActive}" Command="{Binding Workbench.ToggleLayouts}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WSLayoutTitle}}">
      <StackPanel Orientation="Horizontal" Spacing="4">
       <TextBlock Text="{Binding Workbench.MoreSegmentLabel}" VerticalAlignment="Center" />
       <Path Classes="expand-chevron" Data="M6 9L12 15L18 9" />
      </StackPanel>
     </Button>
    </vex:VexSegmentedPanel>
   </Border>
   <Button x:Name="StatisticsButton" Classes="sb-word" IsVisible="{Binding Preferences.WordCountVisible}" Command="{Binding ShowStatisticsAsync}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.StatisticsTitle}}">
    <TextBlock Text="{Binding DocumentInfo.StatusWordCountText}" FontSize="{DynamicResource VexDensityFontSizeCaption}" />
   </Button>
  </StackPanel>
 </Border>
</UserControl>
