<UserControl x:Class="Vex.Modules.Shell.Views.ShellStatusBarView" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
 xmlns:prism="http://prismlibrary.com/" xmlns:vm="using:Vex.Modules.Shell.ViewModels" x:DataType="vm:ShellStatusBarViewModel" IsVisible="{Binding Layout.ShowStatusBar}" prism:ViewModelLocator.AutoWireViewModel="True">
 <Border Height="32" Background="{DynamicResource VexStatusBarBackgroundBrush}" BorderBrush="{DynamicResource VexStatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" ToolTip.Tip="{Binding Status.StatusText}">
    <ToggleButton Classes="wb-quiet" IsChecked="{Binding Layout.IsSidebarVisible, Mode=OneWay}" Command="{Binding Layout.ToggleSidebar}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.DocumentList}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.DocumentList}}" Padding="4" MinHeight="24"><PathIcon Width="14" Height="14" Data="M3 3H21V21H3Z M8 3V21"/></ToggleButton>
    <ToggleButton Classes="wb-quiet" IsChecked="{Binding Workbench.IsSourceEditing, Mode=OneWay}" Command="{Binding Workbench.ToggleSourceEditing}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBSource}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBSource}}" Padding="4" MinHeight="24"><PathIcon Width="14" Height="14" Data="M8 5L2 12L8 19 M16 5L22 12L16 19"/></ToggleButton>
    <ToggleButton Classes="wb-quiet" IsChecked="{Binding Layout.ShowOutlineSidebar, Mode=OneWay}" Command="{Binding Layout.ToggleOutline}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Outline}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Outline}}" Padding="4" MinHeight="24"><PathIcon Width="14" Height="14" Data="M3 3H21V21H3Z M16 3V21"/></ToggleButton>
    <Ellipse Width="5" Height="5" Fill="{DynamicResource VexSuccessBrush}" IsVisible="{Binding !DocumentInfo.IsModified}"/>
    <Ellipse Width="5" Height="5" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding DocumentInfo.IsModified}"/>
    <TextBlock Text="{Binding DocumentInfo.DocumentStateText}" Classes="wb-muted"/>
    <TextBlock Text="·" Classes="wb-muted"/><TextBlock Text="{Binding Workbench.ViewLabel}" Classes="wb-muted"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Workbench.IsEditing}" VerticalAlignment="Center">
     <TextBlock Text="{i18n:I18n {x:Static l:VexL.StatusLine}}" Classes="wb-muted"/><TextBlock Text="{Binding Status.CaretLine}" Classes="wb-muted"/>
     <TextBlock Text="{i18n:I18n {x:Static l:VexL.StatusColumn}}" Classes="wb-muted"/><TextBlock Text="{Binding Status.CaretColumn}" Classes="wb-muted"/>
    </StackPanel>
    <Button x:Name="StatisticsButton" Classes="wb-quiet" MinHeight="24" Padding="0" Command="{Binding ShowStatisticsAsync}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.StatisticsTitle}}"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding DocumentInfo.Statistics.Characters}" FontSize="11.5"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.StatusCharacters}}" FontSize="11.5"/></StackPanel></Button>
    <TextBlock Text="{Binding DocumentInfo.CurrentEncodingText}" Classes="wb-muted" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding DocumentInfo.LineEndingText}" Classes="wb-muted" VerticalAlignment="Center"/>
    <Button x:Name="AppearanceButton" Classes="wb-quiet" MinHeight="24" Padding="5" Click="AppearanceClick" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBTheme}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.WBTheme}}"><PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconColorPalette}"/></Button>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
