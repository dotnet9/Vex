<UserControl
    x:Class="Vex.Modules.Shell.Views.ShellFindBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Vex.Core.Behaviors"
    xmlns:ac="https://codewf.com"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Shell.ViewModels"
    x:DataType="vm:ShellFindBarViewModel"
    behaviors:FocusOnVisible.TargetName="FindTextBox"
    behaviors:FocusOnVisible.SelectAll="True"
    IsVisible="{Binding IsVisible}">

    <UserControl.Styles>
        <!-- 原型 .find-strip .btn.sm：26px 高、7px 圆角、12px 字号、左右内距 12。 -->
        <Style Selector="Button.find-action, ToggleButton.find-action">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 原型 .opt-toggle（theme.css:542）：28 高、min-width 30、0x8 内距、11.5 号 600 字重、6px 圆角。
             它不是 .btn.sm，所以不吃上面那套 26/12 的度量；窄窗里三个开关省下的宽度正好还给输入框。 -->
        <Style Selector="ToggleButton.opt-toggle">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- 原型 .icon-button：30×30、6px 圆角、无底色，悬停才浮出底色。 -->
        <Style Selector="Button.find-close">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- 展开动画按 ExpandedSize-4 排版子级（实测 64→60、46→42），故原型 46px 的查找条写 50。 -->
    <ac:ContentExpansionAnimator
        Animate="{Binding IsVisible}"
        CollapsedSize="0"
        Duration="{DynamicResource MotionDurationMid}"
        ExpandedSize="50"
        IsExpanded="{Binding IsVisible}"
        Orientation="Vertical">
        <!-- 原型 .find-strip 独立成块（workspace-chrome.css:215/222）：1px 描边 + 10px 圆角，内距 7×12，整条 46px。 -->
        <Border
            x:Name="FindStrip"
            Classes="workspace-block"
            Margin="0,0,0,4"
            Padding="12 7">
            <!-- 原型 .find-strip 只有「输入框 + 动作钮 + 关闭钮」，没有作用域标签（Vex.html:102）；
                 flex + gap:6、输入框 min-width:0，窄窗先收缩输入框，关闭钮因此不会被挤出块外。
                 原生给 72 的下限（与动作钮同宽）：800px 窗口下原型已把输入框压到 50 上下，再低就没法看了。 -->
            <Grid ColumnDefinitions="*,*,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <!-- 查找框：与侧栏搜索同一焦点配方（Grid.search-shell：pill、accent 边 + 3px 柔光、fast 档过渡），
                 原型 .find-strip .input 另给 28 高与 11 号字；命中计数以内嵌徽章叠在输入框右侧（对应原型 .fb-count）。 -->
            <Grid
                Grid.Column="0"
                MaxWidth="220"
                MinWidth="96">
                <Grid Classes="search-shell" Height="28">
                    <Border Classes="search-glow" />
                    <Border Classes="search-frame" Padding="10,0">
                        <TextBox
                            x:Name="FindTextBox"
                            AcceptsReturn="False"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="11"
                            KeyDown="OnFindTextBoxKeyDown"
                            MaxLength="200"
                            MinHeight="0"
                            Padding="0 0 56 0"
                            PlaceholderText="{i18n:I18n Vex.VexL.FindBarFindPlaceholder}"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Text="{Binding SearchText, Mode=TwoWay}" />
                    </Border>
                    <Border Classes="search-hover" />
                </Grid>
                <Border
                    Margin="0 0 8 0"
                    Padding="6 0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource VexAccentSoftBrush}"
                    CornerRadius="5"
                    IsHitTestVisible="False">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource VexAccentBrush}"
                        Text="{Binding SearchResultText}" />
                </Border>
            </Grid>
            <!-- 原型 .btn.sm：26px 高、7px 圆角、12px 字号；关闭钮 30×30 无边框（.icon-button）。 -->
            <Grid
                Grid.Column="1"
                MaxWidth="220"
                MinWidth="96"
                IsVisible="{Binding IsReplaceVisible}">
                <Grid Classes="search-shell" Height="28">
                    <Border Classes="search-glow" />
                    <Border Classes="search-frame" Padding="10,0">
                        <TextBox
                            AcceptsReturn="False"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="11"
                            MaxLength="200"
                            MinHeight="0"
                            PlaceholderText="{i18n:I18n Vex.VexL.FindBarReplacePlaceholder}"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Text="{Binding ReplacementText, Mode=TwoWay}" />
                    </Border>
                    <Border Classes="search-hover" />
                </Grid>
            </Grid>
            <!-- 原型 .find-strip 的动作顺序是「上一个 → 下一个 → 全部替换」；「替换」是实现侧补充，夹在中间。 -->
            <Button
                x:Name="FindPrevButton"
                Grid.Column="2"
                Classes="find-action"
                Command="{Binding FindPrev}"
                Content="{i18n:I18n {x:Static l:VexL.FindBarPrev}}"
                MinWidth="72" />
            <Button
                x:Name="FindNextButton"
                Grid.Column="3"
                Classes="primary find-action"
                Command="{Binding FindNext}"
                Content="{i18n:I18n {x:Static l:VexL.FindBarNext}}"
                MinWidth="72" />
            <Button
                Grid.Column="4"
                Classes="find-action"
                Width="82"
                Command="{Binding ReplaceNext}"
                Content="{i18n:I18n {x:Static l:VexL.FindBarReplace}}"
                IsVisible="{Binding IsReplaceVisible}" />
            <Button
                Grid.Column="5"
                Classes="find-action"
                Width="64"
                Command="{Binding ReplaceAll}"
                Content="{i18n:I18n {x:Static l:VexL.FindBarAll}}"
                IsVisible="{Binding IsReplaceVisible}" />
            <!-- Aa / W / .* 图标化开关（原型 .opt-toggle）：激活态主题色底。 -->
            <ToggleButton
                Grid.Column="7"
                Classes="opt-toggle find-action"
                Content=".*"
                IsChecked="{Binding IsRegex, Mode=TwoWay}"
                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.FindBarRegex}}"
                VerticalAlignment="Center" />
            <ToggleButton
                Grid.Column="8"
                Classes="opt-toggle find-action"
                Content="Aa"
                IsChecked="{Binding IsMatchCase, Mode=TwoWay}"
                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.FindBarMatchCase}}"
                VerticalAlignment="Center" />
            <ToggleButton
                Grid.Column="9"
                Classes="opt-toggle find-action"
                Content="W"
                IsChecked="{Binding IsWholeWord, Mode=TwoWay}"
                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.FindBarWholeWord}}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="10"
                Classes="find-close"
                Command="{Binding CloseFindPanel}"
                Content="×"
                FontSize="14"
                ToolTip.Tip="{i18n:I18n {x:Static l:VexL.FindBarClose}}"
                AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.FindBarClose}}" />
            </Grid>
        </Border>
    </ac:ContentExpansionAnimator>
</UserControl>
