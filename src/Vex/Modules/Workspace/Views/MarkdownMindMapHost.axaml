<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
             xmlns:vm="using:Vex.Modules.Shell.ViewModels" xmlns:mind="https://codewf.com" xmlns:codewf="https://codewf.com" xmlns:vex="clr-namespace:Vex.Controls;assembly=Vex.Controls"
             x:DataType="vm:MainWindowViewModel" x:Class="Vex.Modules.Workspace.Views.MarkdownMindMapHost">
  <UserControl.Styles>
    <Style Selector="Button.map-tool, ToggleButton.map-tool"><Setter Property="FontSize" Value="10.5"/><Setter Property="Padding" Value="7,4"/><Setter Property="MinHeight" Value="26"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="MapEditingToolbar" Classes="map-topbar" IsVisible="{Binding !Workbench.IsPresenting}" MinHeight="36" Padding="10,4" Background="{DynamicResource VexPanelBackgroundBrush}" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel x:Name="MapTitle" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Path Classes="wb-icon" Data="{StaticResource WBMapIcon}"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.DocumentStructure}}" Classes="wb-muted"/><TextBlock Text="{Binding Workbench.MapCountLabel}" Classes="wb-muted"/></StackPanel>
        <Grid x:Name="MapToolbarGrid" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="wb-quiet map-tool" Tag="child" Click="ChapterClick"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="+"/><TextBlock Text="{i18n:I18n Vex.VexL.WSChild}"/></StackPanel></Button>
          <Button Classes="wb-quiet map-tool" Tag="sibling" Click="ChapterClick"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="+"/><TextBlock Text="{i18n:I18n Vex.VexL.WSSibling}"/></StackPanel></Button>
          <ToggleButton x:Name="HeadingsOnlyButton" Classes="wb-quiet map-tool" Content="{i18n:I18n Vex.VexL.WSHeadingsOnly}" Click="HeadingsOnlyClick"/>
        </StackPanel>
        <StackPanel x:Name="MapToolsRight" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
          <!-- 原型：⚙图标 + 当前显示模式标签（仅标题 / 摘要 N 字）。 -->
          <ToggleButton x:Name="SummarySettingsButton" Classes="wb-quiet map-tool" IsChecked="{Binding Workbench.ShowMapSettings, Mode=OneWay}" Command="{Binding Workbench.ToggleMapSettings}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Classes="wb-icon" Width="11" Height="11" Data="{StaticResource WBGearIcon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Workbench.MapSummaryLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="CollapseBranchesButton" Classes="wb-quiet map-tool" Content="{i18n:I18n {x:Static l:VexL.WBCollapse}}" Click="CollapseClick"/>
          <ToggleButton x:Name="MapSourceButton" Classes="wb-quiet map-tool" IsChecked="{Binding Workbench.ShowMapSource, Mode=OneWay}" Command="{Binding Workbench.ToggleMapSource}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="wb-icon" Width="11" Height="11" Data="{StaticResource WBColumnsIcon}"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBMapSource}}"/></StackPanel></ToggleButton>
          <ToggleButton x:Name="PinMap" Classes="toolbar-pin" Margin="4,0,0,0" IsChecked="{Binding Workbench.Preferences.PinMapToolbar}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.WBPinToolbar}}">
            <Panel Width="14" Height="14">
              <Viewbox Classes="pin-on"><Canvas Width="24" Height="24"><Path Classes="pin-head" Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
              <Viewbox Classes="pin-off"><Canvas Width="24" Height="24"><Canvas.RenderTransform><RotateTransform Angle="45" CenterX="12" CenterY="11"/></Canvas.RenderTransform><Path Data="M8 3h8l-1 8H9l-1-8z"/><Path Data="M12 11v9"/></Canvas></Viewbox>
            </Panel>
          </ToggleButton>
        </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <!-- 原型 .map-viewport：底色之上叠 18px 点阵（workbench.css:140），画布本身改为透明以透出这两层。 -->
      <Border Background="{DynamicResource VexPreviewBackgroundBrush}"/>
      <Border x:Name="MapDotGrid" IsHitTestVisible="False"/>
      <mind:MarkdownMindMapView x:Name="Map" IsChapterEditingEnabled="True" PreserveViewportOnRootChange="True" Root="{Binding Workbench.Root}" EnableMotion="{Binding Layout.EnableMotion}"
          LayoutKind="{Binding Workbench.MapLayoutKind}" StyleKind="{Binding Workbench.MapStyleKind}"
          MinZoom="{Binding Workbench.MapZoomFloor}" MaxZoom="{Binding Workbench.MapZoomCeiling}"
          CanvasBrush="Transparent" CardBrush="{DynamicResource VexPanelBackgroundBrush}" TextBrush="{DynamicResource VexValueBrush}"
          LineBrush="{DynamicResource VexPanelBorderBrush}" DotBrush="{DynamicResource VexPanelBorderBrush}"/>
      <StackPanel Orientation="Horizontal" Spacing="15" Margin="16,13" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="7" Height="7" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource VexAccentBrush}"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBHeadingNode}}" Classes="wb-muted"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="7" Height="7" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource VexMutedBrush}"/><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBContentNode}}" Classes="wb-muted"/></StackPanel>
      </StackPanel>
      <TextBlock x:Name="MapHint" Text="{i18n:I18n Vex.VexL.WSMapGesture}" Classes="wb-muted" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,14" IsHitTestVisible="False"/>
      <Border x:Name="SettingsTarget" Width="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18,12,18,18" Classes="wb-popover" Padding="18" IsVisible="{Binding Workbench.ShowMapSettings}">
        <ScrollViewer MaxHeight="420"><StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{i18n:I18n Vex.VexL.WBMapDisplay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="vex-dismiss" Command="{Binding Workbench.ToggleMapSettings}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/></Grid>
          <Grid ColumnDefinitions="*,64" ColumnSpacing="7">
            <TextBlock Text="{i18n:I18n {x:Static l:VexL.WBSummary}}" FontSize="11" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" x:Name="SummaryLengthInput" Minimum="1" Maximum="120" Increment="1" Value="{Binding Workbench.SummaryLength, Mode=TwoWay}"/>
          </Grid>
          <TextBlock Text="{i18n:I18n {x:Static l:VexL.WBSummaryHint}}" TextWrapping="Wrap" Classes="wb-muted"/>
          <StackPanel Spacing="4">
            <CheckBox Content="{i18n:I18n {x:Static l:VexL.WBParagraphs}}" IsChecked="{Binding Workbench.ShowParagraphs, Mode=TwoWay}" FontSize="11"/>
            <CheckBox Content="{i18n:I18n {x:Static l:VexL.WBLists}}" IsChecked="{Binding Workbench.ShowLists, Mode=TwoWay}" FontSize="11"/>
            <CheckBox Content="{i18n:I18n {x:Static l:VexL.WBRichBlocks}}" IsChecked="{Binding Workbench.ShowRichBlocks, Mode=TwoWay}" FontSize="11"/>
          </StackPanel>
          <Border Background="{DynamicResource VexAccentSoftBrush}" Padding="12" CornerRadius="6"><StackPanel Spacing="7"><TextBlock Text="{i18n:I18n {x:Static l:VexL.WBSummaryPreview}}" Classes="wb-muted"/><TextBlock Text="{Binding Workbench.SummaryPreview}" TextWrapping="Wrap" FontSize="11" LineHeight="20"/></StackPanel></Border>
          <Button x:Name="ResetMapSettingsButton" Content="{i18n:I18n {x:Static l:VexL.WBReset}}" Classes="wb-quiet" Command="{Binding Workbench.ResetMapSettings}" HorizontalAlignment="Right"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="NodeInspector" Width="282" MaxHeight="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,9,10,60" Classes="wb-popover" IsVisible="{Binding Workbench.HasSelectedNode}">
        <Grid RowDefinitions="36,*,36">
          <Border Padding="14,0,6,0" BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Workbench.SelectedKindLabel}" Classes="wb-muted" VerticalAlignment="Center"/><Button x:Name="CloseInspectorButton" Grid.Column="1" Classes="vex-dismiss" Command="{Binding Workbench.CloseInspector}" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.Close}}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}"/></Grid></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
            <StackPanel Spacing="10">
              <StackPanel Spacing="8" IsVisible="{Binding Workbench.IsChapterSelected}">
                <TextBlock Text="{i18n:I18n Vex.VexL.WSTitle}" Classes="wb-muted"/>
                <TextBox x:Name="ChapterTitleInput" Text="{Binding Workbench.ChapterTitle, Mode=OneWay}" LostFocus="TitleLostFocus" KeyDown="TitleKeyDown"/>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSSibling}" Tag="sibling" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSChild}" Tag="child" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSPromote}" Tag="promote" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSDemote}" Tag="demote" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSUp}" Tag="up" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSDown}" Tag="down" Click="ChapterClick"/>
                  <Button Classes="wb-quiet" Content="{i18n:I18n Vex.VexL.WSDeleteChapter}" Tag="delete" Click="ChapterClick"/>
                </WrapPanel>
                <TextBlock Text="{i18n:I18n Vex.VexL.WSBody}" Classes="wb-muted"/>
                <TextBox x:Name="ChapterBodyInput" Text="{Binding Workbench.ChapterBody, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" LostFocus="BodyLostFocus"/>
                <TextBlock Text="{i18n:I18n Vex.VexL.WSBodyHint}" Classes="wb-muted" TextWrapping="Wrap"/>
              </StackPanel>
              <SelectableTextBlock Text="{Binding Workbench.SelectedFullText}" IsVisible="{Binding !Workbench.IsChapterSelected}" TextWrapping="Wrap" FontSize="12" LineHeight="21"/>
              <TextBlock Text="{Binding Workbench.ChapterError}" Classes="wb-muted" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Padding="14,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Workbench.SelectedSourceLabel}" Classes="wb-muted" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{i18n:I18n {x:Static l:VexL.WBLocate}}" Command="{Binding Workbench.LocateSelectedSource}" Classes="wb-quiet"/></Grid></Border>
        </Grid>
      </Border>
      <Canvas x:Name="RenameLayer" IsVisible="False"><TextBox x:Name="InlineChapterTitle" MinHeight="30" Padding="8,3" KeyDown="InlineTitleKeyDown" LostFocus="InlineTitleLostFocus"/></Canvas>
      <Border x:Name="ChapterDeleteLayer" IsVisible="False" Background="#44000000">
        <Border Classes="wb-popover" Width="360" MaxWidth="500" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="{i18n:I18n Vex.VexL.WSDeleteChapter}" FontWeight="SemiBold" FontSize="17"/>
            <TextBlock x:Name="DeleteChapterName" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock Text="{i18n:I18n Vex.VexL.WSDeleteHint}" Classes="wb-muted" TextWrapping="Wrap"/>
            <CheckBox x:Name="KeepChapterContent" Content="{i18n:I18n Vex.VexL.WSKeepContent}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button x:Name="CancelDeleteChapter" Content="{i18n:I18n Vex.VexL.Cancel}" Click="CancelDeleteClick"/>
              <Button x:Name="ConfirmDeleteChapter" Content="{i18n:I18n Vex.VexL.WSDeleteChapter}" Classes="danger" Click="ConfirmDeleteClick"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
      <!-- 原型 .map-controls：导图画布右下角的悬浮缩放坞（1–200，步长 1，还原钮=适应画布）。
           纵向交给 BottomAxis 按令牌 vex-axis-view 把坞中心拉回底部轴线；横向 12/31 由视图模型按右栏显隐让位。 -->
      <vex:VexZoomDock x:Name="MapZoomDock"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          IsVisible="{Binding !Workbench.IsPresenting}"
          Margin="{Binding Workbench.MapDockMargin}"
          Minimum="1"
          Maximum="200"
          Step="1"
          Value="{Binding Workbench.MapZoomPercent, Mode=TwoWay}"
          Label="{i18n:I18n {x:Static l:VexL.ZoomMap}}"
          ResetLabel="{i18n:I18n {x:Static l:VexL.WBFit}}"
          ResetGeometry="{StaticResource WBFitIcon}"
          codewf:BottomAxis.CenterFromBottom="19" />
    </Grid>
  </Grid>
</UserControl>
