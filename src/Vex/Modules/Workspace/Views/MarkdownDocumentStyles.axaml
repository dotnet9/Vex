<Styles xmlns="https://github.com/avaloniaui" xmlns:md="https://codewf.com"
        xmlns:layout="clr-namespace:CodeWF.Avalonia.Markdown.Rendering;assembly=CodeWF.Avalonia.Markdown.Lite">

        <Style Selector="md|MarkdownViewer">
            <Setter Property="ShowCodeBlockHeader" Value="False"/>
            <Setter Property="CodeFontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, JetBrains Mono, Microsoft YaHei UI, monospace"/>
        </Style>

        <Style Selector="Button.MdCopyButton">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple] Border.MdH1Border">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="0 0 0 22" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="Margin" Value="0 6 0 10" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple] Border.MdH2Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0 28 0 20" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple] Border.MdH3Border">
            <Setter Property="Margin" Value="0 16 0 8" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple] Border.MdQuote">
            <Setter Property="BorderThickness" Value="3 0 0 0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="Padding" Value="14 6" />
            <Setter Property="Margin" Value="0 10" />
            <Setter Property="CornerRadius" Value="0 8 8 0" />
        </Style>
        <Style Selector="CheckBox.MdTaskMarkerBox">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TaskBox" Width="14" Height="14" CornerRadius="3"
                            BorderThickness="1" BorderBrush="{DynamicResource VexPanelBorderBrush}"
                            Background="{DynamicResource VexPanelBackgroundBrush}">
                        <Path Name="TaskTick" Width="10" Height="8" Stretch="Uniform"
                              Data="M1 4l3 3 5-6" Stroke="White" StrokeThickness="2"
                              IsVisible="{TemplateBinding IsChecked}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.MdTaskMarkerBox:checked /template/ Border#TaskBox">
            <Setter Property="Background" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple]">
            <Setter Property="ContentFontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC"/>
            <Setter Property="TextBrush" Value="{DynamicResource VexValueBrush}" />
            <Setter Property="MutedTextBrush" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="AccentBrush" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="QuoteBackgroundBrush" Value="{DynamicResource VexQuoteBackgroundBrush}" />
            <Setter Property="CodeBackgroundBrush" Value="{DynamicResource TextBlockCodeBackground}" />
            <Setter Property="InlineCodeBackgroundBrush" Value="{DynamicResource TextBlockCodeBackground}" />
            <Setter Property="BorderLineBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="ParagraphFontSize" Value="14.5" />
            <Setter Property="ParagraphLineHeight" Value="28" />
            <Setter Property="Heading1FontSize" Value="26" />
            <Setter Property="Heading2FontSize" Value="21" />
            <Setter Property="Heading3FontSize" Value="17" />
            <Setter Property="ParagraphMargin" Value="0 8" />
            <Setter Property="HeadingMargin" Value="0 6 0 10" />
            <Setter Property="BlockSpacing" Value="7" />
        </Style>
        <Style Selector="md|MarkdownViewer">
            <Setter Property="TableHeaderBackgroundBrush" Value="{DynamicResource VexTableHeaderBrush}" />
        </Style>
        <Style Selector="md|MarkdownLiveEditorView">
            <Setter Property="TableHeaderBackgroundBrush" Value="{DynamicResource VexTableHeaderBrush}" />
        </Style>
        <Style Selector="md|MarkdownViewer Grid.MdTable, md|MarkdownLiveEditorView Grid.MdTable">
            <Setter Property="layout:MarkdownTableLayout.FillAvailableWidth" Value="True" />
        </Style>
        <Style Selector="md|MarkdownViewer Border.MdTableContainer, md|MarkdownLiveEditorView Border.MdTableContainer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexTableBorderBrush}" />
        </Style>
        <Style Selector="md|MarkdownViewer Border.MdTableCell, md|MarkdownViewer Border.MdTableHeaderCell, md|MarkdownLiveEditorView Border.MdTableCell, md|MarkdownLiveEditorView Border.MdTableHeaderCell">
            <Setter Property="BorderBrush" Value="{DynamicResource VexTableBorderBrush}" />
        </Style>
        <Style Selector="md|MarkdownViewer Border.MdTableAlternateCell, md|MarkdownLiveEditorView Border.MdTableAlternateCell">
            <Setter Property="Background" Value="{DynamicResource VexTableStripeBrush}" />
        </Style>
        <!-- 选区可读性：默认浅色选区底 + 芯片浅色文字会撞色，选中时强制深色前景。 -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionForegroundBrush" Value="#1D2129" />
        </Style>

        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small]">
            <Setter Property="ParagraphFontSize" Value="13"/><Setter Property="ParagraphLineHeight" Value="22"/>
            <Setter Property="Heading1FontSize" Value="24"/><Setter Property="Heading2FontSize" Value="19"/><Setter Property="ParagraphMargin" Value="0 5"/>
        </Style>

        <!-- 阅读视图使用更紧凑的段间留白，与原型的连续文档排版一致。 -->
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple]">
            <Setter Property="BlockSpacing" Value="0"/><Setter Property="ParagraphMargin" Value="0 4"/>
            <Setter Property="UnorderedListMarkerWidth" Value="14"/>
        </Style>
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple] StackPanel.MdList">
            <Setter Property="Margin" Value="0 8 0 4"/><Setter Property="Spacing" Value="0"/>
        </Style>
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple] Grid.MdListItem">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple] Border.MdH1Border">
            <Setter Property="Margin" Value="0 6 0 17"/>
        </Style>
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple] Border.MdH2Border">
            <Setter Property="Margin" Value="0 25 0 12"/>
        </Style>
        <Style Selector="md|MarkdownViewer.reading-flow[TypographyTheme=Simple] Border.MdH3Border">
            <Setter Property="Margin" Value="0 16 0 13"/>
        </Style>

        <!-- 即时编辑的每个块独立排版，按原型的行高与上下留白累计，不额外插入块间距。 -->
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple]">
            <Setter Property="ParagraphLineHeight" Value="28.275"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] Border.MdH1Border">
            <Setter Property="Margin" Value="0 6 0 18"/><Setter Property="Padding" Value="0 0 0 14"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] SelectableTextBlock.MdH1">
            <Setter Property="LineHeight" Value="50.7"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] Border.MdH2Border">
            <Setter Property="Margin" Value="0 26 0 12"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] SelectableTextBlock.MdH2">
            <Setter Property="LineHeight" Value="40.95"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] Border.MdH3Border">
            <Setter Property="Margin" Value="0 18 0 10"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple] SelectableTextBlock.MdH3">
            <Setter Property="LineHeight" Value="33.15"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small]">
            <Setter Property="ParagraphLineHeight" Value="21.45"/>
            <Setter Property="ParagraphMargin" Value="0 8"/>
            <Setter Property="Heading1FontSize" Value="26"/><Setter Property="Heading2FontSize" Value="21"/><Setter Property="Heading3FontSize" Value="17"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small] SelectableTextBlock.MdH1">
            <Setter Property="LineHeight" Value="42.9"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small] SelectableTextBlock.MdH2">
            <Setter Property="LineHeight" Value="34.65"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small] SelectableTextBlock.MdH3">
            <Setter Property="LineHeight" Value="28.05"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small] Border.MdH2Border">
            <Setter Property="Margin" Value="0 18 0 7"/>
        </Style>
        <Style Selector="md|MarkdownLiveEditorView md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Small] Border.MdH3Border">
            <Setter Property="Margin" Value="0 12 0 6"/>
        </Style>
</Styles>
