<UserControl
    x:Class="Vex.Modules.Workspace.Views.MarkdownPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="https://codewf.com" xmlns:codewf="https://codewf.com"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:vex="clr-namespace:Vex.Controls;assembly=Vex.Controls"
    xmlns:vm="using:Vex.Modules.Workspace.ViewModels"
    xmlns:views="using:Vex.Modules.Workspace.Views"
    x:DataType="vm:MarkdownPreviewViewModel"
   >

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource VexPreviewBackgroundBrush}">
        <!-- 预览窗格头：标注窗格身份 + 当前排版主题（对应原型 .pane-head + .kbd）。
             工作台组合布局下由 WorkspaceViewController 统一提供窗格头，此处作为独立使用时的兜底。 -->
        <!-- 原型单窗格阅读视图不显示窗格头（workspace.css:10），组合布局由控制器的 view-heading 承担。 -->
        <Border x:Name="PaneHeader" Classes="pane-head" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path
                        Classes="stroke-ico"
                        Width="12"
                        Height="12"
                        Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                    <TextBlock Classes="pane-title" Text="{i18n:I18n {x:Static l:VexL.PreviewPaneTitle}}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="kbd-chip">
                    <TextBlock Text="{Binding TypographyTheme, TargetNullValue=Basic}" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer
            x:Name="PreviewScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" Focusable="True">
            <!-- 包裹层：ScrollViewer 会拉伸直接子级，居中限宽需交给内层 Grid 的对齐处理。 -->
            <Grid HorizontalAlignment="Stretch">
            <LayoutTransformControl x:Name="DocumentTransform">
            <!-- 原型 .reading-scroll .md-body 内边距实测 30/52/88（探针 workspace-chrome.css:375，写作字号档）；
                 底部不再为悬浮状态栏留白——状态栏已改通栏占位行（B4-14）。 -->
            <md:MarkdownViewer
                x:Name="PreviewMarkdownViewer"
                IsTaskEditingEnabled="{Binding IsTaskEditingEnabled}"
                Margin="52,30,52,88"
                ImageBasePath="{Binding ImageBasePath}"
                Markdown="{Binding Markdown}"
                SyntaxOptions="{Binding Preferences.SyntaxOptions}"
                ContentFontFamily="{Binding Preferences.ContentFontFamily}"
                ParagraphFontSize="{Binding BodyFontSize}"
                CodeBlockFontSize="{Binding Preferences.CodeFontSize}"
                CodeBlockWrap="{Binding Preferences.CodeWrap}"
                TypographySize="{Binding TypographySize}"
                TypographyTheme="{Binding TypographyTheme}" />
            </LayoutTransformControl>
            </Grid>
        </ScrollViewer>
        <views:WatermarkOverlay Grid.Row="1" IsVisible="{Binding Preferences.WatermarkPreview}"
                                Text="{Binding Preferences.WatermarkText}" Strength="{Binding Preferences.WatermarkOpacity}"
                                FontSize="{Binding Preferences.WatermarkFontSize}" HexInk="{Binding Preferences.WatermarkColor}"
                                WeightValue="{Binding Preferences.WatermarkWeight}" />
        <!-- 原型 .reading-zoom：阅读窗格右下角的悬浮缩放坞（50–200，步长 5，还原回 100）。
             纵向不写死底距，交给 BottomAxis 按令牌 vex-axis-view 把坞中心拉回底部轴线；横向 12/31 由视图模型按右栏显隐让位。 -->
        <vex:VexZoomDock
            x:Name="ReadingZoomDock"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsVisible="{Binding ShowReadingDock}"
            Margin="{Binding ReadingDockMargin}"
            Minimum="50"
            Maximum="200"
            Step="5"
            Value="{Binding Preferences.ContentZoom, Mode=TwoWay}"
            Label="{i18n:I18n {x:Static l:VexL.PrefZoom}}"
            ResetLabel="{i18n:I18n {x:Static l:VexL.ZoomRestoreFont}}"
            ResetGeometry="{StaticResource WBFitIcon}"
            codewf:BottomAxis.CenterFromBottom="19" />
    </Grid>


</UserControl>
