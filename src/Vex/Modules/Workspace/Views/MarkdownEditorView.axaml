<UserControl
    x:Class="Vex.Modules.Workspace.Views.MarkdownEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Vex.Core.Messaging"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:CodeWF.Avalonia.Markdown.Editor.Controls"
    xmlns:i18n="https://codewf.com"
    xmlns:icons="using:Vex.Controls"
    xmlns:l="clr-namespace:Vex"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Vex.Modules.Workspace.Services"
    xmlns:vm="using:Vex.Modules.Workspace.ViewModels"
    x:DataType="vm:MarkdownEditorViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="SourceHeader" Classes="pane-head">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path
                        Classes="stroke-ico"
                        Width="12"
                        Height="12"
                        Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
                    <TextBlock Classes="pane-title" Text="{i18n:I18n {x:Static l:VexL.SourcePaneTitle}}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="kbd-chip">
                    <TextBlock Text="Markdown" />
                </Border>
            </Grid>
        </Border>

        <!-- 编辑器控件来自 CodeWF.Avalonia.Markdown（库内维护），Vex 只负责右键菜单与消息桥接。
             右键菜单转发 Shell 编辑动作，实际文本变更由库控件执行后经消息通道回抛。 -->
        <editor:MarkdownEditorView x:Name="MarkdownEditor" Grid.Row="1"
            HighlightCurrentLine="False"
            EditorPadding="22 12 24 94"
            EditorLineHeight="26.25"
            EditorBackgroundKey="VexEditorBackgroundBrush"
            EditorForegroundKey="VexEditorForegroundBrush"
            CurrentLineBackgroundKey="VexEditorCurrentLineBackgroundBrush"
            CurrentLineBorderKey="VexEditorCurrentLineBorderBrush"
            AccentKey="VexAccentBrush" LinkKey="VexLinkBrush" ImageKey="VexImageBrush"
            CodeKey="VexCodeFgBrush" QuoteKey="VexQuoteBrush"
            SeparatorKey="VexPanelBorderBrush" DangerKey="VexDangerBrush" WarningKey="VexWarningBrush">
            <editor:MarkdownEditorView.ContextMenu>
                <ContextMenu>
                    <MenuItem icons:MenuIconCatalog.Key="undo" Header="{i18n:I18n {x:Static l:VexL.Undo}}" Command="{Binding Undo}" />
                    <MenuItem icons:MenuIconCatalog.Key="redo" Header="{i18n:I18n {x:Static l:VexL.Redo}}" Command="{Binding Redo}" />
                    <Separator />
                    <MenuItem icons:MenuIconCatalog.Key="cut" Header="{i18n:I18n {x:Static l:VexL.Cut}}" Command="{Binding Cut}" />
                    <MenuItem icons:MenuIconCatalog.Key="copy" Header="{i18n:I18n {x:Static l:VexL.Copy}}" Command="{Binding Copy}" />
                    <MenuItem icons:MenuIconCatalog.Key="clipboard" Header="{i18n:I18n {x:Static l:VexL.Paste}}" Command="{Binding Paste}" />
                    <MenuItem icons:MenuIconCatalog.Key="clipboard" Command="{Binding PasteAsPlainTextAsync}" Header="{i18n:I18n Vex.VexL.PastePlainText}" />
                    <MenuItem icons:MenuIconCatalog.Key="square-dashed" Header="{i18n:I18n {x:Static l:VexL.SelectAll}}" Command="{Binding SelectAll}" />
                    <MenuItem icons:MenuIconCatalog.Key="copy" Click="OnCopyPlainTextClick" Header="{i18n:I18n {x:Static l:VexL.CopyPlainText}}" />
                    <Separator />
                    <MenuItem icons:MenuIconCatalog.Key="replace" Header="{i18n:I18n Vex.VexL.ElementMenuConvertTo}">
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Paragraph}" Header="{i18n:I18n {x:Static l:VexL.Paragraph}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading1}" Header="{i18n:I18n {x:Static l:VexL.Heading1}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading2}" Header="{i18n:I18n {x:Static l:VexL.Heading2}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading3}" Header="{i18n:I18n {x:Static l:VexL.Heading3}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading4}" Header="{i18n:I18n {x:Static l:VexL.Heading4}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading5}" Header="{i18n:I18n {x:Static l:VexL.Heading5}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading6}" Header="{i18n:I18n {x:Static l:VexL.Heading6}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" Header="{i18n:I18n {x:Static l:VexL.Quote}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" Header="{i18n:I18n {x:Static l:VexL.UnorderedList}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.OrderedList}" Header="{i18n:I18n {x:Static l:VexL.OrderedList}}" />
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" Header="{i18n:I18n {x:Static l:VexL.TaskList}}" />
                    </MenuItem>
                    <MenuItem icons:MenuIconCatalog.Key="table" Header="{i18n:I18n {x:Static l:VexL.Table}}">
                        <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Table}" Header="{i18n:I18n {x:Static l:VexL.InsertTable}}" />
                        <Separator />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.RowAbove}" Header="{i18n:I18n Vex.VexL.TableRowAbove}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.RowBelow}" Header="{i18n:I18n Vex.VexL.TableRowBelow}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.ColBefore}" Header="{i18n:I18n Vex.VexL.TableColumnBefore}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.ColAfter}" Header="{i18n:I18n Vex.VexL.TableColumnAfter}" />
                        <Separator />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.RowUp}" Header="{i18n:I18n Vex.VexL.TableRowUp}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.RowDown}" Header="{i18n:I18n Vex.VexL.TableRowDown}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.ColLeft}" Header="{i18n:I18n Vex.VexL.TableColumnLeft}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.ColRight}" Header="{i18n:I18n Vex.VexL.TableColumnRight}" />
                        <Separator />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.AlignLeft}" Header="{i18n:I18n Vex.VexL.TableColumnAlignLeft}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.AlignCenter}" Header="{i18n:I18n Vex.VexL.TableColumnAlignCenter}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.AlignRight}" Header="{i18n:I18n Vex.VexL.TableColumnAlignRight}" />
                        <Separator />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.RowDelete}" Header="{i18n:I18n Vex.VexL.TableRowDelete}" />
                        <MenuItem Command="{Binding TableAction}" CommandParameter="{x:Static core:MarkdownTableAction.ColDelete}" Header="{i18n:I18n Vex.VexL.TableColumnDelete}" />
                        <Separator />
                        <MenuItem icons:MenuIconCatalog.Key="table" Command="{Binding FormatTable}" Header="{i18n:I18n Vex.VexL.TableFormat}" />
                        <MenuItem icons:MenuIconCatalog.Key="trash" Command="{Binding DeleteBlock}" Header="{i18n:I18n Vex.VexL.TableDelete}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem icons:MenuIconCatalog.Key="arrow-up-to-line" Command="{Binding InsertParagraphAbove}" Header="{i18n:I18n Vex.VexL.InsertParagraphAbove}" />
                    <MenuItem icons:MenuIconCatalog.Key="arrow-down-to-line" Command="{Binding InsertParagraphBelow}" Header="{i18n:I18n Vex.VexL.InsertParagraphBelow}" />
                    <MenuItem icons:MenuIconCatalog.Key="list-check" Command="{Binding ToggleTask}" Header="{i18n:I18n Vex.VexL.ToggleTask}" />
                    <MenuItem icons:MenuIconCatalog.Key="copy" Command="{Binding CopyBlock}" Header="{i18n:I18n Vex.VexL.CopyBlock}" />
                    <MenuItem icons:MenuIconCatalog.Key="trash" Command="{Binding DeleteBlock}" Header="{i18n:I18n Vex.VexL.DeleteBlock}" />
                    <Separator />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.ClearFormatting}" Header="{i18n:I18n {x:Static l:VexL.ClearFormatting}}" />
                </ContextMenu>
            </editor:MarkdownEditorView.ContextMenu>
        </editor:MarkdownEditorView>
    </Grid>
</UserControl>
