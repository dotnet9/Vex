<UserControl
    x:Class="Vex.Modules.Workspace.Views.MarkdownEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Vex.Core.Messaging"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:CodeWF.Avalonia.Markdown.Editor.Controls"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="using:Vex.Modules.Workspace.ViewModels"
    x:DataType="vm:MarkdownEditorViewModel"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <Border Classes="pane-head">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path
                        Classes="stroke-ico"
                        Width="12"
                        Height="12"
                        Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
                    <TextBlock Classes="pane-title" Text="{i18n:I18n {x:Static l:VexL.SourcePaneTitle}}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="kbd-chip">
                    <TextBlock Text="Markdown" />
                </Border>
            </Grid>
        </Border>

        <!-- 编辑器控件来自 CodeWF.Avalonia.Markdown（库内维护），Vex 只负责右键菜单与消息桥接。
             右键菜单转发 Shell 编辑动作，实际文本变更由库控件执行后经消息通道回抛。 -->
        <editor:MarkdownEditorView x:Name="MarkdownEditor" Grid.Row="1"
            EditorPadding="6 16 16 16"
            EditorLineHeight="21.875"
            EditorBackgroundKey="VexEditorBackgroundBrush"
            EditorForegroundKey="VexEditorForegroundBrush"
            CurrentLineBackgroundKey="VexEditorCurrentLineBackgroundBrush"
            CurrentLineBorderKey="VexEditorCurrentLineBorderBrush"
            AccentKey="VexAccentBrush" LinkKey="VexLinkBrush" ImageKey="VexImageBrush"
            CodeKey="VexCodeFgBrush" QuoteKey="VexQuoteBrush"
            SeparatorKey="VexPanelBorderBrush" DangerKey="VexDangerBrush" WarningKey="VexWarningBrush">
            <editor:MarkdownEditorView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.Undo}}" Command="{Binding Undo}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.Redo}}" Command="{Binding Redo}" />
                    <Separator />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.Cut}}" Command="{Binding Cut}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.Copy}}" Command="{Binding Copy}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.Paste}}" Command="{Binding Paste}" />
                    <MenuItem Header="{i18n:I18n {x:Static l:VexL.SelectAll}}" Command="{Binding SelectAll}" />
                    <MenuItem Click="OnCopyPlainTextClick" Header="{i18n:I18n {x:Static l:VexL.CopyPlainText}}" />
                    <Separator />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Bold}" Header="{i18n:I18n {x:Static l:VexL.Bold}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Italic}" Header="{i18n:I18n {x:Static l:VexL.Italic}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.InlineCode}" Header="{i18n:I18n {x:Static l:VexL.InlineCode}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Link}" Header="{i18n:I18n {x:Static l:VexL.Link}}" />
                    <Separator />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Heading1}" Header="{i18n:I18n {x:Static l:VexL.Heading1}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.Quote}" Header="{i18n:I18n {x:Static l:VexL.Quote}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.UnorderedList}" Header="{i18n:I18n {x:Static l:VexL.UnorderedList}}" />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.TaskList}" Header="{i18n:I18n {x:Static l:VexL.TaskList}}" />
                    <Separator />
                    <MenuItem Command="{Binding InsertAction}" CommandParameter="{x:Static core:EditorActionKind.ClearFormatting}" Header="{i18n:I18n {x:Static l:VexL.ClearFormatting}}" />
                </ContextMenu>
            </editor:MarkdownEditorView.ContextMenu>
        </editor:MarkdownEditorView>
    </Grid>
</UserControl>
