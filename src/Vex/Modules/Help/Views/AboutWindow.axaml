<u:UrsaWindow
    x:Class="Vex.Modules.Help.Views.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="https://codewf.com"
    xmlns:l="clr-namespace:Vex"
    xmlns:u="https://irihi.tech/ursa"
    Title="{i18n:I18n {x:Static l:VexL.AboutVexTitle}}"
    Width="420"
    Height="370"
    MinWidth="380"
    MinHeight="340"
    CanMaximize="False"
    CanMinimize="False"
    CanResize="False"
    Icon="/Assets/logo.ico"
    IsFullScreenButtonVisible="False"
    IsMinimizeButtonVisible="False"
    IsRestoreButtonVisible="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <u:UrsaWindow.LeftContent>
        <TextBlock
            Classes="titlebar-text"
            FontSize="13"
            FontWeight="SemiBold"
            Margin="12 7 0 0"
            Text="{i18n:I18n {x:Static l:VexL.AboutVexTitle}}"
            VerticalAlignment="Center" />
    </u:UrsaWindow.LeftContent>

    <Border
        Background="{DynamicResource VexPanelBackgroundBrush}"
        Padding="24 50 24 24">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Image Width="40" Height="40" Source="/Assets/logo.png" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{i18n:I18n {x:Static l:VexL.AppName}}" />
                    <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.Slogan}}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="9"
                ColumnSpacing="16">
                <TextBlock Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutChineseNameLabel}}" />
                <TextBlock Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.ChineseName}}" />
                <TextBlock Grid.Row="1" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutVersionLabel}}" />
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="10 1"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource VexAccentSoftBrush}"
                    CornerRadius="9">
                    <TextBlock
                        x:Name="VersionText"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource VexAccentBrush}" />
                </Border>
                <TextBlock Grid.Row="2" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutCompileTimeLabel}}" />
                <TextBlock x:Name="CompileTimeText" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutAuthorLabel}}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.AboutAuthorName}}" />
                <TextBlock Grid.Row="4" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutWebsiteLabel}}" />
                <TextBlock
                    x:Name="WebsiteLink"
                    Grid.Row="4"
                    Grid.Column="1"
                    Cursor="Hand"
                    Foreground="{DynamicResource VexLinkBrush}"
                    PointerPressed="WebsiteLink_OnPointerPressed"
                    Text="https://codewf.com"
                    TextDecorations="Underline" />
                <TextBlock Grid.Row="5" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutBrandLabel}}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{i18n:I18n {x:Static l:VexL.AboutBrandName}}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="6" Classes="muted" Text="{i18n:I18n {x:Static l:VexL.AboutCheckUpdateLabel}}" />
                <TextBlock
                    x:Name="CheckUpdateLink"
                    Grid.Row="6"
                    Grid.Column="1"
                    Cursor="Hand"
                    Foreground="{DynamicResource VexLinkBrush}"
                    PointerPressed="CheckUpdateLink_OnPointerPressed"
                    TextDecorations="Underline"
                    Text="{i18n:I18n {x:Static l:VexL.AboutCheckUpdate}}" />
            </Grid>

            <TextBlock
                x:Name="CheckUpdateResultText"
                Grid.Row="2"
                Classes="muted"
                TextWrapping="Wrap"
                Text="{i18n:I18n {x:Static l:VexL.AboutDescription}}" />
        </Grid>
    </Border>
</u:UrsaWindow>
