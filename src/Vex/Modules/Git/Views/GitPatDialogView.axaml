<UserControl x:Class="Vex.Modules.Git.Views.GitPatDialogView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Git.ViewModels" x:DataType="vm:GitPatDialogViewModel">
    <!-- HTTPS 远程推送拉取所需的访问令牌（PAT）输入层；令牌仅存本机凭据管理器。 -->
    <Border Classes="dialog-card" Width="480" Padding="0" CornerRadius="8" ClipToBounds="True">
        <StackPanel>
            <Border Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <Grid ColumnDefinitions="*,46" Height="36" VerticalAlignment="Center">
                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitPatTitle}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Command="{Binding Cancel}"
                            helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Close}}"
                            AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}" />
                </Grid>
            </Border>
            <StackPanel Margin="20,16,20,8" Spacing="10">
                <TextBox x:Name="PatBox" Classes="template-input" PlaceholderText="{i18n:I18n {x:Static l:VexL.GitPatTitle}}"
                         Text="{Binding Token}" PasswordChar="•" RevealPassword="False"
                         AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitPatTitle}}" />
                <TextBlock FontSize="12" LineHeight="19.2" TextWrapping="Wrap" Foreground="{DynamicResource VexMutedBrush}"
                           Text="{i18n:I18n {x:Static l:VexL.GitPatNote}}" />
                <CheckBox x:Name="RememberPatCheck" Content="{i18n:I18n {x:Static l:VexL.GitPatRemember}}"
                          IsChecked="{Binding Remember}" IsThreeState="False" />
            </StackPanel>
            <Border Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Classes="btn" Content="{i18n:I18n {x:Static l:VexL.Cancel}}" Command="{Binding Cancel}" />
                    <Button x:Name="SavePatButton" Classes="btn primary" Content="{i18n:I18n {x:Static l:VexL.GitRemoteSave}}"
                            Command="{Binding Save}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitRemoteSave}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
