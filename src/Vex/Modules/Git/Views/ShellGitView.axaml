<UserControl x:Class="Vex.Modules.Git.Views.ShellGitView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Git.ViewModels" x:DataType="vm:ShellGitViewModel">
    <!-- 原型 .git-workspace：全客户区面板，背景取面板色，左缘 1px 发丝线（rail 已自带给右缘的 1px）。 -->
    <UserControl.Styles>
        <!-- 分隔把手本体透明：1px 视觉缝由 git-left 右边框承担，把手只负责命中。 -->
        <Style Selector="GridSplitter.git-splitter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- 顶栏：44px，仓库 | 分支 | 拉取+上次同步 | 远程芯片 -->
        <Style Selector="Border.git-topbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexHairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.git-topbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.git-topbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="Button.git-topbtn Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button.git-topbtn Path.chevron">
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="TextBlock.git-topname">
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.git-syncsmall">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 芯片：远程协议 / 领先落后（原型 .git-chip） -->
        <Style Selector="Border.git-chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
        </Style>
        <Style Selector="Border.git-chip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <Style Selector="Border.git-chip.warn">
            <Setter Property="BorderBrush" Value="{DynamicResource VexWarningBrush}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource VexWarningBrush}" />
            </Style>
        </Style>
        <!-- 主体左右两栏（原型 .git-main：minmax(300px,38%) + 1fr） -->
        <Style Selector="Border.git-left">
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <!-- 页签（原型 .git-tab：36px 等宽、下边 2px 指示条） -->
        <Style Selector="ToggleButton.git-tab">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ToggleButton.git-tab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.git-tab:checked">
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.git-badge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Border.git-badge TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <!-- 筛选行（原型 .git-filter） -->
        <Style Selector="Border.git-filter">
            <Setter Property="Margin" Value="10,8" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Border.git-filter Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="TextBox.git-filter-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.git-filter-dim">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <!-- 列表行（原型 .git-row：30px 起步、hover/selected 同款） -->
        <Style Selector="ListBox.git-list">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.git-row">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,5,12,5" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.git-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem.git-row:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
        </Style>
        <!-- 文件状态描边标志（原型 .git-status：18×18 圆角描边小方框） -->
        <Style Selector="Border.git-status">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.git-status TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.git-status.m">
            <Setter Property="BorderBrush" Value="{DynamicResource VexWarningBrush}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource VexWarningBrush}" />
            </Style>
        </Style>
        <Style Selector="Border.git-status.a">
            <Setter Property="BorderBrush" Value="{DynamicResource VexSuccessBrush}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource VexSuccessBrush}" />
            </Style>
        </Style>
        <Style Selector="Border.git-status.d">
            <Setter Property="BorderBrush" Value="{DynamicResource VexDangerBrush}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource VexDangerBrush}" />
            </Style>
        </Style>
        <!-- 路径：目录灰、文件名正常（原型 .git-path .dir） -->
        <Style Selector="TextBlock.git-dir">
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <!-- 提交行（原型 .commit-item） -->
        <Style Selector="TextBlock.commit-subject">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.commit-meta">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.hash">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="Border.git-tag">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Border.git-tag TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <!-- 提交区（原型 .git-commit-box：底部铬面） -->
        <Style Selector="Border.git-commit-box">
            <Setter Property="Padding" Value="12,10,12,12" />
            <Setter Property="Background" Value="{DynamicResource VexChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!-- 文件头快捷栏（原型 .git-file-head） -->
        <Style Selector="Border.git-file-head">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TextBlock.git-file-path">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.stat-add">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource VexSuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-del">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource VexDangerBrush}" />
        </Style>
        <Style Selector="Button.git-diff-options-btn">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.git-diff-options-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.git-diff-options-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VexHoverBrush}" />
        </Style>
        <Style Selector="Button.git-diff-options-btn Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Button.git-diff-options-btn Path.chev">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
        <!-- Hunk 头（原型 .git-hunk-head） -->
        <Style Selector="Border.git-hunk-head">
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.git-hunk-head TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <!-- Diff 行（原型 .git-diff-row：unified 38/38/18/弹性列，11.5px 等宽 1.7 行高） -->
        <Style Selector="Border.git-diff TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="19.5" />
        </Style>
        <Style Selector="TextBlock.lno">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.sign">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.dtext">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0,0,14,0" />
        </Style>
        <Style Selector="Border.git-diff-row.add">
            <Setter Property="Background" Value="{DynamicResource VexSuccessSoftBrush}" />
        </Style>
        <Style Selector="Border.git-diff-row.del">
            <Setter Property="Background" Value="{DynamicResource VexDangerSoftBrush}" />
        </Style>
        <Style Selector="Border.git-diff-row.add TextBlock.sign">
            <Setter Property="Foreground" Value="{DynamicResource VexSuccessBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.git-diff-row.del TextBlock.sign">
            <Setter Property="Foreground" Value="{DynamicResource VexDangerBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.git-split-row">
            <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
        </Style>
        <Style Selector="Border.git-cell-empty">
            <Setter Property="Background" Value="{DynamicResource VexCodeBackgroundBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- 空态（原型 .git-blank） -->
        <Style Selector="TextBlock.git-blank-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style Selector="Path.git-blank-ico">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <!-- 空仓库英雄区（原型 .git-empty-hero） -->
        <Style Selector="Border.git-empty-ico">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.git-empty-ico Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="TextBlock.git-empty-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.git-empty-desc">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="21.6" />
            <Setter Property="Foreground" Value="{DynamicResource VexMutedBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource VexPanelBackgroundBrush}">
        <!-- ===== 顶栏 ===== -->
        <Border Classes="git-topbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                <!-- 有仓库：仓库钮（开远程弹层）+ 分支钮；无仓库：静态未初始化 -->
                <Button x:Name="RepoButton" Classes="git-topbtn" IsVisible="{Binding HasRepo}"
                        Command="{Binding OpenRemoteDialogAsync}"
                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.GitModifyRemoteTip}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitModifyRemoteTip}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGitBranchIcon}" /></Canvas></Viewbox>
                        <TextBlock Classes="git-topname" Text="{Binding RepoName}" />
                        <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Classes="chevron" Data="M6 9L12 15L18 9" /></Canvas></Viewbox>
                    </StackPanel>
                </Button>
                <!-- 分支钮：弹 tag 菜单（原型 branch 下拉：打 tag/推送 tag；分支管理占位）。
                     打 tag 需要输入名称：直接在 Flyout 内嵌输入区（名称+同时推送+创建）。 -->
                <Button x:Name="BranchButton" Grid.Column="1" Classes="git-topbtn" IsVisible="{Binding HasRepo}"
                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.GitBranchManagementToast}}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitBranchManagementToast}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGitBranchIcon}" /></Canvas></Viewbox>
                        <TextBlock Classes="git-topname" Text="{Binding BranchName}" />
                        <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Classes="chevron" Data="M6 9L12 15L18 9" /></Canvas></Viewbox>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel MinWidth="240" Spacing="8">
                                <TextBox x:Name="TagNameBox" Watermark="{i18n:I18n {x:Static l:VexL.GitTagNamePlaceholder}}"
                                         Text="{Binding NewTagName, Mode=TwoWay}"
                                         AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitTagNamePlaceholder}}" />
                                <CheckBox x:Name="TagAlsoPush" Content="{i18n:I18n {x:Static l:VexL.GitTagAlsoPush}}"
                                          IsChecked="{Binding TagAlsoPush, Mode=TwoWay}" />
                                <Button x:Name="CreateTagButton" Classes="btn primary" HorizontalAlignment="Stretch"
                                        Content="{i18n:I18n {x:Static l:VexL.GitTagCreate}}"
                                        Command="{Binding CreateTagCommand}" CommandParameter="{Binding NewTagName}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="PullButton" Grid.Column="2" Classes="git-topbtn" IsVisible="{Binding HasRepo}" IsEnabled="{Binding CanPull}"
                        Command="{Binding PullAsync}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitPull}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBDownloadIcon}" /></Canvas></Viewbox>
                        <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitPull}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3" Classes="git-syncsmall" IsVisible="{Binding HasRepo}" VerticalAlignment="Center">
                    <Run Text="{i18n:I18n {x:Static l:VexL.GitLastSync}}" /><Run Text=" " /><Run Text="{Binding LastSyncDisplay, Mode=OneWay}" />
                </TextBlock>
                <Panel Grid.Column="4" />
                <!-- 远程芯片（SSH 警示）或 添加远程按钮；领先落后芯片 -->
                <Border x:Name="RemoteChip" Grid.Column="5" Classes="git-chip" Classes.warn="{Binding IsSshRemote}" IsVisible="{Binding HasRemote}" VerticalAlignment="Center"
                        ToolTip.Tip="{i18n:I18n {x:Static l:VexL.GitRemoteSshTip}}">
                    <TextBlock Text="{Binding RemoteChipText}" />
                </Border>
                <Button x:Name="AddRemoteButton" Grid.Column="5" Classes="git-topbtn" IsVisible="{Binding !HasRemote}"
                        Command="{Binding OpenRemoteDialogAsync}"
                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitAddRemote}}">
                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitAddRemote}}" VerticalAlignment="Center" />
                </Button>
                <Border Grid.Column="6" Classes="git-chip" IsVisible="{Binding HasSyncDelta}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SyncChipText}" />
                </Border>
            </Grid>
        </Border>

        <!-- ===== 主体：无仓库英雄区 / 有仓库双栏 ===== -->
        <Panel Grid.Row="1">
            <!-- 空仓库英雄区 -->
            <StackPanel IsVisible="{Binding !HasRepo}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Margin="30,40">
                <Border Classes="git-empty-ico">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGitBranchIcon}" /></Canvas></Viewbox>
                </Border>
                <TextBlock Classes="git-empty-title" Text="{i18n:I18n {x:Static l:VexL.GitEmptyTitle}}" />
                <TextBlock Classes="git-empty-desc" Text="{i18n:I18n {x:Static l:VexL.GitEmptyDescription}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
                    <Button x:Name="InitRepoButton" Classes="btn primary" Command="{Binding InitRepositoryAsync}"
                            Content="{i18n:I18n {x:Static l:VexL.GitInitButton}}"
                            AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitInitButton}}" />
                    <Button x:Name="EmptyAddRemoteButton" Classes="btn" Command="{Binding OpenRemoteDialogAsync}"
                            Content="{i18n:I18n {x:Static l:VexL.GitAddRemote}}"
                            AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitAddRemote}}" />
                </StackPanel>
            </StackPanel>

            <!-- 有仓库：左列（页签+列表+提交区）| 右列（diff） -->
            <Grid IsVisible="{Binding HasRepo}">
                <Grid.ColumnDefinitions>
                    <!-- 左列宽可拖拽（原型 minmax(300px,38%)）：宽度是唯一尺寸来源，双向绑定进 VM。 -->
                    <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}" MinWidth="260" MaxWidth="640" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- ===== 左列 ===== -->
                <Border Classes="git-left">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,*">
                            <ToggleButton x:Name="ChangesTabButton" Classes="git-tab" IsChecked="{Binding IsChangesTab, Mode=OneWay}"
                                          Command="{Binding ShowChangesTab}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitChangesTab}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitChangesTab}}" VerticalAlignment="Center" />
                                    <Border Classes="git-badge" IsVisible="{Binding HasChanges}"><TextBlock Text="{Binding Changes.Count}" /></Border>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="HistoryTabButton" Grid.Column="1" Classes="git-tab" IsChecked="{Binding IsHistoryTab, Mode=OneWay}"
                                          Command="{Binding ShowHistoryTab}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitHistoryTab}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitHistoryTab}}" VerticalAlignment="Center" />
                                    <Border Classes="git-badge"><TextBlock Text="{Binding History.Count}" /></Border>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <Panel Grid.Row="1">
                            <!-- Changes 页签 -->
                            <Grid IsVisible="{Binding IsChangesTab}" RowDefinitions="Auto,Auto,*,Auto">
                                <Border Classes="git-filter">
                                    <Grid ColumnDefinitions="13,*,16" ColumnSpacing="7">
                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBSearchIcon}" /></Canvas></Viewbox>
                                        <TextBox x:Name="ChangeFilterBox" Grid.Column="1" Classes="git-filter-input"
                                                 PlaceholderText="{i18n:I18n {x:Static l:VexL.GitFilterPlaceholder}}"
                                                 Text="{Binding FilterText}"
                                                 AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitFilterLabel}}" />
                                    </Grid>
                                </Border>
                                <!-- 全选行 -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="14,0,14,6" IsVisible="{Binding HasChanges}">
                                    <CheckBox x:Name="StageAllCheck" IsChecked="{Binding AllChecked, Mode=TwoWay}"
                                              AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitSelectAll}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                               Foreground="{DynamicResource VexMutedBrush}" Text="{Binding ChangeCountText}" />
                                </Grid>
                                <!-- 变更列表 / 干净空态 -->
                                <Panel Grid.Row="2">
                                    <ListBox x:Name="ChangesList" Classes="git-list" ItemsSource="{Binding VisibleChanges}"
                                             SelectedItem="{Binding SelectedChange}" Margin="0,0,0,4">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{i18n:I18n {x:Static l:VexL.GitOpenInExplorer}}"
                                                          Command="{Binding OpenChangeInExplorerCommand}"
                                                          CommandParameter="{Binding SelectedChange}" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GitChangeItem">
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                    <CheckBox IsChecked="{Binding Checked}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Path}" />
                                                    <Border Grid.Column="1" Classes="git-status" Classes.m="{Binding IsModified}" Classes.a="{Binding IsAdded}"
                                                            Classes.d="{Binding IsDeleted}" Classes.u="{Binding IsUntracked}"
                                                            ToolTip.Tip="{Binding StatusText}">
                                                        <Panel>
                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding IsModified}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Text="+" IsVisible="{Binding IsAdded}" />
                                                            <TextBlock Text="−" IsVisible="{Binding IsDeleted}" />
                                                            <TextBlock Text="?" IsVisible="{Binding IsUntracked}" />
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Dir, Mode=OneWay}" Foreground="{DynamicResource VexMutedBrush}" /><Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                                IsVisible="{Binding IsCleanWorkdir}">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="git-blank-ico" Data="{StaticResource WBCheckIcon}" /></Canvas></Viewbox>
                                        <TextBlock Classes="git-blank-text" Text="{i18n:I18n {x:Static l:VexL.GitCleanWorkdir}}" />
                                    </StackPanel>
                                </Panel>
                                <!-- 提交区 -->
                                <Border Grid.Row="3" Classes="git-commit-box">
                                    <StackPanel Spacing="8">
                                        <TextBox x:Name="CommitSummaryBox" PlaceholderText="{i18n:I18n {x:Static l:VexL.GitSummaryPlaceholder}}"
                                                 Text="{Binding Summary}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitCommitSummaryLabel}}" />
                                        <TextBox x:Name="CommitDescriptionBox" PlaceholderText="{i18n:I18n {x:Static l:VexL.GitDescriptionPlaceholder}}"
                                                 Text="{Binding Description}" MinHeight="64" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                                 AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitCommitDescriptionLabel}}" />
                                        <Button x:Name="CommitButton" Classes="btn primary" HorizontalAlignment="Stretch"
                                                Command="{Binding CommitAsync}" IsEnabled="{Binding CanCommit}"
                                                Content="{Binding CommitButtonText}"
                                                AutomationProperties.Name="{Binding CommitButtonText}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button x:Name="PushButton" Classes="btn" Command="{Binding PushAsync}" IsEnabled="{Binding CanPush}"
                                                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitPush}}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Classes="stroke-ico" Data="{StaticResource WBExportIcon}" /></Canvas></Viewbox>
                                                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitPush}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource VexMutedBrush}"
                                                       VerticalAlignment="Center" Text="{Binding PushHint}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- History 页签 -->
                            <Grid IsVisible="{Binding IsHistoryTab}" RowDefinitions="Auto,*,Auto">
                                <Border Classes="git-filter git-filter-dim" ToolTip.Tip="{i18n:I18n {x:Static l:VexL.GitBranchCompareTip}}">
                                    <Grid ColumnDefinitions="13,*" ColumnSpacing="7">
                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGitBranchIcon}" /></Canvas></Viewbox>
                                        <TextBox Classes="git-filter-input" IsEnabled="False"
                                                 PlaceholderText="{i18n:I18n {x:Static l:VexL.GitCompareBranchPlaceholder}}"
                                                 AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitCompareBranchLabel}}" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="HistoryList" Grid.Row="1" Classes="git-list" ItemsSource="{Binding History}"
                                         SelectedItem="{Binding SelectedCommit}" Margin="0,4,0,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GitCommitItem">
                                            <StackPanel Margin="0,3" Spacing="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Classes="commit-subject" Text="{Binding Subject}" />
                                                    <Border Classes="git-tag" IsVisible="{Binding HasTag}"><TextBlock Text="{Binding Tag}" /></Border>
                                                </StackPanel>
                                                <TextBlock Classes="commit-meta" Text="{Binding MetaText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" Classes="git-blank-text" Margin="16,12" HorizontalAlignment="Center"
                                           IsVisible="{Binding IsHistoryEmpty}" Text="{i18n:I18n {x:Static l:VexL.GitNoCommits}}" />
                            </Grid>
                        </Panel>
                    </Grid>
                </Border>

                <!-- 分隔把手：视觉 1px 缝由 git-left 右边框承担，负外边距把命中扩到缝两侧（sidebar-splitter 同款）。 -->
                <GridSplitter Grid.Column="1" Classes="git-splitter" Width="11" Margin="-5,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False" />
                <!-- ===== 右列：Changes 选中文件 diff / History 提交详情（画布色与左柱面板区分） ===== -->
                <Panel Grid.Column="2" Background="{DynamicResource VexWorkspaceCanvasBrush}">
                    <!-- Changes 页签右区 -->
                    <Grid IsVisible="{Binding IsChangesTab}" RowDefinitions="Auto,Auto,*,Auto">
                        <!-- 文件头快捷栏 -->
                        <Border Classes="git-file-head" IsVisible="{Binding HasDiffSelection}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Border Classes="git-status" Classes.m="{Binding SelectedChange.IsModified}" Classes.a="{Binding SelectedChange.IsAdded}"
                                        Classes.d="{Binding SelectedChange.IsDeleted}" Classes.u="{Binding SelectedChange.IsUntracked}">
                                    <Panel>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding SelectedChange.IsModified}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="+" IsVisible="{Binding SelectedChange.IsAdded}" />
                                        <TextBlock Text="−" IsVisible="{Binding SelectedChange.IsDeleted}" />
                                        <TextBlock Text="?" IsVisible="{Binding SelectedChange.IsUntracked}" />
                                    </Panel>
                                </Border>
                                <TextBlock Grid.Column="1" Classes="git-file-path" Text="{Binding SelectedChange.Path}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Classes="stat-add" Text="{Binding DiffAddedText}" />
                                    <TextBlock Classes="stat-del" Text="{Binding DiffDeletedText}" />
                                </StackPanel>
                                <Button x:Name="DiffOptionsButton" Grid.Column="3" Classes="git-diff-options-btn" VerticalAlignment="Center"
                                        AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitDiffOptions}}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGearIcon}" /></Canvas></Viewbox>
                                        <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Classes="chev" Data="M6 9L12 15L18 9" /></Canvas></Viewbox>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel MinWidth="212" Spacing="2">
                                                <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitDiffMode}}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VexMutedBrush}" Margin="0,2,0,6" />
                                                <RadioButton Content="Unified" GroupName="GitDiffMode" IsChecked="{Binding IsUnified, Mode=OneWay}"
                                                             Command="{Binding SetDiffModeCommand}" CommandParameter="Unified" />
                                                <RadioButton Content="Split" GroupName="GitDiffMode" IsChecked="{Binding IsSplit, Mode=OneWay}"
                                                             Command="{Binding SetDiffModeCommand}" CommandParameter="Split" />
                                                <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitWhitespace}}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VexMutedBrush}" Margin="0,10,0,6" />
                                                <CheckBox Content="{i18n:I18n {x:Static l:VexL.GitHideWhitespace}}" IsChecked="{Binding HideWhitespace, Mode=TwoWay}"
                                                          AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitHideWhitespace}}" />
                                                <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitHideWhitespaceNote}}" FontSize="10.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource VexMutedBrush}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- 文件状态标志（与列表一致，右侧重复一枚，原型 git-head-status） -->
                                <Border Grid.Column="4" Classes="git-status" Margin="6,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding SelectedChange.StatusText}"
                                        Classes.m="{Binding SelectedChange.IsModified}" Classes.a="{Binding SelectedChange.IsAdded}"
                                        Classes.d="{Binding SelectedChange.IsDeleted}" Classes.u="{Binding SelectedChange.IsUntracked}">
                                    <Panel>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding SelectedChange.IsModified}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="+" IsVisible="{Binding SelectedChange.IsAdded}" />
                                        <TextBlock Text="−" IsVisible="{Binding SelectedChange.IsDeleted}" />
                                        <TextBlock Text="?" IsVisible="{Binding SelectedChange.IsUntracked}" />
                                    </Panel>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Hunk 头 -->
                        <Border Grid.Row="1" Classes="git-hunk-head" IsVisible="{Binding HasDiffText}">
                            <TextBlock Text="{Binding DiffHeaderText}" />
                        </Border>
                        <!-- Unified / Split 双 Diff -->
                        <Border Grid.Row="2" Classes="git-diff" IsVisible="{Binding HasDiffText}">
                            <!-- GHD 口径：diff 不横向滚动，长行 pre-wrap 换行；Split 两栏严格等分依赖有限宽度约束。 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Panel>
                                    <ItemsControl x:Name="UnifiedDiff" ItemsSource="{Binding UnifiedRows}" IsVisible="{Binding IsUnified}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GitDiffRow">
                                                <Border Classes="git-diff-row" Classes.add="{Binding IsAdded}" Classes.del="{Binding IsDeleted}">
                                                    <Grid ColumnDefinitions="38,38,18,*">
                                                        <TextBlock Classes="lno" Text="{Binding LeftNumberText}" />
                                                        <TextBlock Grid.Column="1" Classes="lno" Text="{Binding RightNumberText}" />
                                                        <TextBlock Grid.Column="2" Classes="sign" Text="{Binding DisplaySign}" />
                                                        <TextBlock Grid.Column="3" Classes="dtext" Text="{Binding Text}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="SplitDiff" ItemsSource="{Binding SplitRows}" IsVisible="{Binding IsSplit}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GitDiffPairRow">
                                                <Grid ColumnDefinitions="*,*" Classes="git-split-row-inner">
                                                    <Border Classes="git-diff-row" Classes.del="{Binding Left.IsDeleted}" Classes.git-cell-empty="{Binding Left.IsEmpty}"
                                                            BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                                                        <Grid ColumnDefinitions="38,*">
                                                            <TextBlock Classes="lno" Text="{Binding Left.NumberText}" />
                                                            <TextBlock Grid.Column="1" Classes="dtext" Text="{Binding Left.Text}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Column="1" Classes="git-diff-row" Classes.add="{Binding Right.IsAdded}" Classes.git-cell-empty="{Binding Right.IsEmpty}" ClipToBounds="True">
                                                        <Grid ColumnDefinitions="38,*">
                                                            <TextBlock Classes="lno" Text="{Binding Right.NumberText}" />
                                                            <TextBlock Grid.Column="1" Classes="dtext" Text="{Binding Right.Text}" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Panel>
                            </ScrollViewer>
                        </Border>
                        <!-- 未选中 / 二进制占位 -->
                        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding ShowChangeBlank}">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="git-blank-ico" Data="{StaticResource WBColumnsIcon}" /></Canvas></Viewbox>
                            <TextBlock Classes="git-blank-text" Text="{Binding ChangeBlankText}" />
                        </StackPanel>
                    </Grid>

                    <!-- History 页签右区 -->
                    <Grid IsVisible="{Binding IsHistoryTab}">
                        <Grid IsVisible="{Binding HasCommitDetail}" RowDefinitions="Auto,*">
                            <!-- 提交详情头 -->
                            <Border Classes="git-file-head" Padding="16,12">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="commit-subject" Text="{Binding CommitSubject}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="stroke-ico" Data="{StaticResource WBGitBranchIcon}" /></Canvas></Viewbox>
                                        <TextBlock Classes="commit-meta" Text="{Binding CommitMeta}" VerticalAlignment="Center" />
                                        <TextBlock Classes="stat-add" Text="{Binding CommitAddedText}" VerticalAlignment="Center" />
                                        <TextBlock Classes="stat-del" Text="{Binding CommitDeletedText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- [文件列表 | diff] 两栏：文件列表宽可拖拽（原型 minmax(220px,288px)）。 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CommitFileListWidth, Mode=TwoWay}" MinWidth="200" MaxWidth="440" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border Classes="git-file-head" Padding="12,8" Background="{DynamicResource VexChromeBrush}">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource VexMutedBrush}" Text="{Binding CommitFileCountText}" />
                                        </Border>
                                        <ListBox Grid.Row="1" Classes="git-list" ItemsSource="{Binding CommitFiles}"
                                                 SelectedItem="{Binding SelectedCommitFile}">
                                                <ListBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{i18n:I18n {x:Static l:VexL.GitOpenInExplorer}}"
                                                                  Command="{Binding OpenCommitFileInExplorerCommand}"
                                                                  CommandParameter="{Binding SelectedCommitFile}" />
                                                    </ContextMenu>
                                                </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GitCommitFileItem">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <Border Classes="git-status" Classes.m="{Binding IsModified}" Classes.a="{Binding IsAdded}"
                                                                Classes.d="{Binding IsDeleted}" Classes.u="{Binding IsUntracked}">
                                                            <Panel>
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding IsModified}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock Text="+" IsVisible="{Binding IsAdded}" />
                                                                <TextBlock Text="−" IsVisible="{Binding IsDeleted}" />
                                                                <TextBlock Text="?" IsVisible="{Binding IsUntracked}" />
                                                            </Panel>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Path}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <!-- 分隔把手：视觉缝由文件列表右边框承担，命中负边距外扩。 -->
                                <GridSplitter Grid.Column="1" Classes="git-splitter" Width="11" Margin="-5,0"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False" />
                                <!-- 右侧 diff 列 -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
                                    <Border Classes="git-file-head" IsVisible="{Binding HasCommitFileSelection}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <Border Classes="git-status" Classes.m="{Binding SelectedCommitFile.IsModified}" Classes.a="{Binding SelectedCommitFile.IsAdded}"
                                                    Classes.d="{Binding SelectedCommitFile.IsDeleted}" Classes.u="{Binding SelectedCommitFile.IsUntracked}">
                                                <Panel>
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource VexWarningBrush}" IsVisible="{Binding SelectedCommitFile.IsModified}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="+" IsVisible="{Binding SelectedCommitFile.IsAdded}" />
                                                    <TextBlock Text="−" IsVisible="{Binding SelectedCommitFile.IsDeleted}" />
                                                    <TextBlock Text="?" IsVisible="{Binding SelectedCommitFile.IsUntracked}" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="git-file-path" Text="{Binding SelectedCommitFile.Path}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Classes="stat-add" Text="{Binding DiffAddedText}" />
                                                <TextBlock Classes="stat-del" Text="{Binding DiffDeletedText}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="git-diff-options-btn" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitDiffOptions}}">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource WBGearIcon}" /></Canvas></Viewbox>
                                                    <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Classes="chev" Data="M6 9L12 15L18 9" /></Canvas></Viewbox>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <StackPanel MinWidth="212" Spacing="2">
                                                            <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitDiffMode}}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource VexMutedBrush}" Margin="0,2,0,6" />
                                                            <RadioButton Content="Unified" GroupName="GitDiffMode2" IsChecked="{Binding IsUnified, Mode=OneWay}"
                                                                       Command="{Binding SetDiffModeCommand}" CommandParameter="Unified" />
                                                            <RadioButton Content="Split" GroupName="GitDiffMode2" IsChecked="{Binding IsSplit, Mode=OneWay}"
                                                                       Command="{Binding SetDiffModeCommand}" CommandParameter="Split" />
                                                            <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitWhitespace}}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource VexMutedBrush}" Margin="0,10,0,6" />
                                                            <CheckBox Content="{i18n:I18n {x:Static l:VexL.GitHideWhitespace}}" IsChecked="{Binding HideWhitespace, Mode=TwoWay}" />
                                                            <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitHideWhitespaceNote}}" FontSize="10.5" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource VexMutedBrush}" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Classes="git-hunk-head" IsVisible="{Binding HasCommitFileDiffText}">
                                        <TextBlock Text="{Binding DiffHeaderText}" />
                                    </Border>
                                    <Border Grid.Row="2" Classes="git-diff" IsVisible="{Binding HasCommitFileDiffText}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <Panel>
                                                <ItemsControl ItemsSource="{Binding UnifiedRows}" IsVisible="{Binding IsUnified}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:GitDiffRow">
                                                            <Border Classes="git-diff-row" Classes.add="{Binding IsAdded}" Classes.del="{Binding IsDeleted}">
                                                                <Grid ColumnDefinitions="38,38,18,*">
                                                                    <TextBlock Classes="lno" Text="{Binding LeftNumberText}" />
                                                                    <TextBlock Grid.Column="1" Classes="lno" Text="{Binding RightNumberText}" />
                                                                    <TextBlock Grid.Column="2" Classes="sign" Text="{Binding DisplaySign}" />
                                                                    <TextBlock Grid.Column="3" Classes="dtext" Text="{Binding Text}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding SplitRows}" IsVisible="{Binding IsSplit}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:GitDiffPairRow">
                                                            <Grid ColumnDefinitions="*,*" Classes="git-split-row-inner">
                                                                <Border Classes="git-diff-row" Classes.del="{Binding Left.IsDeleted}" Classes.git-cell-empty="{Binding Left.IsEmpty}"
                                                                        BorderBrush="{DynamicResource VexPanelBorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                                                                    <Grid ColumnDefinitions="38,*">
                                                                        <TextBlock Classes="lno" Text="{Binding Left.NumberText}" />
                                                                        <TextBlock Grid.Column="1" Classes="dtext" Text="{Binding Left.Text}" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="1" Classes="git-diff-row" Classes.add="{Binding Right.IsAdded}" Classes.git-cell-empty="{Binding Right.IsEmpty}" ClipToBounds="True">
                                                                    <Grid ColumnDefinitions="38,*">
                                                                        <TextBlock Classes="lno" Text="{Binding Right.NumberText}" />
                                                                        <TextBlock Grid.Column="1" Classes="dtext" Text="{Binding Right.Text}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Panel>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                                IsVisible="{Binding ShowCommitFileBlank}">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="git-blank-ico" Data="{StaticResource WBColumnsIcon}" /></Canvas></Viewbox>
                                        <TextBlock Classes="git-blank-text" Text="{i18n:I18n {x:Static l:VexL.GitSelectCommitFileHint}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        <!-- 未选提交占位 -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding IsCommitBlank}">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="git-blank-ico" Data="{StaticResource WBSortClockIcon}" /></Canvas></Viewbox>
                            <TextBlock Classes="git-blank-text" Text="{i18n:I18n {x:Static l:VexL.GitSelectCommitHint}}" />
                        </StackPanel>
                    </Grid>
                </Panel>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
