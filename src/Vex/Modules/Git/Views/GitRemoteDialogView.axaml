<UserControl x:Class="Vex.Modules.Git.Views.GitRemoteDialogView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CodeWF.Avalonia.Controls.Helpers" xmlns:i18n="https://codewf.com" xmlns:l="clr-namespace:Vex"
    xmlns:vm="using:Vex.Modules.Git.ViewModels" x:DataType="vm:GitRemoteDialogViewModel">
    <!-- 原型 layer-git-remote：mini 窗 + mono 输入框 + 错误行 + 说明文案。 -->
    <Border Classes="dialog-card" Width="520" Padding="0" CornerRadius="8" ClipToBounds="True">
        <StackPanel>
            <Border Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <Grid ColumnDefinitions="*,46" Height="36" VerticalAlignment="Center">
                    <TextBlock Text="{i18n:I18n {x:Static l:VexL.GitRemoteDialogTitle}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="vex-dismiss" Width="46" Height="32" Command="{Binding Cancel}"
                            helpers:ToolTipHelper.Text="{i18n:I18n {x:Static l:VexL.Close}}"
                            AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.Close}}" />
                </Grid>
            </Border>
            <StackPanel Margin="20,16,20,8" Spacing="8">
                <TextBox x:Name="RemoteUrlBox" Classes="template-input" PlaceholderText="{i18n:I18n {x:Static l:VexL.GitRemoteUrlPlaceholder}}"
                         Text="{Binding Url}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12.5"
                         AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitRemoteDialogTitle}}" />
                <TextBlock x:Name="RemoteErrorText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource VexDangerBrush}"
                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                           AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitRemoteUrlError}}" />
                <TextBlock FontSize="12" LineHeight="19.2" TextWrapping="Wrap" Foreground="{DynamicResource VexMutedBrush}"
                           Margin="0,4,0,0" Text="{i18n:I18n {x:Static l:VexL.GitRemoteNote}}" />
            </StackPanel>
            <Border Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VexPanelBorderBrush}" Background="{DynamicResource VexShellBackgroundBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Classes="btn" Content="{i18n:I18n {x:Static l:VexL.Cancel}}" Command="{Binding Cancel}" />
                    <Button x:Name="SaveRemoteButton" Classes="btn primary" Content="{i18n:I18n {x:Static l:VexL.GitRemoteSave}}"
                            Command="{Binding Save}" AutomationProperties.Name="{i18n:I18n {x:Static l:VexL.GitRemoteSave}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
