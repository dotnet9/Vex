<u:UrsaWindow
    x:Class="Vex.Modules.Mcp.Views.McpOperationConfirmationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:views="using:Vex.Modules.Mcp.Views"
    x:DataType="views:McpOperationConfirmationWindowModel"
    Title="{Binding Title}"
    Width="520"
    Height="390"
    MinWidth="480"
    MinHeight="340"
    CanMaximize="False"
    CanMinimize="False"
    CanResize="False"
    Icon="/Assets/logo.ico"
    IsFullScreenButtonVisible="False"
    IsMinimizeButtonVisible="False"
    IsRestoreButtonVisible="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Border
        Background="{DynamicResource VexPanelBackgroundBrush}"
        Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="dlg-ico info">
                    <Path Classes="stroke-ico" Data="M4 17l6-6-6-6 M12 19h8" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15.5"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Classes="muted"
                Text="{Binding Message}"
                TextWrapping="Wrap" />
            <Border
                Grid.Row="2"
                Padding="12"
                Background="{DynamicResource TextBlockCodeBackground}"
                BorderBrush="{DynamicResource VexPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                VerticalAlignment="Top">
                <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                    <TextBlock Classes="muted" Text="Tool" />
                    <SelectableTextBlock Grid.Column="1" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" Text="{Binding ToolName}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Classes="muted" Text="Target" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" Text="{Binding Target}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Classes="muted" Text="Summary" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <CheckBox
                Grid.Row="3"
                Content="{Binding RememberChoiceText}"
                IsChecked="{Binding RememberChoice, Mode=TwoWay}" />
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Cancel_OnClick"
                    Content="{Binding CancelText}"
                    MinWidth="86" />
                <Button
                    Classes="primary"
                    Click="Confirm_OnClick"
                    Content="{Binding ConfirmText}"
                    MinWidth="86" />
            </StackPanel>
        </Grid>
    </Border>
</u:UrsaWindow>
