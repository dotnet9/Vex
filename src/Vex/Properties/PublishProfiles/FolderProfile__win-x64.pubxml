<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <LastUsedTargetFramework>net10.0-windows</LastUsedTargetFramework>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LastUsedRuntimeIdentifier>win-x64</LastUsedRuntimeIdentifier>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)FolderProfile.Common.props" />
  <PropertyGroup>
    <!-- 使用激进裁剪替代 Native AOT（Prism.Avalonia 不兼容） -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
