<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <LastUsedTargetFramework>$(RepositoryWindowsTargetFramework)</LastUsedTargetFramework>
    <TargetFramework>$(RepositoryWindowsTargetFramework)</TargetFramework>
    <LastUsedRuntimeIdentifier>win-x64</LastUsedRuntimeIdentifier>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)FolderProfile.Common.props" />
  <PropertyGroup>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
