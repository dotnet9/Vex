<Project>
  <PropertyGroup>
    <LastUsedTargetFramework>$(RepositoryTargetFramework)</LastUsedTargetFramework>
    <TargetFramework>$(RepositoryTargetFramework)</TargetFramework>
    <LastUsedRuntimeIdentifier>osx-arm64</LastUsedRuntimeIdentifier>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)FolderProfile.Common.props" />
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
