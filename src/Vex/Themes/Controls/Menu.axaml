<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 复用 Semi 的 ContextMenu/MenuItem 模板，只调整宿主菜单的版面与配色。 -->
    <Style Selector="MenuItem.wrap-entry.danger /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource VexDangerBrush}" />
    </Style>
    <Style Selector="MenuItem.wrap-entry.danger:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource VexDangerSoftBrush}" />
    </Style>
    <Style Selector="Menu.title-menu Separator"><Setter Property="Margin" Value="4,4" /><Setter Property="Height" Value="1" /></Style>
    <Style Selector="Menu.title-menu > MenuItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Padding" Value="6" /><Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style Selector="Menu.title-menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <!-- 原型 .tb-menu 的 2px 条目间距是栏级 gap（theme.css:136），不是条目外距：
             收进面板间距后，条目自身归零，收起/隐藏的那项也不留空档。 -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <!-- 对应原型 .tb-menuitem：28px 行高、10px 内边距、6px 圆角。 -->
    <Style Selector="Menu.title-menu > MenuItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10 0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Semi 按需折叠空状态列；无勾选项的菜单组用全角空白占住同宽图标列，保持文字起点一致。 -->
    <Style Selector="MenuItem#FileMenuItem MenuItem, MenuItem#InsertMenuItem MenuItem, MenuItem#FormatMenuItem MenuItem, MenuItem#HelpMenuItem MenuItem">
        <Setter Property="Icon" Value="&#x3000;" />
    </Style>

    <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemForeground}" />
    </Style>

    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemPointeroverForeground}" />
    </Style>

    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemPointeroverForeground}" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemPointeroverForeground}" />
    </Style>

    <!-- 原型 .menu/.flyout 与弹层同档（surface.css L2 实测 #fff 面、1px 发丝、8 圆角、菜单内距 6）。
          Fluent 的 FlyoutBackground 令牌跟着纸面走，配色偏米黄时菜单会跟着发褐，这里收到 VexPopBrush。 -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Width" Value="248" />
        <Setter Property="Background" Value="{DynamicResource VexPopBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusMd}" />
    </Style>

    <Style Selector="ContextMenu">
        <!-- 正文允许亚像素排版，原生弹窗仍须像素取整，避免不足 1px 的溢出触发菜单滚动箭头。 -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="248" />
        <Setter Property="FontFamily" Value="{DynamicResource ControlContentThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextBlock.LineHeight" Value="22.4" />
        <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}" />
        <Setter Property="Background" Value="{DynamicResource VexPopBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
    </Style>
    <!-- 正文的字号、行高可变；菜单不能继承标题或段落的行盒，否则弹窗首轮测量后会溢出。 -->
    <Style Selector="ContextMenu MenuItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ContextMenu MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
