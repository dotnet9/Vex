<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vex="clr-namespace:Vex.Controls">
    <Design.PreviewWith>
        <Panel Width="320" Height="120">
            <vex:VexZoomDock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                             Minimum="50" Maximum="200" Value="100" Label="内容缩放" ResetLabel="还原字号" />
        </Panel>
    </Design.PreviewWith>

    <!-- 原型 .vex-zoomdock（design/assets/prototype/prototype.css）的唯一原生配方：
         坞内只有拖动条与还原钮，百分比是拖动时才浮出的气泡（气泡位置由 VexZoomDock 代码按拖动块实测算）；
         高度/内缩/间距/条宽/钮高/图标/分隔线全部来自「界面密度」派生令牌，圆角走胶囊档。 -->
    <ControlTheme x:Key="{x:Type vex:VexZoomDock}" TargetType="vex:VexZoomDock">
        <Setter Property="Height" Value="{DynamicResource VexZoomDockHeight}" />
        <Setter Property="Padding" Value="{DynamicResource VexZoomDockPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource VexPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="vex:VexZoomDock">
                <!-- 坞面、条长、还原钮高都改由下面的主题样式给：模板属性是局部值，样式盖不住，
                     原型 .statusbar-zoom 那档脱壳配方（无边框无投影、条 72、钮 18）就没法覆盖浮空档。 -->
                <Border
                    Classes="zoomdock-face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource VexZoomDockGap}" VerticalAlignment="Center">
                        <!-- 原型 .zoom-tools 是气泡的定位父级：Canvas 与拖动条同框，气泡只跟着拖动块走。 -->
                        <Panel>
                            <Slider
                                Name="PART_Slider"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                SmallChange="{TemplateBinding Step}"
                                TickFrequency="{TemplateBinding Step}"
                                IsSnapToTickEnabled="True"
                                Value="{TemplateBinding Value, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource VexAccentBrush}"
                                Background="{DynamicResource VexPanelBorderBrush}"
                                ToolTip.Tip="{TemplateBinding Label}"
                                AutomationProperties.Name="{TemplateBinding Label}" />
                            <Canvas Name="PART_BubbleTrack" IsHitTestVisible="False">
                                <Border
                                    Name="PART_Bubble"
                                    Opacity="0"
                                    Padding="6,1"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{DynamicResource VexDensityCornerRadiusSm}"
                                    Background="{DynamicResource VexAccentBrush}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="{StaticResource MotionDurationFast}" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <TextBlock
                                        Name="PART_BubbleText"
                                        FontSize="{DynamicResource VexDensityFontSizeCaption}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StudioOnPrimary}" />
                                </Border>
                            </Canvas>
                        </Panel>
                        <!-- 原型 .zoom-reset 的那根左分隔线是绝对定位的伪元素（left:calc(gap*-1+1px)），不占布局位，
                             钮只带 3px 左距；实现同样把线叠在钮左沿之外，条与钮之间才是 gap 6 + 3。 -->
                        <Panel>
                            <Border
                                Classes="zoomdock-divider"
                                Width="1"
                                Height="{DynamicResource VexZoomDockDividerHeight}"
                                Opacity="0.7"
                                Margin="-5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource VexPanelBorderBrush}" />
                            <Button
                                Name="PART_Reset"
                                Classes="vex-zoom-reset"
                                Margin="3,0,0,0"
                                ToolTip.Tip="{TemplateBinding ResetLabel}"
                                AutomationProperties.Name="{TemplateBinding ResetLabel}">
                                <Path
                                    Width="{DynamicResource VexZoomDockIconSize}"
                                    Height="{DynamicResource VexZoomDockIconSize}"
                                    Data="{TemplateBinding ResetGeometry}"
                                    Stretch="Uniform"
                                    StrokeThickness="2"
                                    StrokeLineCap="Round"
                                    StrokeJoin="Round" />
                            </Button>
                        </Panel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- 原型 .zoom-reset：静默底、悬停铺 accent-soft 并转强调色；图标走 currentColor，即坞继承到的正文色。 -->
        <Style Selector="^ /template/ Button.vex-zoom-reset">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{DynamicResource VexZoomDockResetHeight}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource VexDensityCornerRadiusPill}" />
            <Setter Property="Foreground" Value="{DynamicResource VexValueBrush}" />
        </Style>
        <!-- 原型 .vex-zoomdock 浮空档的 shadow-pop；底栏那档（.statusbar-zoom .vex-zoomdock）在 Shell.axaml 里关掉。 -->
        <Style Selector="^ /template/ Border.zoomdock-face">
            <Setter Property="BoxShadow" Value="0 10 30 0 #22000000" />
        </Style>
        <!-- 原型 .zoom-range 的条长 = 控件中档高 × 1.875：按密度档折算，令牌随「界面密度」重算。 -->
        <Style Selector="^ /template/ Slider#PART_Slider">
            <Setter Property="Width" Value="{DynamicResource VexZoomDockSliderWidth}" />
        </Style>
        <Style Selector="^ /template/ Button.vex-zoom-reset Path">
            <Setter Property="Stroke" Value="{DynamicResource VexValueBrush}" />
        </Style>
        <!-- ControlTheme 内不允许连跨两层 /template/：悬停色直接设在钮上，由按钮模板的 TemplateBinding 落到内容层。 -->
        <Style Selector="^ /template/ Button.vex-zoom-reset:pointerover">
            <Setter Property="Background" Value="{DynamicResource VexAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VexAccentBrush}" />
        </Style>
        <Style Selector="^ /template/ Button.vex-zoom-reset:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource VexAccentBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
