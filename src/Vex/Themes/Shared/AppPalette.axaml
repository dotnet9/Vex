<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 独立控件主题保留浅深默认资源；Vex 应用在自身资源中映射共享 Studio 配色。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="VexShellBackgroundBrush" Color="#FFFDFDFD" />
            <SolidColorBrush x:Key="VexPanelBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VexPanelBorderBrush" Color="#E4E7EC" />
            <SolidColorBrush x:Key="VexSplitterBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="VexEditorBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VexEditorForegroundBrush" Color="#101828" />
            <SolidColorBrush x:Key="VexEditorCurrentLineBackgroundBrush" Color="#FFF4F7FB" />
            <SolidColorBrush x:Key="VexEditorCurrentLineBorderBrush" Color="#FFE4E9F2" />
            <SolidColorBrush x:Key="VexPreviewBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VexStatusBarBackgroundBrush" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="VexStatusBarBorderBrush" Color="#E4E7EC" />
            <SolidColorBrush x:Key="VexStatusBadgeBackgroundBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="VexStatusBadgeBorderBrush" Color="#D8DEE8" />
            <SolidColorBrush x:Key="VexStatusBadgeLabelBrush" Color="#667085" />
            <SolidColorBrush x:Key="VexStatusBadgeValueBrush" Color="#1D2939" />
            <SolidColorBrush x:Key="VexLinkBrush" Color="#1677FF" />
            <SolidColorBrush x:Key="VexImageBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="VexAccentBrush" Color="#1677FF" />
            <Color x:Key="VexAccentColor">#1677FF</Color>
            <SolidColorBrush x:Key="VexAccentSoftBrush" Color="#E8F1FF" />
            <SolidColorBrush x:Key="VexDangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="VexDangerSoftBrush" Color="#FEECEB" />
            <SolidColorBrush x:Key="VexSuccessBrush" Color="#067647" />
            <SolidColorBrush x:Key="VexSuccessSoftBrush" Color="#1A067647" />
            <SolidColorBrush x:Key="VexWarningBrush" Color="#B54708" />
            <SolidColorBrush x:Key="VexMutedBrush" Color="#667085" />
            <SolidColorBrush x:Key="VexValueBrush" Color="#1D2939" />
            <SolidColorBrush x:Key="VexDisabledBrush" Color="#98A2B3" />
            <SolidColorBrush x:Key="VexHoverBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="VexPressedBrush" Color="#E8F1FF" />
            <!-- 原型 .vex-segmented：轨道用 4% 前景混表面，指示块用 55% 白混表面。 -->
            <SolidColorBrush x:Key="VexSegmentedTrackBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="VexSegmentedThumbBrush" Color="#FDFDFE" />
            <SolidColorBrush x:Key="VexSegmentedThumbBorderBrush" Color="#00000000" />
            <LinearGradientBrush x:Key="VexTitleGradBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1677FF" Offset="0" />
                <GradientStop Color="#69B1FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="VexCodeFgBrush" Color="#B42318" />
            <SolidColorBrush x:Key="VexQuoteBrush" Color="#667085" />
            <SolidColorBrush x:Key="VexQuoteBackgroundBrush" Color="#0F1677FF" />
            <SolidColorBrush x:Key="VexMarkerBrush" Color="#98A2B3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="VexShellBackgroundBrush" Color="#111827" />
            <SolidColorBrush x:Key="VexPanelBackgroundBrush" Color="#151B26" />
            <SolidColorBrush x:Key="VexPanelBorderBrush" Color="#2B3443" />
            <SolidColorBrush x:Key="VexSplitterBrush" Color="#232B38" />
            <SolidColorBrush x:Key="VexEditorBackgroundBrush" Color="#111827" />
            <SolidColorBrush x:Key="VexEditorForegroundBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="VexEditorCurrentLineBackgroundBrush" Color="#1B2533" />
            <SolidColorBrush x:Key="VexEditorCurrentLineBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="VexPreviewBackgroundBrush" Color="#111827" />
            <SolidColorBrush x:Key="VexStatusBarBackgroundBrush" Color="#151B26" />
            <SolidColorBrush x:Key="VexStatusBarBorderBrush" Color="#2B3443" />
            <SolidColorBrush x:Key="VexStatusBadgeBackgroundBrush" Color="#1B2533" />
            <SolidColorBrush x:Key="VexStatusBadgeBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="VexStatusBadgeLabelBrush" Color="#AAB4C3" />
            <SolidColorBrush x:Key="VexStatusBadgeValueBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="VexLinkBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="VexImageBrush" Color="#C4B5FD" />
            <SolidColorBrush x:Key="VexAccentBrush" Color="#60A5FA" />
            <Color x:Key="VexAccentColor">#60A5FA</Color>
            <SolidColorBrush x:Key="VexAccentSoftBrush" Color="#1D3A5F" />
            <SolidColorBrush x:Key="VexDangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="VexDangerSoftBrush" Color="#3B1D23" />
            <SolidColorBrush x:Key="VexSuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="VexSuccessSoftBrush" Color="#1A4ADE80" />
            <SolidColorBrush x:Key="VexWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="VexMutedBrush" Color="#AAB4C3" />
            <SolidColorBrush x:Key="VexValueBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="VexDisabledBrush" Color="#7D8999" />
            <SolidColorBrush x:Key="VexHoverBrush" Color="#263244" />
            <SolidColorBrush x:Key="VexPressedBrush" Color="#1D3A5F" />
            <!-- 原型深色档：轨道 = 前景 4.5% 叠面板，指示块回到面板色，靠 1px 淡描边而不是投影。 -->
            <SolidColorBrush x:Key="VexSegmentedTrackBrush" Color="#263244" />
            <SolidColorBrush x:Key="VexSegmentedThumbBrush" Color="#151B26" />
            <SolidColorBrush x:Key="VexSegmentedThumbBorderBrush" Color="#12FFFFFF" />
            <LinearGradientBrush x:Key="VexTitleGradBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#60A5FA" Offset="0" />
                <GradientStop Color="#A5C8FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="VexCodeFgBrush" Color="#FBBF77" />
            <SolidColorBrush x:Key="VexQuoteBrush" Color="#AAB4C3" />
            <SolidColorBrush x:Key="VexQuoteBackgroundBrush" Color="#0F60A5FA" />
            <SolidColorBrush x:Key="VexMarkerBrush" Color="#7D8999" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
