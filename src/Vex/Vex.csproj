<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Title>Vex</Title>
    <Description>Vex Markdown editor.</Description>
    <PackageId>Vex</PackageId>
    <AssemblyName>Vex</AssemblyName>
    <RootNamespace>Vex</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <WindowsSupportedOSPlatformVersion>6.1</WindowsSupportedOSPlatformVersion>
    <IsTrimmable>true</IsTrimmable>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0' and '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Website" Value="$(PackageProjectUrl)" />
    <PackageReference Include="CodeWF.Toolkit.Core" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\FileIcons\**" />
    <Content Include="Assets\FileIcons\**\*" Link="file-icons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\logo.svg" Link="Assets\logo.svg" />
    <TrimmerRootDescriptor Include="Properties\Trimming\TrimmerRoots.xml" />
    <Content Include="..\..\docs\更新日志.md" Link="docs\更新日志.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\快速开始.md" Link="docs\快速开始.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\鸣谢.md" Link="docs\鸣谢.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\演示文档\**\*" Link="docs\演示文档\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 快速开始里的功能截图按相对路径引用；随包文档要在应用内离线看图，图片必须一起进包。 -->
    <Content Include="..\..\docs\图片\**\*.png" Link="docs\图片\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\register_vex_context_menu.ps1" Link="register_vex_context_menu.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\unregister_vex_context_menu.ps1" Link="unregister_vex_context_menu.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\mcp_stdio_bridge.py" Link="mcp_stdio_bridge.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CodeWF.Avalonia.Controls" />
    <PackageReference Include="CodeWF.Avalonia.DataGrid" />
    <PackageReference Include="CodeWF.Avalonia.MindView" />
    <PackageReference Include="CodeWF.Toolkit.EventBus" />
    <PackageReference Include="CodeWF.Avalonia.Markdown" />
    <PackageReference Include="CodeWF.Toolkit.Files" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.ColorPicker" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="VC-LTL" />
    <PackageReference Include="YY-Thunks" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <Compile Update="I18n\ReleaseTags.cs">
      <DependentUpon>ReleaseTags.tt</DependentUpon>
    </Compile>
    <None Update="I18n\ReleaseTags.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>ReleaseTags.cs</LastGenOutput>
    </None>
    <None Update="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>I18n\Vex\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
