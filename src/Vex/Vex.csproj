<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Title>Vex</Title>
    <Description>Vex Markdown editor.</Description>
    <PackageId>Vex</PackageId>
    <AssemblyName>Vex</AssemblyName>
    <RootNamespace>Vex</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <WindowsSupportedOSPlatformVersion>6.1</WindowsSupportedOSPlatformVersion>
    <IsTrimmable>true</IsTrimmable>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- 更激进的裁剪模式 -->
    <TrimMode>link</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- 运行时功能裁剪 -->
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- 如果只需要中文，可以启用此选项以进一步减小体积 -->
    <!-- <InvariantGlobalization>true</InvariantGlobalization> -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <!-- Native AOT 和 PublishSingleFile 互斥，优先使用 Native AOT -->
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' != 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishAot)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract Condition="'$(PublishAot)' != 'true'">true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- 排除本机库的 PDB 文件 -->
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true'">
    <!-- Native AOT 优化配置 - 由于 Prism/ReactiveUI/Avalonia 反射需求，暂时降低优化级别 -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <!-- 保留完整类型元数据以支持反射 -->
    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <IlcDisableReflection>false</IlcDisableReflection>
    <!-- 保留更多元数据 -->
    <IlcTrimMetadata>false</IlcTrimMetadata>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Website" Value="$(PackageProjectUrl)" />
    <PackageReference Include="CodeWF.Toolkit.Core" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\FileIcons\**" />
    <Content Include="Assets\FileIcons\**\*" Link="file-icons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <AvaloniaResource Include="..\..\assets\logo.ico" Link="Assets\logo.ico" />
    <AvaloniaResource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\assets\logo.svg" Link="Assets\logo.svg" />
    <TrimmerRootDescriptor Include="Properties\Trimming\TrimmerRoots.xml" />
    <Content Include="..\..\docs\项目管理\更新日志.md" Link="docs\更新日志.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(VexExcludePublishDocuments)' != 'true'" />
    <Content Include="..\..\docs\开发文档\快速开始.md" Link="docs\快速开始.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(VexExcludePublishDocuments)' != 'true'" />
    <Content Include="..\..\docs\项目管理\鸣谢.md" Link="docs\鸣谢.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(VexExcludePublishDocuments)' != 'true'" />
    <Content Include="..\..\docs\演示文档\**\*" Link="docs\演示文档\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(VexExcludePublishDocuments)' != 'true'" />
  </ItemGroup>

  <!-- Native AOT 配置：保留 Prism 完整元数据，绕过 DialogWindow 的反射绑定检查 -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Prism.Avalonia" />
    <TrimmerRootAssembly Include="Prism.DryIoc.Avalonia" />
    <TrimmerRootAssembly Include="DryIoc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CodeWF.Avalonia.Controls" />
    <PackageReference Include="CodeWF.Avalonia.MindView" />
    <PackageReference Include="CodeWF.Toolkit.EventBus" />
    <PackageReference Include="CodeWF.Avalonia.Markdown" />
    <PackageReference Include="CodeWF.Toolkit.Files" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
    <PackageReference Include="Prism.DryIoc.Avalonia" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.ColorPicker" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="VC-LTL" />
    <PackageReference Include="YY-Thunks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vex.Controls\Vex.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <None Update="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>I18n\Vex\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
