<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 与 StudioTheme 共用动态颜色令牌，不复制 Semi 的整套主题字典。 -->
    <SolidColorBrush x:Key="VexShellBackgroundBrush" Color="{DynamicResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="VexPanelBackgroundBrush" Color="{DynamicResource StudioPaperColor}" />
    <SolidColorBrush x:Key="VexPanelBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <!-- 原型 .view-heading 底边：border 65% 透明度。 -->
    <SolidColorBrush x:Key="VexPaneHeadBorderBrush" Color="{DynamicResource StudioBorderColor}" Opacity="0.65" />
    <!-- 原型 .app-window>.titlebar 底边：border 55% 透明度。 -->
    <SolidColorBrush x:Key="VexTitleDividerBrush" Color="{DynamicResource StudioBorderColor}" Opacity="0.55" />
    <!-- 原型 .app-window 画布底 = 块面（paper），明暗各按规则叠一层色把块顶出来，见下方明暗字典。 -->
    <SolidColorBrush x:Key="VexWorkspaceCanvasBrush" Color="{DynamicResource StudioPaperColor}" />
    <!-- 原型 .workspace 画布（块与块之间的底）：浅色 = 纸面掺 5% 墨，深色 = 纸面掺 30% 面板色。 -->
    <SolidColorBrush x:Key="VexEditorCurrentLineBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="VexStatusBarBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="VexStatusBadgeBorderBrush" Color="{DynamicResource StudioBorderColor}" />
    <SolidColorBrush x:Key="VexStatusBarBackgroundBrush" Color="{DynamicResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="VexStatusBadgeBackgroundBrush" Color="{DynamicResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="VexSplitterBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="VexEditorCurrentLineBackgroundBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="VexHoverBrush" Color="{DynamicResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="VexPressedBrush" Color="{DynamicResource StudioPressedColor}" />
    <SolidColorBrush x:Key="VexAccentSoftBrush" Color="{DynamicResource StudioSelectedColor}" />
    <SolidColorBrush x:Key="VexEditorForegroundBrush" Color="{DynamicResource StudioTextColor}" />
    <SolidColorBrush x:Key="VexStatusBadgeValueBrush" Color="{DynamicResource StudioTextColor}" />
    <SolidColorBrush x:Key="VexValueBrush" Color="{DynamicResource StudioTextColor}" />
    <SolidColorBrush x:Key="VexStatusBadgeLabelBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="VexMutedBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="VexDisabledBrush" Color="{DynamicResource StudioDisabledColor}" />
    <SolidColorBrush x:Key="VexQuoteBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="VexMarkerBrush" Color="{DynamicResource StudioMutedColor}" />
    <SolidColorBrush x:Key="VexAccentBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="VexLinkBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="VexImageBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="VexCodeFgBrush" Color="{DynamicResource StudioAccentColor}" />
    <SolidColorBrush x:Key="VexQuoteBackgroundBrush" Color="{DynamicResource StudioAccentColor}" Opacity="0.06" />
    <LinearGradientBrush x:Key="VexTitleGradBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{DynamicResource StudioGradientStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource StudioSecondaryColor}" Offset="1" />
    </LinearGradientBrush>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidForeground" Color="#302C3C" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidAccent" Color="#8B7CF6" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidDefault" Color="#8B7CF6" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidLine" Color="#777382" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidBorder" Color="#B8A7DF" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidSurface" Color="#EEEAFD" />
            <x:String x:Key="CodeWFMarkdownMermaidDataPalette">#8B7CF6,#D9AD53,#70A98B,#C583B5,#62A5C2,#D58585,#7E9ECB,#A9B568</x:String>
            <x:String x:Key="CodeWFMarkdownMermaidFillPalette">#7466E0,#D9AD53,#70A98B,#C583B5,#62A5C2,#D58585,#7E9ECB,#A9B568</x:String>
            <!-- 原型块内不另铺底色：正文纸面即块面（editor-bg 与 surface 同值），随配色一起走。 -->
            <SolidColorBrush x:Key="VexDocumentPaperBrush" Color="{DynamicResource StudioPaperColor}" />
            <!-- 原型画布底 = 纸面掺 5% 墨（color-mix fg 5% paper），把画布压暗一档与白块拉开。 -->
            <SolidColorBrush x:Key="VexCanvasInkTintBrush" Color="{DynamicResource StudioTextColor}" Opacity="0.05" />
            <!-- 弹层/对话框浮起底色：浅色主题统一纯白，不随配色纸面偏米黄。 -->
            <SolidColorBrush x:Key="VexElevatedBackgroundBrush" Color="#FFFFFF" />
            <!-- 原型令牌 on-accent：实底强调色上的文字，浅色纯白、深色纯黑。 -->
            <SolidColorBrush x:Key="VexOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="VexEditorBackgroundBrush" Color="{DynamicResource StudioPaperColor}" />
            <SolidColorBrush x:Key="VexPreviewBackgroundBrush" Color="{DynamicResource StudioPaperColor}" />
            <SolidColorBrush x:Key="VexTableHeaderBrush" Color="#F7F7F8" />
            <SolidColorBrush x:Key="VexTableStripeBrush" Color="#F7F7F8" />
            <SolidColorBrush x:Key="VexTableBorderBrush" Color="#DFE2E5" />
            <SolidColorBrush x:Key="VexDangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="VexDangerSoftBrush" Color="#FEECEB" />
            <SolidColorBrush x:Key="VexSuccessBrush" Color="#067647" />
            <SolidColorBrush x:Key="VexSuccessSoftBrush" Color="#1A067647" />
            <SolidColorBrush x:Key="VexWarningBrush" Color="#B54708" />
            <SolidColorBrush x:Key="VexWarningSoftBrush" Color="#FDEBD7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidBackground" Color="#202124" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidForeground" Color="#EDE8F5" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidAccent" Color="#B6A6FF" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidDefault" Color="#B6A6FF" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidLine" Color="#B5ADBF" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidBorder" Color="#8C7DA9" />
            <SolidColorBrush x:Key="CodeWFMarkdownMermaidSurface" Color="#38304E" />
            <x:String x:Key="CodeWFMarkdownMermaidDataPalette">#B6A6FF,#E8C778,#93CFAC,#DFA2D0,#8AC8E0,#E8AAA3,#A7BFE7,#C4CE8E</x:String>
            <x:String x:Key="CodeWFMarkdownMermaidFillPalette">#B6A6FF,#E8C778,#93CFAC,#DFA2D0,#8AC8E0,#E8AAA3,#A7BFE7,#C4CE8E</x:String>
            <SolidColorBrush x:Key="VexDocumentPaperBrush" Color="{DynamicResource StudioPaperColor}" />
            <!-- 原型深色画布要比块亮一档（bg = mix paper, panel 30%）；Studio 的 surface 反而更深，
                 所以取最浅的中性上浮色按 40% 叠在纸面上，随配色自适应地抬起画布。 -->
            <SolidColorBrush x:Key="VexCanvasInkTintBrush" Color="{DynamicResource StudioRaisedColor}" Opacity="0.4" />
            <SolidColorBrush x:Key="VexElevatedBackgroundBrush" Color="#1F2021" />
            <!-- 原型令牌 on-accent：深色主题的强调色本身是浅色，实底上的文字要转纯黑。 -->
            <SolidColorBrush x:Key="VexOnAccentBrush" Color="#000000" />
            <SolidColorBrush x:Key="VexEditorBackgroundBrush" Color="{DynamicResource StudioPaperColor}" />
            <SolidColorBrush x:Key="VexPreviewBackgroundBrush" Color="{DynamicResource StudioPaperColor}" />
            <SolidColorBrush x:Key="VexTableHeaderBrush" Color="#292C32" />
            <SolidColorBrush x:Key="VexTableStripeBrush" Color="#24272D" />
            <SolidColorBrush x:Key="VexTableBorderBrush" Color="#41454E" />
            <SolidColorBrush x:Key="VexDangerBrush" Color="#FF828F" />
            <SolidColorBrush x:Key="VexDangerSoftBrush" Color="#3D2328" />
            <SolidColorBrush x:Key="VexSuccessBrush" Color="#63DCB0" />
            <SolidColorBrush x:Key="VexSuccessSoftBrush" Color="#1A63DCB0" />
            <SolidColorBrush x:Key="VexWarningBrush" Color="#EFBA6B" />
            <SolidColorBrush x:Key="VexWarningSoftBrush" Color="#3D2F1E" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
