<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <!-- 迁入库沿用 CodeWF.Avalonia 的 12.1.6.x 版本线，与 Vex 应用版本分开管理。 -->
    <Version>12.2.0.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Avalonia mind map editor, Markdown viewer, import/export and light/dark accent themes in one package.</Description>
    <PackageTags>avalonia;mindmap;markdown;themes;codewf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="I18n/*.json" />
    <EmbeddedResource Include="I18n/*.json" />
    <AvaloniaResource Include="Assets/Cursors/*.png" />
  </ItemGroup>
</Project>
