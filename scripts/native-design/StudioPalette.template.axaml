<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 颜色令牌与画刷遵循 Semi 的主题字典结构。 -->
    <Color x:Key="StudioBackgroundColor">#FFFFFF</Color>
    <Color x:Key="StudioSurfaceColor">#F7F6FC</Color>
    <Color x:Key="StudioRaisedColor">#EFEDF7</Color>
    <Color x:Key="StudioBorderColor">#DDD8EC</Color>
    <Color x:Key="StudioTextColor">#242036</Color>
    <Color x:Key="StudioMutedColor">#6E6684</Color>
    <Color x:Key="StudioAccentColor">#6745D6</Color>
    <Color x:Key="StudioSecondaryColor">#1AAFA9</Color>
    <Color x:Key="StudioPrimaryColor">#512BD4</Color>
    <Color x:Key="StudioGradientStartColor">#8968FF</Color>
    <Color x:Key="StudioTextGradientEndColor">#007773</Color>
    <SolidColorBrush x:Key="StudioBackground" Color="{StaticResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="StudioSurface" Color="{StaticResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="StudioRaised" Color="{StaticResource StudioRaisedColor}" />
    <SolidColorBrush x:Key="StudioBorder" Color="{StaticResource StudioBorderColor}" />
    <SolidColorBrush x:Key="StudioText" Color="{StaticResource StudioTextColor}" />
    <SolidColorBrush x:Key="StudioMuted" Color="{StaticResource StudioMutedColor}" />
    <SolidColorBrush x:Key="StudioAccent" Color="{StaticResource StudioAccentColor}" />
    <SolidColorBrush x:Key="StudioSecondary" Color="{StaticResource StudioSecondaryColor}" />
    <SolidColorBrush x:Key="StudioPrimary" Color="{StaticResource StudioPrimaryColor}" />
    <LinearGradientBrush x:Key="StudioGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{StaticResource StudioGradientStartColor}" />
        <GradientStop Offset="1" Color="{StaticResource StudioSecondaryColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioTextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{StaticResource StudioAccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource StudioTextGradientEndColor}" />
    </LinearGradientBrush>
    <!-- 语义色保持状态含义；文字色与实色底分别定义，避免白字落在浅黄或浅绿上。 -->
    <SolidColorBrush x:Key="StudioOnPrimary">White</SolidColorBrush>
    <SolidColorBrush x:Key="StudioPrimaryHover">#4927BF</SolidColorBrush>
    <SolidColorBrush x:Key="StudioPrimaryPressed">#4122AA</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorSuccess">#147537</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorWarning">#925C00</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorDanger">#B42318</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorDangerActive">#912018</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorSuccessLight">#E4F5E8</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorWarningLight">#FDF3DC</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorDangerLight">#FDECEC</SolidColorBrush>
    <SolidColorBrush x:Key="SemiColorDangerLightActive">#F9DCDC</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBadgeLeftTextForeground">White</SolidColorBrush>
    <!-- 白字操作面使用独立渐变，装饰渐变保留明亮副色。 -->
    <LinearGradientBrush x:Key="StudioActionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{StaticResource StudioPrimaryColor}" />
        <GradientStop Offset="1" Color="#007773" />
    </LinearGradientBrush>
    <ResourceDictionary x:Key="StudioPropertyGridTheme">
        <StaticResource x:Key="PgBackground" ResourceKey="StudioSurface" />
        <StaticResource x:Key="PgToolbarBackground" ResourceKey="StudioSurface" />
        <StaticResource x:Key="PgGroupBackground" ResourceKey="StudioRaised" />
        <StaticResource x:Key="PgForeground" ResourceKey="StudioText" />
        <StaticResource x:Key="PgSecondaryForeground" ResourceKey="StudioMuted" />
        <StaticResource x:Key="PgBorder" ResourceKey="StudioBorder" />
        <StaticResource x:Key="PgLine" ResourceKey="StudioBorder" />
        <StaticResource x:Key="PgHover" ResourceKey="StudioRaised" />
        <StaticResource x:Key="PgAccent" ResourceKey="StudioAccent" />
        <StaticResource x:Key="PgSelected" ResourceKey="StudioPrimary" />
        <StaticResource x:Key="PgSelectedSoft" ResourceKey="StudioRaised" />
        <StaticResource x:Key="PgEditorBackground" ResourceKey="StudioSurface" />
        <SolidColorBrush x:Key="PgSelectedText">White</SolidColorBrush>
    </ResourceDictionary>
    <!-- 现有控件模板通过资源别名使用配色。 -->
    <StaticResource x:Key="CodeWFWindowBackground" ResourceKey="StudioBackground" />
