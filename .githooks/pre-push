#!/bin/sh
# 强制本地门禁，失败即阻止推送。逃生口：git push --no-verify（不建议——本地拦下来的问题，线上跑只会更慢）。
# 启用方式（克隆后执行一次）：git config core.hooksPath .githooks
#
# 三档分层：
#   分支推送（refs/heads/*）→ scripts/verify-branch.ps1：构建 + 三套 xunit（约 5 分钟）；
#     本次推送改动仅在 docs/、design/、*.md 时自动跳过（不影响编译与测试面）。
#   v* tag  → scripts/verify-release.ps1：全量发布门禁（构建 + 三套 xunit + 候选库重建 +
#             UiVerification 十二场景 + win-x64 AOT 发布 + 三大 AOT 验证器；真实 Inno 夹具仅本机
#             有 ISCC.exe 时执行），与 CI update-checks / release 同源。
#   lib-v* tag → scripts/verify-libraries.ps1：构建 + 三套 xunit + 四库打包冒烟。
#   同一次推送既带分支又带 tag 时，tag 全量门禁已含分支门禁内容，不重复跑。

zero="0000000000000000000000000000000000000000"
app_tag=""
lib_tag=""
branch_push=0
branch_skip_gate=1
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/tags/v*) app_tag="${remote_ref#refs/tags/}" ;;
    refs/tags/lib-v*) lib_tag="${remote_ref#refs/tags/}" ;;
    refs/heads/*)
      # 删除分支（local oid = zero）不触发门禁
      if [ "$local_oid" != "$zero" ]; then
        branch_push=1
        if [ "$remote_oid" = "$zero" ]; then
          # 新分支首推：无远端基线可比，走门禁
          branch_skip_gate=0
        elif git -c core.quotepath=off diff --name-only "$remote_oid" "$local_oid" \
            | grep -vEq '^(docs/|design/|[^/]*/[^/]*\.md$)'; then
          branch_skip_gate=0
        fi
      fi
      ;;
  esac
  # 删除 tag（local oid = zero）不触发门禁
  if [ "$local_oid" = "$zero" ] && [ -n "$app_tag" ] && [ "${remote_ref#refs/tags/}" = "$app_tag" ]; then app_tag=""; fi
  if [ "$local_oid" = "$zero" ] && [ -n "$lib_tag" ] && [ "${remote_ref#refs/tags/}" = "$lib_tag" ]; then lib_tag=""; fi
done

if [ -n "$app_tag" ]; then
  echo "==> 检测到应用发布 tag $app_tag：先跑本地发布门禁（约 15-30 分钟，Ctrl+C 放弃推送）"
  pwsh scripts/verify-release.ps1 || {
    echo "✗ 本地门禁未通过，推送已被阻止。修复后重试；确需跳过：git push --no-verify" >&2
    exit 1
  }
fi

if [ -n "$lib_tag" ]; then
  echo "==> 检测到库包 tag $lib_tag：先跑本地库包门禁"
  pwsh scripts/verify-libraries.ps1 || {
    echo "✗ 本地库包门禁未通过，推送已被阻止。修复后重试；确需跳过：git push --no-verify" >&2
    exit 1
  }
fi

if [ "$branch_push" = 1 ] && [ -z "$app_tag" ] && [ -z "$lib_tag" ]; then
  if [ "$branch_skip_gate" = 1 ]; then
    echo "==> 分支推送：改动仅在文档/设计，跳过构建门禁"
  else
    echo "==> 分支推送门禁：构建 + 三套 xunit（约 5 分钟，Ctrl+C 放弃推送）"
    pwsh scripts/verify-branch.ps1 || {
      echo "✗ 本地门禁未通过，推送已被阻止。修复后重试；确需跳过：git push --no-verify" >&2
      exit 1
    }
  fi
fi

exit 0
